%% ============================================================================
%%  RJTech Capstone — Full System UML Class Diagram  (Mermaid)
%%  ------------------  Paste into https://mermaid.live  ------------------
%%  Four layers in one diagram:
%%     1. VIEW MODELS   (ViewModels/*.cs)          — screen/request shapes
%%     2. CONTROLLERS   (Controllers/*.cs)         — MVC actions
%%     3. SERVICES      (Services/*.cs)            — business logic + infra
%%     4. MODELS        (Models/*.cs)              — EF entities (tables)
%%
%%  Conventions (3 sections per class):
%%     Name       : class header, <<sealed>> / <<record>> / <<interface>> / <<static>>
%%     Attributes : fields & properties   (- private, + public, $ static)
%%     Operations : constructor first, then methods (+ name(params) : return)
%%  Relationships:
%%     <|--  inheritance        ..|> implements
%%     *--   composition        o--  aggregation
%%     -->   dependency         +--  inner (nested) class
%%  Generics use tilde notation (List~int~) for mermaid.live safety.
%%  ApplicationDbContext (Data/) appears as a stub — its DbSets map to every
%%  entity in the MODELS layer.
%% ============================================================================

classDiagram
    direction TB

