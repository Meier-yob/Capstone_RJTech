@model Capstone_RJTech.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - RJTech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            :root {
                --brand: #0084ff;
                --brand-dark: #006fd9;
                --accent: #1fc27a;
                --brand-shade: rgba(20, 70, 140, .35);
                --ink: #1a1a1a;
                --muted: #a3a3a3;
                --line: #2b2b2b;
                --font: "Inter", "Segoe UI", Roboto, system-ui, -apple-system, Arial, sans-serif;
            }

            *, *::before, *::after {
                box-sizing: border-box;
            }

            html, body {
                height: 100%;
            }

            body {
                margin: 0;
                font-family: var(--font);
                color: var(--ink);
                background: #fff;
            }

            .login-page {
                display: grid;
                grid-template-columns: 1fr 1fr;
                min-height: 100vh;
            }

            /* ---------- Left: hero ---------- */
            .hero {
                position: relative;
                overflow: hidden;
                display: flex;
                align-items: center;
                background: var(--brand);
                color: #fff;
                padding: 4rem clamp(2rem, 5vw, 4.5rem);
            }

                .hero::before,
                .hero::after {
                    content: "";
                    position: absolute;
                    border-radius: 50%;
                    pointer-events: none;
                }
                /* top soft dark circle */
                .hero::before {
                    width: 90%;
                    aspect-ratio: 1 / .75;
                    top: -32%;
                    left: -12%;
                    background: var(--brand-shade);
                }
                /* bottom-right soft circle */
                .hero::after {
                    width: 95%;
                    aspect-ratio: 1 / .9;
                    bottom: -36%;
                    left: 42%;
                    background: rgba(0, 60, 140, .28);
                }

            .hero-content {
                position: relative;
                z-index: 1;
                max-width: 30rem;
            }

            .hero h2 {
                margin: 0 0 1.75rem;
                font-size: clamp(2rem, 3.2vw, 2.6rem);
                font-weight: 700;
                letter-spacing: .03em;
                line-height: 1.2;
            }

                .hero h2 .hl {
                    color: var(--accent);
                }

            .hero p {
                margin: 0;
                font-size: clamp(1rem, 1.6vw, 1.35rem);
                font-weight: 300;
                letter-spacing: .07em;
                line-height: 1.35;
                color: rgba(255, 255, 255, .9);
            }

            /* ---------- Right: form ---------- */
            .form-side {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 3rem 1.5rem;
                background: #fff;
            }

            .form-wrap {
                width: 100%;
                max-width: 22rem;
            }

            .back-link {
                display: inline-flex;
                align-items: center;
                gap: .35rem;
                margin-bottom: 2rem;
                font-size: .75rem;
                color: var(--brand);
                text-decoration: none;
                transition: color .15s ease, gap .15s ease;
            }

                .back-link svg {
                    width: .9rem;
                    height: .9rem;
                }

                .back-link:hover {
                    color: var(--brand-dark);
                    gap: .5rem;
                }

                .back-link:focus-visible {
                    outline: 2px solid var(--brand);
                    outline-offset: 3px;
                    border-radius: 3px;
                }

            .form-wrap h1 {
                margin: 0;
                font-size: 1.35rem;
                font-weight: 700;
                color: var(--ink);
            }

            .form-wrap .sub {
                margin: .4rem 0 1.4rem;
                font-size: .72rem;
                line-height: 1.45;
                color: var(--muted);
            }

            /* field with label inside top-left of the border */
            .field {
                margin-bottom: 1rem;
            }

            .field-box {
                position: relative;
                display: flex;
                align-items: flex-end;
                border: 1px solid var(--line);
                border-radius: .6rem;
                background: #fff;
                padding: .3rem .85rem .35rem;
                transition: border-color .15s ease, box-shadow .15s ease;
            }

                .field-box:hover {
                    border-color: #000;
                }

                .field-box:focus-within {
                    border-color: var(--brand);
                    box-shadow: 0 0 0 3px rgba(0, 132, 255, .18);
                }

                .field-box label {
                    position: absolute;
                    top: .35rem;
                    left: .85rem;
                    margin: 0;
                    font-size: .62rem;
                    font-weight: 500;
                    line-height: 1;
                    color: #333;
                    pointer-events: none;
                    transition: color .15s ease;
                }

                .field-box:focus-within label {
                    color: var(--brand);
                }

                .field-box input {
                    flex: 1;
                    min-width: 0;
                    width: 100%;
                    border: 0;
                    outline: 0;
                    background: transparent;
                    font: inherit;
                    font-size: .9rem;
                    color: var(--ink);
                    padding: .85rem 0 .1rem;
                }

                    .field-box input::placeholder {
                        color: #8a8a8a;
                        opacity: 1;
                    }

            .field-error {
                display: block;
                margin-top: .3rem;
                font-size: .75rem;
                color: #dc3545;
            }

            .btn-signin {
                display: block;
                width: 100%;
                padding: .8rem 1rem;
                border: 0;
                border-radius: .55rem;
                background: var(--brand);
                color: #fff;
                font: inherit;
                font-size: .85rem;
                font-weight: 500;
                cursor: pointer;
                transition: background-color .2s ease, transform .1s ease, box-shadow .2s ease;
            }

                .btn-signin:hover {
                    background: var(--brand-dark);
                    box-shadow: 0 6px 16px rgba(0, 132, 255, .28);
                }

                .btn-signin:active {
                    transform: translateY(1px);
                }

                .btn-signin:focus-visible {
                    outline: 3px solid rgba(0, 132, 255, .35);
                    outline-offset: 2px;
                }

                .btn-signin[disabled] {
                    opacity: .7;
                    cursor: default;
                    box-shadow: none;
                }

            .text-danger {
                color: #dc3545 !important;
                font-size: .78rem;
            }

            /* ---------- Responsive ---------- */
            @@media (max-width: 860px) {
                .login-page {
                    grid-template-columns: 1fr;
                    grid-template-rows: auto 1fr;
                }

                .hero {
                    padding: 2.5rem 1.75rem;
                }

                    .hero::before {
                        width: 130%;
                        top: -70%;
                        left: -20%;
                    }

                    .hero::after {
                        width: 110%;
                        bottom: -80%;
                        left: 30%;
                    }

                    .hero h2 {
                        margin-bottom: .75rem;
                    }

                .form-side {
                    align-items: flex-start;
                    padding-top: 2rem;
                }

                .back-link {
                    margin-bottom: 1.5rem;
                }
            }

            @@media (max-width: 480px) {
                .hero p {
                    letter-spacing: .04em;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                * {
                    transition: none !important;
                }
            }
    </style>
</head>
<body>
    <div class="login-page">

        <!-- Left: branding / hero -->
        <section class="hero" aria-label="RJTech">
            <div class="hero-content">
                <h2>Reset your <br /><span class="hl">password</span> securely</h2>
                <p>We'll help you regain access to your account. Enter your registered email address and we'll send you a verification code</p>
            </div>
        </section>

        <!-- Right: form -->
        <main class="form-side">
            <div class="form-wrap">
                <a class="back-link" asp-action="Login">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 18l-6-6 6-6" />
                    </svg>
                    Back
                </a>

                <h1>Forgot Password</h1>
                <p class="sub">Enter your registered email address. we'll send you a code to reset your password.</p>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <form asp-action="ForgotPassword" method="post" novalidate id="forgotForm">
                    @Html.AntiForgeryToken()

                    <div class="field">
                        <div class="field-box">
                            <label asp-for="Email">Registered Email</label>
                            <input asp-for="Email" autocomplete="email" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <button type="submit" class="btn-signin" id="sendCodeBtn">Send Code</button>
                </form>
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            // Prevent double-submits once the form passes validation
            (function() {
                var form = document.getElementById('forgotForm');
                var btn = document.getElementById('sendCodeBtn');
                if (!form || !btn || !window.jQuery) return;

                form.addEventListener('submit', function() {
                    if (window.jQuery(form).valid()) {
                        btn.disabled = true;
                        btn.textContent = 'Sending...';
                    }
                });
            })();
    </script>
</body>
</html>
