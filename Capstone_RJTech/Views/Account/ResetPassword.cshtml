@model Capstone_RJTech.ViewModels.ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - RJTech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            :root {
                --brand: #0084ff;
                --brand-dark: #006fd9;
                --accent: #1fc27a;
                --brand-shade: rgba(20, 70, 140, .35);
                --ink: #1a1a1a;
                --muted: #a3a3a3;
                --line: #2b2b2b;
                --font: "Inter", "Segoe UI", Roboto, system-ui, -apple-system, Arial, sans-serif;
            }

            *, *::before, *::after {
                box-sizing: border-box;
            }

            html, body {
                height: 100%;
            }

            body {
                margin: 0;
                font-family: var(--font);
                color: var(--ink);
                background: #fff;
            }

            .login-page {
                display: grid;
                grid-template-columns: 1fr 1fr;
                min-height: 100vh;
            }

            /* ---------- Left: hero ---------- */
            .hero {
                position: relative;
                overflow: hidden;
                display: flex;
                align-items: center;
                background: var(--brand);
                color: #fff;
                padding: 4rem clamp(2rem, 5vw, 4.5rem);
            }

                .hero::before,
                .hero::after {
                    content: "";
                    position: absolute;
                    border-radius: 50%;
                    pointer-events: none;
                }
                /* top soft dark circle */
                .hero::before {
                    width: 90%;
                    aspect-ratio: 1 / .75;
                    top: -32%;
                    left: -12%;
                    background: var(--brand-shade);
                }
                /* bottom-right soft circle */
                .hero::after {
                    width: 95%;
                    aspect-ratio: 1 / .9;
                    bottom: -36%;
                    left: 42%;
                    background: rgba(0, 60, 140, .28);
                }

            .hero-content {
                position: relative;
                z-index: 1;
                max-width: 30rem;
            }

            .hero h2 {
                margin: 0 0 1.75rem;
                font-size: clamp(2rem, 3.2vw, 2.6rem);
                font-weight: 700;
                letter-spacing: .03em;
                line-height: 1.2;
            }

                .hero h2 .hl {
                    color: var(--accent);
                }

            .hero p {
                margin: 0;
                font-size: clamp(1rem, 1.6vw, 1.35rem);
                font-weight: 300;
                letter-spacing: .07em;
                line-height: 1.35;
                color: rgba(255, 255, 255, .9);
            }

            /* ---------- Right: form ---------- */
            .form-side {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 3rem 1.5rem;
                background: #fff;
            }

            .form-wrap {
                width: 100%;
                max-width: 22.5rem;
            }

            .back-link {
                display: inline-flex;
                align-items: center;
                gap: .35rem;
                margin-bottom: 2rem;
                font-size: .75rem;
                color: var(--brand);
                text-decoration: none;
                transition: color .15s ease, gap .15s ease;
            }

                .back-link svg {
                    width: .9rem;
                    height: .9rem;
                }

                .back-link:hover {
                    color: var(--brand-dark);
                    gap: .5rem;
                }

                .back-link:focus-visible {
                    outline: 2px solid var(--brand);
                    outline-offset: 3px;
                    border-radius: 3px;
                }

            .form-wrap h1 {
                margin: 0;
                font-size: 1.4rem;
                font-weight: 700;
                color: var(--ink);
            }

            .form-wrap .sub {
                margin: .4rem 0 1.4rem;
                font-size: .75rem;
                line-height: 1.45;
                color: var(--muted);
            }

            /* alerts */
            .alert {
                position: relative;
                margin: 0 0 1rem;
                padding: .85rem 2rem .85rem 1rem;
                border: 0;
                border-radius: .3rem;
                font-size: .72rem;
                text-align: center;
            }

            .alert-info {
                background: #a9d4ff;
                color: #0a6fd6;
            }

            .alert .btn-close {
                position: absolute;
                top: .5rem;
                right: .55rem;
                padding: .35rem;
                font-size: .55rem;
                opacity: .45;
            }

                .alert .btn-close:hover {
                    opacity: .8;
                }

            /* field with label inside top-left of the border */
            .field {
                margin-bottom: 1rem;
            }

            .field-box {
                position: relative;
                display: flex;
                align-items: flex-end;
                border: 1px solid var(--line);
                border-radius: .6rem;
                background: #fff;
                padding: .3rem .85rem .35rem;
                transition: border-color .15s ease, box-shadow .15s ease;
            }

                .field-box:hover {
                    border-color: #000;
                }

                .field-box:focus-within {
                    border-color: var(--brand);
                    box-shadow: 0 0 0 3px rgba(0, 132, 255, .18);
                }

                .field-box label {
                    position: absolute;
                    top: .35rem;
                    left: .85rem;
                    margin: 0;
                    font-size: .62rem;
                    font-weight: 500;
                    line-height: 1;
                    color: #333;
                    pointer-events: none;
                    transition: color .15s ease;
                }

                .field-box:focus-within label {
                    color: var(--brand);
                }

                .field-box input {
                    flex: 1;
                    min-width: 0;
                    width: 100%;
                    border: 0;
                    outline: 0;
                    background: transparent;
                    font: inherit;
                    font-size: .9rem;
                    color: var(--ink);
                    padding: .85rem 0 .1rem;
                }

            .field-error {
                display: block;
                margin-top: .3rem;
                font-size: .75rem;
                color: #dc3545;
            }

            .toggle-pw {
                flex: none;
                display: grid;
                place-items: center;
                width: 2rem;
                height: 2rem;
                margin: 0 -.3rem 0 .25rem;
                padding: 0;
                border: 0;
                border-radius: .4rem;
                background: transparent;
                color: #222;
                cursor: pointer;
                transition: background-color .15s ease;
            }

                .toggle-pw:hover {
                    background: rgba(0, 0, 0, .06);
                }

                .toggle-pw:focus-visible {
                    outline: 2px solid var(--brand);
                    outline-offset: 1px;
                }

                .toggle-pw svg {
                    width: 1.25rem;
                    height: 1.25rem;
                }

                .toggle-pw .icon-off {
                    display: none;
                }

                .toggle-pw.is-visible .icon-on {
                    display: none;
                }

                .toggle-pw.is-visible .icon-off {
                    display: block;
                }

            .btn-signin {
                display: block;
                width: 100%;
                margin-top: 1.4rem;
                padding: .8rem 1rem;
                border: 0;
                border-radius: .55rem;
                background: var(--brand);
                color: #fff;
                font: inherit;
                font-size: .85rem;
                font-weight: 500;
                cursor: pointer;
                transition: background-color .2s ease, transform .1s ease, box-shadow .2s ease;
            }

                .btn-signin:hover {
                    background: var(--brand-dark);
                    box-shadow: 0 6px 16px rgba(0, 132, 255, .28);
                }

                .btn-signin:active {
                    transform: translateY(1px);
                }

                .btn-signin:focus-visible {
                    outline: 3px solid rgba(0, 132, 255, .35);
                    outline-offset: 2px;
                }

                .btn-signin[disabled] {
                    opacity: .7;
                    cursor: default;
                    box-shadow: none;
                }

            .text-danger {
                color: #dc3545 !important;
                font-size: .78rem;
            }

            /* ---------- Responsive ---------- */
            @@media (max-width: 860px) {
                .login-page {
                    grid-template-columns: 1fr;
                    grid-template-rows: auto 1fr;
                }

                .hero {
                    padding: 2.5rem 1.75rem;
                }

                    .hero::before {
                        width: 130%;
                        top: -70%;
                        left: -20%;
                    }

                    .hero::after {
                        width: 110%;
                        bottom: -80%;
                        left: 30%;
                    }

                    .hero h2 {
                        margin-bottom: .75rem;
                    }

                .form-side {
                    align-items: flex-start;
                    padding-top: 2rem;
                }

                .back-link {
                    margin-bottom: 1.5rem;
                }
            }

            @@media (max-width: 480px) {
                .hero p {
                    letter-spacing: .04em;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                * {
                    transition: none !important;
                }
            }
    </style>
</head>
<body>
    <div class="login-page">

        <!-- Left: branding / hero -->
        <section class="hero" aria-label="RJTech">
            <div class="hero-content">
                <h2>Create a new <br /><span class="hl">password</span> and get back in</h2>
                <p>Your code has been verified. Choose a strong password you haven't used before to keep your account secure.</p>
            </div>
        </section>

        <!-- Right: form -->
        <main class="form-side">
            <div class="form-wrap">
                <a class="back-link" asp-action="Login">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 18l-6-6 6-6" />
                    </svg>
                    Back
                </a>

                <h1>Create New Password</h1>
                <p class="sub">Your code has been verified. Enter a new password below.</p>

                @if (TempData["AccountMessage"] is string message)
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        @message
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <form asp-action="ResetPassword" method="post" novalidate id="resetForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RequestId" />

                    <div class="field">
                        <div class="field-box">
                            <label asp-for="Password">New Password</label>
                            <input asp-for="Password" autocomplete="new-password" autofocus />
                            <button type="button" class="toggle-pw" data-target="Password"
                                    aria-label="Show password" aria-pressed="false">
                                <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M17.94 17.94A10.9 10.9 0 0 1 12 19c-6.4 0-10-7-10-7a18.4 18.4 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.7 9.7 0 0 1 12 5c6.4 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19" />
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                    <path d="M1 1l22 22" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <div class="field">
                        <div class="field-box">
                            <label asp-for="ConfirmPassword">Confirm Password</label>
                            <input asp-for="ConfirmPassword" autocomplete="new-password" />
                            <button type="button" class="toggle-pw" data-target="ConfirmPassword"
                                    aria-label="Show password" aria-pressed="false">
                                <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M17.94 17.94A10.9 10.9 0 0 1 12 19c-6.4 0-10-7-10-7a18.4 18.4 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.7 9.7 0 0 1 12 5c6.4 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19" />
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                    <path d="M1 1l22 22" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>

                    <button type="submit" class="btn-signin" id="resetBtn">Reset Password</button>
                </form>
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            (function() {
                // Show / hide password toggles
                document.querySelectorAll('.toggle-pw').forEach(function(btn) {
                    var input = document.getElementById(btn.getAttribute('data-target'));
                    if (!input) return;
                    btn.addEventListener('click', function() {
                        var show = input.type === 'password';
                        input.type = show ? 'text' : 'password';
                        btn.classList.toggle('is-visible', show);
                        btn.setAttribute('aria-pressed', String(show));
                        btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                        input.focus();
                    });
                });

                // Prevent double-submits once the form passes validation
                var form = document.getElementById('resetForm');
                var submitBtn = document.getElementById('resetBtn');
                if (form && submitBtn && window.jQuery) {
                    form.addEventListener('submit', function() {
                        if (window.jQuery(form).valid()) {
                            submitBtn.disabled = true;
                            submitBtn.textContent = 'Resetting...';
                        }
                    });
                }
            })();
    </script>
</body>
</html>
