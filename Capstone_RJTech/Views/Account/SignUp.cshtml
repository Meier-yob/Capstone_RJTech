@model Capstone_RJTech.ViewModels.SignUpViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up - RJTech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            :root {
                --brand: #0084ff;
                --brand-dark: #006fd9;
                --brand-shade: rgba(20, 70, 140, .35);
                --ink: #1a1a1a;
                --muted: #a3a3a3;
                --line: #2b2b2b;
                --font: "Inter", "Segoe UI", Roboto, system-ui, -apple-system, Arial, sans-serif;
            }

            *, *::before, *::after {
                box-sizing: border-box;
            }

            html, body {
                height: 100%;
            }

            body {
                margin: 0;
                font-family: var(--font);
                color: var(--ink);
                background: #fff;
            }

            .login-page {
                display: grid;
                grid-template-columns: 1fr 1fr;
                min-height: 100vh;
            }

            /* ---------- Left: hero ---------- */
            .hero {
                position: relative;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                background: var(--brand);
                color: #fff;
                padding: 4rem clamp(2rem, 5vw, 4.5rem);
            }

                .hero::before,
                .hero::after {
                    content: "";
                    position: absolute;
                    border-radius: 50%;
                    pointer-events: none;
                }
                /* top soft dark circle */
                .hero::before {
                    width: 100%;
                    aspect-ratio: 1 / .5;
                    top: -28%;
                    left: -8%;
                    background: var(--brand-shade);
                }
                /* bottom soft circle */
                .hero::after {
                    width: 125%;
                    aspect-ratio: 1 / .6;
                    bottom: -36%;
                    left: -14%;
                    background: rgba(0, 60, 140, .22);
                }

            .hero-content {
                position: relative;
                z-index: 1;
                max-width: 26rem;
            }

            .hero h2 {
                margin: 0 0 1.75rem;
                font-size: clamp(2.4rem, 4.4vw, 3.6rem);
                font-weight: 700;
                letter-spacing: .07em;
                line-height: 1.1;
            }

            .hero p {
                margin: 0 0 .75rem;
                font-size: clamp(1rem, 1.5vw, 1.2rem);
                font-weight: 300;
                letter-spacing: .07em;
                color: rgba(255, 255, 255, .92);
            }

            .btn-outline-hero {
                display: inline-block;
                min-width: 6.5rem;
                padding: .55rem 1.5rem;
                border: 1.5px solid #fff;
                border-radius: .8rem;
                background: transparent;
                color: #fff;
                font-size: .95rem;
                font-weight: 400;
                letter-spacing: .04em;
                text-decoration: none;
                transition: background-color .2s ease, color .2s ease, transform .1s ease;
            }

                .btn-outline-hero:hover {
                    background: #fff;
                    color: var(--brand);
                }

                .btn-outline-hero:active {
                    transform: translateY(1px);
                }

                .btn-outline-hero:focus-visible {
                    outline: 3px solid rgba(255, 255, 255, .5);
                    outline-offset: 3px;
                }

            /* ---------- Right: form ---------- */
            .form-side {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 3rem 1.5rem;
                background: #fff;
            }

            .form-wrap {
                width: 100%;
                max-width: 22rem;
            }

                .form-wrap h1 {
                    margin: 0;
                    font-size: 1.45rem;
                    font-weight: 700;
                    color: var(--ink);
                }

                .form-wrap .sub {
                    margin: .15rem 0 1.25rem;
                    font-size: .75rem;
                    color: var(--muted);
                }

            /* field with label inside top-left of the border */
            .field {
                margin-bottom: .85rem;
            }

            .field-box {
                position: relative;
                display: flex;
                align-items: flex-end;
                border: 1px solid var(--line);
                border-radius: .6rem;
                background: #fff;
                padding: .3rem .85rem .35rem;
                transition: border-color .15s ease, box-shadow .15s ease;
            }

                .field-box:hover {
                    border-color: #000;
                }

                .field-box:focus-within {
                    border-color: var(--brand);
                    box-shadow: 0 0 0 3px rgba(0, 132, 255, .18);
                }

                .field-box label {
                    position: absolute;
                    top: .35rem;
                    left: .85rem;
                    margin: 0;
                    font-size: .62rem;
                    font-weight: 500;
                    line-height: 1;
                    color: #333;
                    pointer-events: none;
                    transition: color .15s ease;
                }

                .field-box:focus-within label {
                    color: var(--brand);
                }

                .field-box input {
                    flex: 1;
                    min-width: 0;
                    width: 100%;
                    border: 0;
                    outline: 0;
                    background: transparent;
                    font: inherit;
                    font-size: .9rem;
                    color: var(--ink);
                    padding: .85rem 0 .1rem;
                }

                    .field-box input::placeholder {
                        color: #8a8a8a;
                        opacity: 1;
                    }

            .field-error {
                display: block;
                margin-top: .3rem;
                font-size: .75rem;
                color: #dc3545;
            }

            .toggle-pw {
                flex: none;
                display: grid;
                place-items: center;
                width: 2rem;
                height: 2rem;
                margin: 0 -.3rem 0 .25rem;
                padding: 0;
                border: 0;
                border-radius: .4rem;
                background: transparent;
                color: #222;
                cursor: pointer;
                transition: background-color .15s ease;
            }

                .toggle-pw:hover {
                    background: rgba(0, 0, 0, .06);
                }

                .toggle-pw:focus-visible {
                    outline: 2px solid var(--brand);
                    outline-offset: 1px;
                }

                .toggle-pw svg {
                    width: 1.25rem;
                    height: 1.25rem;
                }

                .toggle-pw .icon-off {
                    display: none;
                }

                .toggle-pw.is-visible .icon-on {
                    display: none;
                }

                .toggle-pw.is-visible .icon-off {
                    display: block;
                }

            .btn-signin {
                display: block;
                width: 100%;
                margin-top: 1.5rem;
                padding: .8rem 1rem;
                border: 0;
                border-radius: .55rem;
                background: var(--brand);
                color: #fff;
                font: inherit;
                font-size: .85rem;
                font-weight: 500;
                cursor: pointer;
                transition: background-color .2s ease, transform .1s ease, box-shadow .2s ease;
            }

                .btn-signin:hover {
                    background: var(--brand-dark);
                    box-shadow: 0 6px 16px rgba(0, 132, 255, .28);
                }

                .btn-signin:active {
                    transform: translateY(1px);
                }

                .btn-signin:focus-visible {
                    outline: 3px solid rgba(0, 132, 255, .35);
                    outline-offset: 2px;
                }

                .btn-signin[disabled] {
                    opacity: .7;
                    cursor: default;
                    box-shadow: none;
                }

            .footer-links {
                margin-top: .9rem;
                text-align: center;
                font-size: .72rem;
            }

                .footer-links a {
                    display: block;
                    padding: .1rem 0;
                    color: var(--brand);
                    text-decoration: underline;
                    text-underline-offset: 2px;
                }

                    .footer-links a:hover {
                        color: var(--brand-dark);
                    }

            .text-danger {
                color: #dc3545 !important;
                font-size: .78rem;
            }

            /* ---------- Responsive ---------- */
            @@media (max-width: 860px) {
                .login-page {
                    grid-template-columns: 1fr;
                    grid-template-rows: auto 1fr;
                }

                .hero {
                    padding: 2.5rem 1.75rem;
                }

                    .hero::before {
                        width: 140%;
                        top: -60%;
                        left: -20%;
                    }

                    .hero::after {
                        width: 140%;
                        bottom: -70%;
                        left: -20%;
                    }

                    .hero h2 {
                        margin-bottom: .75rem;
                    }

                .form-side {
                    align-items: flex-start;
                    padding-top: 2rem;
                }
            }

            @@media (max-width: 480px) {
                .hero p {
                    letter-spacing: .04em;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                * {
                    transition: none !important;
                }
            }
    </style>
</head>
<body>
    <div class="login-page">

        <!-- Left: branding / hero -->
        <section class="hero" aria-label="RJTech">
            <div class="hero-content">
                <h2>Get Started</h2>
                <p>Already have an account?</p>
                <a class="btn-outline-hero" asp-action="Login">Sign In</a>
            </div>
        </section>

        <!-- Right: form -->
        <main class="form-side">
            <div class="form-wrap">
                <h1>Register</h1>
                <p class="sub">Create a new account</p>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <form asp-action="SignUp" method="post" novalidate id="signupForm">
                    @Html.AntiForgeryToken()

                    <div class="field">
                        <div class="field-box">
                            <label asp-for="FullName">Fullname</label>
                            <input asp-for="FullName" autocomplete="name" autofocus />
                        </div>
                        <span asp-validation-for="FullName" class="field-error"></span>
                    </div>

                    <div class="field">
                        <div class="field-box">
                            <label asp-for="Email">Email Address</label>
                            <input asp-for="Email" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="field">
                        <div class="field-box">
                            <label asp-for="Username">Username</label>
                            <input asp-for="Username" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Username" class="field-error"></span>
                    </div>

                    <div class="field">
                        <div class="field-box">
                            <label asp-for="Password">Password</label>
                            <input asp-for="Password" autocomplete="new-password" />
                            <button type="button" class="toggle-pw" data-target="Password"
                                    aria-label="Show password" aria-pressed="false">
                                <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M17.94 17.94A10.9 10.9 0 0 1 12 19c-6.4 0-10-7-10-7a18.4 18.4 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.7 9.7 0 0 1 12 5c6.4 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19" />
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                    <path d="M1 1l22 22" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <div class="field">
                        <div class="field-box">
                            <label asp-for="ConfirmPassword">Confirm Password</label>
                            <input asp-for="ConfirmPassword" autocomplete="new-password" />
                            <button type="button" class="toggle-pw" data-target="ConfirmPassword"
                                    aria-label="Show password" aria-pressed="false">
                                <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M17.94 17.94A10.9 10.9 0 0 1 12 19c-6.4 0-10-7-10-7a18.4 18.4 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.7 9.7 0 0 1 12 5c6.4 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19" />
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                    <path d="M1 1l22 22" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>

                    <button type="submit" class="btn-signin" id="signupBtn">Create Account</button>
                </form>

               
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            (function() {
                // Show / hide password toggles
                document.querySelectorAll('.toggle-pw').forEach(function(btn) {
                    var input = document.getElementById(btn.getAttribute('data-target'));
                    if (!input) return;
                    btn.addEventListener('click', function() {
                        var show = input.type === 'password';
                        input.type = show ? 'text' : 'password';
                        btn.classList.toggle('is-visible', show);
                        btn.setAttribute('aria-pressed', String(show));
                        btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                        input.focus();
                    });
                });

                // Prevent double-submits once the form passes validation
                var form = document.getElementById('signupForm');
                var submitBtn = document.getElementById('signupBtn');
                if (form && submitBtn && window.jQuery) {
                    form.addEventListener('submit', function() {
                        if (window.jQuery(form).valid()) {
                            submitBtn.disabled = true;
                            submitBtn.textContent = 'Creating account...';
                        }
                    });
                }
            })();
    </script>
</body>
</html>
