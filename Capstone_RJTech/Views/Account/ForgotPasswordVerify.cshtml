@model Capstone_RJTech.ViewModels.VerifyOtpViewModel
@{
    Layout = null;
    var resetEmail = ViewData["ResetEmail"] as string ?? string.Empty;

    // Mask the address (wow123@gmail.com -> wow***@gmail.com) unless it's already masked
    var displayEmail = resetEmail;
    var at = resetEmail.IndexOf('@');
    if (at > 0 && !resetEmail.Contains('*'))
    {
        var local = resetEmail.Substring(0, at);
        var keep = Math.Min(3, Math.Max(1, local.Length - 1));
        displayEmail = local.Substring(0, keep) + "***" + resetEmail.Substring(at);
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Code - RJTech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            :root {
                --brand: #0084ff;
                --brand-dark: #006fd9;
                --brand-shade: rgba(20, 70, 140, .35);
                --ink: #1a1a1a;
                --muted: #a3a3a3;
                --line: #2b2b2b;
                --font: "Inter", "Segoe UI", Roboto, system-ui, -apple-system, Arial, sans-serif;
            }

            *, *::before, *::after {
                box-sizing: border-box;
            }

            html, body {
                height: 100%;
            }

            body {
                margin: 0;
                font-family: var(--font);
                color: var(--ink);
                background: #fff;
            }

            .login-page {
                display: grid;
                grid-template-columns: 1fr 1fr;
                min-height: 100vh;
            }

            /* ---------- Left: hero ---------- */
            .hero {
                position: relative;
                overflow: hidden;
                display: flex;
                align-items: center;
                background: var(--brand);
                color: #fff;
                padding: 4rem clamp(2rem, 5vw, 4.5rem);
            }

                .hero::before,
                .hero::after {
                    content: "";
                    position: absolute;
                    border-radius: 50%;
                    pointer-events: none;
                }
                /* top soft dark circle */
                .hero::before {
                    width: 115%;
                    aspect-ratio: 1 / .5;
                    top: -25%;
                    left: -8%;
                    background: var(--brand-shade);
                }
                /* bottom soft circle */
                .hero::after {
                    width: 130%;
                    aspect-ratio: 1 / .55;
                    bottom: -38%;
                    left: -15%;
                    background: rgba(0, 60, 140, .2);
                }

            .hero-content {
                position: relative;
                z-index: 1;
                max-width: 30rem;
            }

            .hero h2 {
                margin: 0 0 1.75rem;
                font-size: clamp(2rem, 3.2vw, 2.6rem);
                font-weight: 700;
                letter-spacing: .04em;
                line-height: 1.2;
            }

            .hero p {
                margin: 0;
                font-size: clamp(1rem, 1.6vw, 1.35rem);
                font-weight: 300;
                letter-spacing: .07em;
                line-height: 1.35;
                color: rgba(255, 255, 255, .9);
            }

            /* ---------- Right: form ---------- */
            .form-side {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 3rem 1.5rem;
                background: #fff;
            }

            .form-wrap {
                width: 100%;
                max-width: 22.5rem;
            }

            .back-link {
                display: inline-flex;
                align-items: center;
                gap: .35rem;
                margin-bottom: 2rem;
                font-size: .75rem;
                color: var(--brand);
                text-decoration: none;
                transition: color .15s ease, gap .15s ease;
            }

                .back-link svg {
                    width: .9rem;
                    height: .9rem;
                }

                .back-link:hover {
                    color: var(--brand-dark);
                    gap: .5rem;
                }

                .back-link:focus-visible {
                    outline: 2px solid var(--brand);
                    outline-offset: 3px;
                    border-radius: 3px;
                }

            .form-wrap h1 {
                margin: 0;
                font-size: 1.45rem;
                font-weight: 700;
                color: var(--ink);
            }

            .form-wrap .sub {
                margin: .3rem 0 1rem;
                font-size: .75rem;
                line-height: 1.45;
                color: #555;
            }

                .form-wrap .sub strong {
                    font-weight: 500;
                    color: var(--ink);
                }

            /* alerts (soft blue notice like the mockup) */
            .alert {
                position: relative;
                margin: 0 0 1rem;
                padding: .85rem 2rem .85rem 1rem;
                border: 0;
                border-radius: .3rem;
                font-size: .72rem;
                text-align: center;
            }

            .alert-info {
                background: #a9d4ff;
                color: #0a6fd6;
            }

            .alert-danger {
                background: #fde2e4;
                color: #b42318;
            }

            .alert .btn-close {
                position: absolute;
                top: .5rem;
                right: .55rem;
                padding: .35rem;
                font-size: .55rem;
                opacity: .45;
            }

                .alert .btn-close:hover {
                    opacity: .8;
                }

            /* field with label inside top-left of the border */
            .field {
                margin-bottom: 1rem;
            }

            .field-box {
                position: relative;
                display: flex;
                align-items: flex-end;
                border: 1px solid var(--line);
                border-radius: .6rem;
                background: #fff;
                padding: .3rem .85rem .35rem;
                transition: border-color .15s ease, box-shadow .15s ease;
            }

                .field-box:hover {
                    border-color: #000;
                }

                .field-box:focus-within {
                    border-color: var(--brand);
                    box-shadow: 0 0 0 3px rgba(0, 132, 255, .18);
                }

                .field-box label {
                    position: absolute;
                    top: .35rem;
                    left: .85rem;
                    margin: 0;
                    font-size: .62rem;
                    font-weight: 500;
                    line-height: 1;
                    color: #333;
                    pointer-events: none;
                    transition: color .15s ease;
                }

                .field-box:focus-within label {
                    color: var(--brand);
                }

                .field-box input {
                    flex: 1;
                    min-width: 0;
                    width: 100%;
                    border: 0;
                    outline: 0;
                    background: transparent;
                    font: inherit;
                    font-size: .9rem;
                    color: var(--ink);
                    padding: .85rem 0 .1rem;
                }

                    .field-box input::placeholder {
                        color: #8a8a8a;
                        opacity: 1;
                    }

                    .field-box input.otp {
                        letter-spacing: .25em;
                        font-variant-numeric: tabular-nums;
                    }

                        .field-box input.otp::placeholder {
                            letter-spacing: .25em;
                        }

            .field-error {
                display: block;
                margin-top: .3rem;
                font-size: .75rem;
                color: #dc3545;
            }

            .btn-signin {
                display: block;
                width: 100%;
                padding: .8rem 1rem;
                border: 0;
                border-radius: .55rem;
                background: var(--brand);
                color: #fff;
                font: inherit;
                font-size: .85rem;
                font-weight: 500;
                cursor: pointer;
                transition: background-color .2s ease, transform .1s ease, box-shadow .2s ease;
            }

                .btn-signin:hover {
                    background: var(--brand-dark);
                    box-shadow: 0 6px 16px rgba(0, 132, 255, .28);
                }

                .btn-signin:active {
                    transform: translateY(1px);
                }

                .btn-signin:focus-visible {
                    outline: 3px solid rgba(0, 132, 255, .35);
                    outline-offset: 2px;
                }

                .btn-signin[disabled] {
                    opacity: .7;
                    cursor: default;
                    box-shadow: none;
                }

            .footer-links {
                margin-top: 1.75rem;
                text-align: center;
                font-size: .72rem;
            }

                .footer-links a {
                    display: block;
                    padding: .1rem 0;
                    color: var(--brand);
                    text-decoration: underline;
                    text-underline-offset: 2px;
                }

                    .footer-links a:hover {
                        color: var(--brand-dark);
                    }

            .text-danger {
                color: #dc3545 !important;
                font-size: .78rem;
            }

            /* ---------- Responsive ---------- */
            @@media (max-width: 860px) {
                .login-page {
                    grid-template-columns: 1fr;
                    grid-template-rows: auto 1fr;
                }

                .hero {
                    padding: 2.5rem 1.75rem;
                }

                    .hero::before {
                        width: 140%;
                        top: -60%;
                        left: -20%;
                    }

                    .hero::after {
                        width: 140%;
                        bottom: -70%;
                        left: -20%;
                    }

                    .hero h2 {
                        margin-bottom: .75rem;
                    }

                .form-side {
                    align-items: flex-start;
                    padding-top: 2rem;
                }

                .back-link {
                    margin-bottom: 1.5rem;
                }
            }

            @@media (max-width: 480px) {
                .hero p {
                    letter-spacing: .04em;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                * {
                    transition: none !important;
                }
            }
    </style>
</head>
<body>
    <div class="login-page">

        <!-- Left: branding / hero -->
        <section class="hero" aria-label="RJTech">
            <div class="hero-content">
                <h2>Secure verification</h2>
                <p>We've sent a 6-digit code to your email address. Please enter it below to continue</p>
            </div>
        </section>

        <!-- Right: form -->
        <main class="form-side">
            <div class="form-wrap">
                <a class="back-link" asp-action="ForgotPassword">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 18l-6-6 6-6" />
                    </svg>
                    Back
                </a>

                <h1>Verify Code</h1>
                <p class="sub">Enter the 6-digit code sent to <strong>@displayEmail</strong></p>

                @if (TempData["AccountMessage"] is string message)
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        @message
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ToastError"] is string toastError)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @toastError
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <form asp-action="ForgotPasswordVerify" method="post" novalidate id="verifyForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RequestId" />

                    <div class="field">
                        <div class="field-box">
                            <label asp-for="Otp">Verification Code</label>
                            <input asp-for="Otp" class="otp" placeholder="000000" autofocus
                                   maxlength="6" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" />
                        </div>
                        <span asp-validation-for="Otp" class="field-error"></span>
                    </div>

                    <button type="submit" class="btn-signin" id="verifyBtn">Verify</button>
                </form>

                <div class="footer-links">
                    <a asp-action="ForgotPassword">Resend a new code</a>
                    <a asp-action="Login">Back to sign in</a>
                </div>
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            (function() {
                var otp = document.getElementById('Otp');
                var form = document.getElementById('verifyForm');
                var btn = document.getElementById('verifyBtn');

                // Digits only, max 6 (also handles pasted codes with spaces/dashes)
                if (otp) {
                    otp.addEventListener('input', function() {
                        var clean = otp.value.replace(/\D/g, '').slice(0, 6);
                        if (otp.value !== clean) otp.value = clean;
                    });
                }

                // Prevent double-submits once the form passes validation
                if (form && btn && window.jQuery) {
                    form.addEventListener('submit', function() {
                        if (window.jQuery(form).valid()) {
                            btn.disabled = true;
                            btn.textContent = 'Verifying...';
                        }
                    });
                }
            })();
    </script>
</body>
</html>
