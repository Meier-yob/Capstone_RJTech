@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied - RJTech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        .auth-card { max-width: 460px; margin: 0 auto; }
    </style>
</head>
<body class="bg-light">
    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm auth-card">
                    <div class="card-body p-4 text-center">
                        <h1 class="h4 text-danger mb-3">Access Denied</h1>
                        <p class="mb-4">You do not have permission to view that resource.</p>
                        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Return to Sign In</a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>