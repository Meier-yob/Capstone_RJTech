@model Capstone_RJTech.ViewModels.AcceptInvitationViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Accept RJTech Invitation</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h1 class="h3 mb-3">Accept RJTech invitation</h1>
                        <p>Create the Owner account for <strong>@Model.Email</strong>.</p>
                        <form asp-action="CreateOwnerAccount" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Token" />
                            <button type="submit" class="btn btn-primary">Continue</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
