@model Capstone_RJTech.ViewModels.CreateOwnerAccountViewModel
@{
    Layout = null;
    var email = ViewData["InvitationEmail"] as string ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Owner Account</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h1 class="h3 mb-3">Create Owner account</h1>
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <p class="text-muted">Email: <strong>@email</strong></p>
                        <form asp-action="CreateOwnerAccount" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Token" />
                            <div class="mb-3">
                                <label asp-for="FullName" class="form-label">Full name</label>
                                <input asp-for="FullName" class="form-control" autocomplete="name" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="UserName" class="form-label">Username</label>
                                <input asp-for="UserName" class="form-control" autocomplete="username" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">Password</label>
                                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Create Owner account</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
