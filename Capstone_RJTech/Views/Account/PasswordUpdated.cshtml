@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Updated - RJTech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #238eed;
            --brand: #0084ff;
            --brand-dark: #006fd9;
            --ink: #1a1a1a;
            --muted: #a3a3a3;
            --font: "Inter", "Segoe UI", Roboto, system-ui, -apple-system, Arial, sans-serif;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html, body { height: 100%; }

        body {
            position: relative;
            margin: 0;
            overflow: hidden;
            font-family: var(--font);
            color: var(--ink);
            background: var(--bg);
        }

        /* soft circle accents (top-left muted, bottom bright) */
        body::before,
        body::after {
            content: "";
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
        }
        body::before {
            width: 48vw;
            height: 21vw;
            min-width: 22rem;
            min-height: 10rem;
            top: -9vw;
            left: -6vw;
            background: rgba(90, 130, 170, .55);
        }
        body::after {
            width: 62vw;
            height: 36vw;
            min-width: 26rem;
            min-height: 16rem;
            bottom: -24vw;
            left: 34vw;
            background: var(--brand);
        }

        /* ---------- Centered success card ---------- */
        .success-page {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 2rem 1.25rem;
        }

        .success-card {
            width: 100%;
            max-width: 18.5rem;
            padding: 3.25rem 1.25rem 3rem;
            border-radius: 1.75rem;
            background: #fff;
            box-shadow: 0 24px 60px -12px rgba(0, 40, 90, .35);
            text-align: center;
        }

        .success-card h1 {
            margin: 0;
            padding: 0 1rem;
            font-size: 1.25rem;
            font-weight: 700;
            line-height: 1.3;
            color: var(--ink);
        }

        .success-card .sub {
            margin: .55rem 0 0;
            font-size: .65rem;
            line-height: 1.5;
            color: var(--muted);
        }

        .btn-signin {
            display: block;
            width: 100%;
            margin-top: 2.1rem;
            padding: .75rem 1rem;
            border: 0;
            border-radius: .5rem;
            background: var(--brand);
            color: #fff;
            font: inherit;
            font-size: .75rem;
            font-weight: 500;
            text-decoration: none;
            cursor: pointer;
            transition: background-color .2s ease, transform .1s ease, box-shadow .2s ease;
        }
        .btn-signin:hover {
            background: var(--brand-dark);
            box-shadow: 0 6px 16px rgba(0, 132, 255, .3);
            color: #fff;
        }
        .btn-signin:active { transform: translateY(1px); }
        .btn-signin:focus-visible { outline: 3px solid rgba(0, 132, 255, .4); outline-offset: 2px; }

        /* ---------- Entrance (skipped for reduced motion) ---------- */
        @@media (prefers-reduced-motion: no-preference) {
            .success-card { animation: rise .3s ease-out; }
        }
        @@keyframes rise {
            from { opacity: 0; transform: translateY(8px) scale(.98); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }
    </style>
</head>
<body>
    <main class="success-page">
        <div class="success-card" role="status" aria-live="polite">
            <h1>Password Update Successfully</h1>
            <p class="sub">Your password has been updated successfully.</p>
            <a class="btn-signin" asp-action="Login">Back to Login</a>
        </div>
    </main>
</body>
</html>
