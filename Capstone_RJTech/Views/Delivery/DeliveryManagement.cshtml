@model IEnumerable<Capstone_RJTech.Models.Delivery>

@{
    ViewData["Title"] = "Deliveries";
}

<div class="app-page" id="deliveryManagementPage"
     data-deactivate-url="@Url.Action("DeactivateDeliveryReceipt")"
     data-bulk-deactivate-url="@Url.Action("DeactivateDeliveryReceipts")"
     data-reactivate-url="@Url.Action("ReactivateDeliveryReceipt")">
    @Html.AntiForgeryToken()

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item active">Deliveries</li>
        </ol>
    </nav>

    <div class="page-heading">
        <div>
            <h1>Deliveries</h1>
            <p>Track and manage incoming inventory deliveries.</p>
        </div>
        <a asp-action="Receive" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Receive products
        </a>
    </div>

    <div class="filter-tabs compact-filter-tabs delivery-status-tabs"
         role="group"
         aria-label="Delivery status filters">
        <button class="btn active" type="button" data-status="active" aria-pressed="true">
            Active
        </button>
        <button class="btn" type="button" data-status="deactivated" aria-pressed="false">
            Deactivated
        </button>
    </div>

    <div class="toolbar del-toolbar">
        <div class="input-group search-control">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input id="deliverySearch" class="form-control" type="search" placeholder="Search delivery ID, batch, or receiver..." />
        </div>
        <button id="exportDeliveries" class="btn btn-success text-nowrap" type="button"
                data-export-url="@Url.Action("Delivery", "ExcelExport")">
            <i class="bi bi-file-earmark-excel me-1" aria-hidden="true"></i>Export Excel
        </button>
    </div>

    <div class="app-card management-card">
        <div class="table-responsive management-table-responsive">
            <table class="table app-table" id="deliveryTable">
                <thead>
                    <tr>
                        <th>Delivery code</th>
                        <th>Batch ID</th>
                        <th>Received by</th>
                        <th>Date received</th>
                        <th class="text-end">Products</th>
                        <th class="text-end">Total units</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var delivery in Model)
                    {
                        string code = delivery.FormattedDeliveryID;
                        string batchCode = delivery.FormattedBatchID;
                        int units = delivery.DeliveryDetails.Sum(detail => detail.product_quantity);

                        <tr class="delivery-row clickable-row@(delivery.is_deactivated ? " deactivated-row" : string.Empty)"
                            data-record-id="@delivery.delivery_ID"
                            data-href="@Url.Action("Details", new { id = delivery.delivery_ID })"
                            data-deactivated="@(delivery.is_deactivated ? "true" : "false")"
                            data-search="@($"{code} {batchCode} {delivery.received_by}{(delivery.is_deactivated ? " deactivated" : string.Empty)}".ToLowerInvariant())">
                            <td class="fw-bold">@code</td>
                            <td class="fw-bold">@batchCode</td>
                            <td class="fw-semibold">@delivery.received_by</td>
                            <td class="fw-semibold">@delivery.date_delivered.ToString("MMM d, yyyy")</td>
                            <td class="text-end fw-semibold">@delivery.DeliveryDetails.Count</td>
                            <td class="text-end fw-semibold">@units</td>
                            <td>
                                @if (delivery.is_deactivated)
                                {
                                    <span class="status-badge status-deactivated">Deactivated</span>
                                }
                                else
                                {
                                    <span class="status-badge status-completed">Completed</span>
                                }
                            </td>
                            <td class="text-end action-cell">
                                <div class="dropdown table-action-dropdown">
                                    <button class="btn btn-sm btn-light no-caret dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-label="Actions for @code">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" asp-action="Details" asp-route-id="@delivery.delivery_ID">
                                                <i class="bi bi-eye me-2"></i>View details
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            @if (delivery.is_deactivated)
                                            {
                                                <button class="dropdown-item js-reactivate" type="button"
                                                        data-id="@delivery.delivery_ID"
                                                        data-code="@code"
                                                        data-confirm-url="@Url.Action("ReactivateDeliveryReceipt")"
                                                        data-confirm-field="delivery_ID"
                                                        data-confirm-title="Reactivate delivery?"
                                                        data-confirm-message="Reactivate @code? It will be moved back to the active deliveries list."
                                                        data-confirm-label="Reactivate"
                                                        data-confirm-variant="success">
                                                    <i class="bi bi-arrow-clockwise me-2"></i>Reactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="dropdown-item js-deactivate" type="button"
                                                        data-id="@delivery.delivery_ID"
                                                        data-code="@code"
                                                        data-confirm-url="@Url.Action("DeactivateDeliveryReceipt")"
                                                        data-confirm-field="delivery_ID"
                                                        data-confirm-title="Deactivate delivery?"
                                                        data-confirm-message="Deactivate @code? It will be moved to the Deactivated tab. Received product quantities will not be changed."
                                                        data-confirm-label="Deactivate"
                                                        data-confirm-variant="warning">
                                                    <i class="bi bi-slash-circle me-2"></i>Deactivate
                                                </button>
                                            }
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr id="deliveryEmpty" class="d-none">
                        <td colspan="8">
                            <div class="empty-state">
                                <i class="bi bi-truck"></i>No deliveries found.
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="list-footer">
            <div class="range-indicator">
                <div id="deliveryRangeText" class="small text-muted">Showing 0 items</div>
                <div class="pagination-range-track">
                    <span id="deliveryRangeBar"></span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <label for="deliveryPageSize" class="small text-muted text-nowrap">Items per page</label>
                <select id="deliveryPageSize" class="form-select form-select-sm page-size-select">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                </select>
            </div>

            <nav aria-label="Delivery pages">
                <ul id="deliveryPagination" class="pagination pagination-sm mb-0"></ul>
            </nav>
        </div>
    </div>

    <partial name="_DeactivateConfirmModal" />
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/delivery-management.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/excel-export.js" asp-append-version="true"></script>
    <script src="~/js/delivery-management.js" asp-append-version="true"></script>
    <script src="~/js/deactivate-confirm.js" asp-append-version="true"></script>
}