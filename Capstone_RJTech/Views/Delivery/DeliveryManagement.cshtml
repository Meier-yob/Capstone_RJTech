@model IEnumerable<Capstone_RJTech.Models.Delivery>

@{
    ViewData["Title"] = "Deliveries";
    ViewData["Description"] = "Track and manage incoming inventory deliveries.";

    var activeDeliveries = Model.Where(delivery => !delivery.is_archived).ToList();
    var archivedDeliveries = Model.Where(delivery => delivery.is_archived).ToList();
}

<div class="app-page"
     id="deliveryManagementPage"
     data-archive-url="@Url.Action("ArchiveDeliveryReceipt")"
     data-delete-url="@Url.Action("DeleteDeliveryReceipt")">

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Dashboard">Dashboard</a>
            </li>
            <li class="breadcrumb-item active">Deliveries</li>
        </ol>
    </nav>

    <div class="page-heading">
        <div>
            <h1>Deliveries</h1>
            <p>Track and manage incoming inventory deliveries.</p>
        </div>

        <a asp-action="Receive" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Receive Products
        </a>
    </div>

    <div class="filter-tabs delivery-tabs" role="tablist" aria-label="Delivery lists">
        <button class="btn active"
                type="button"
                role="tab"
                aria-selected="true"
                data-delivery-tab="active">
            All
            <span class="ms-1 text-muted">@activeDeliveries.Count</span>
        </button>

        <button class="btn"
                type="button"
                role="tab"
                aria-selected="false"
                data-delivery-tab="archive">
            Archive
            <span class="ms-1 text-muted">@archivedDeliveries.Count</span>
        </button>
    </div>

    <div class="toolbar">
        <div class="toolbar-group">
            <div class="input-group search-control">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input id="deliverySearch"
                       class="form-control"
                       type="search"
                       placeholder="Search delivery ID, batch, or receiver..." />
            </div>
        </div>

        <button id="exportDeliveries" class="btn btn-outline-secondary" type="button">
            <i class="bi bi-download me-1"></i>
            Export
        </button>
    </div>

    <section id="activeDeliveryPanel" class="delivery-table-panel" role="tabpanel">
        <div class="app-card management-card">
            <div class="table-responsive management-table-responsive">
                <table class="table app-table">
                    <thead>
                        <tr>
                            <th>Delivery ID</th>
                            <th>Batch ID</th>
                            <th>Received By</th>
                            <th>Date Received</th>
                            <th class="text-end">Products</th>
                            <th class="text-end">Total Units</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var delivery in activeDeliveries)
                        {
                            string code = delivery.batch_ID.Replace("BATCH-", "DEL-");
                            int units = delivery.DeliveryDetails.Sum(detail => detail.product_quantity);

                            <tr class="delivery-row active-delivery-row"
                                data-href="@Url.Action("Details", new { id = delivery.delivery_ID })"
                                data-search="@($"{code} {delivery.batch_ID} {delivery.received_by}".ToLowerInvariant())">
                                <td class="fw-bold">@code</td>
                                <td class="fw-bold">@delivery.batch_ID</td>
                                <td class="fw-semibold">@delivery.received_by</td>
                                <td class="fw-semibold">@delivery.date_delivered.ToString("MMM d, yyyy")</td>
                                <td class="text-end fw-semibold">@delivery.DeliveryDetails.Count</td>
                                <td class="text-end fw-semibold">@units</td>
                                <td><span class="status-badge status-completed">Completed</span></td>
                                <td class="text-end action-cell">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light no-caret dropdown-toggle"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                data-bs-boundary="viewport"
                                                aria-label="Delivery actions">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-action="Details"
                                                   asp-route-id="@delivery.delivery_ID">
                                                    <i class="bi bi-eye me-2"></i>View
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <button class="dropdown-item archive-delivery"
                                                        type="button"
                                                        data-id="@delivery.delivery_ID"
                                                        data-code="@code">
                                                    <i class="bi bi-archive me-2"></i>Archive
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }

                        <tr id="activeDeliveryEmpty" class="d-none">
                            <td colspan="8">
                                <div class="empty-state">
                                    <i class="bi bi-truck"></i>
                                    No deliveries found.
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="list-footer">
                <div class="range-indicator">
                    <div id="activeDeliveryRangeText" class="small text-muted">Showing 0 items</div>
                    <div class="pagination-range-track"><span id="activeDeliveryRangeBar"></span></div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label for="activeDeliveryPageSize" class="small text-muted text-nowrap">Items per page</label>
                    <select id="activeDeliveryPageSize" class="form-select form-select-sm page-size-select">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                    </select>
                </div>
                <nav aria-label="Delivery pages">
                    <ul id="activeDeliveryPagination" class="pagination pagination-sm mb-0"></ul>
                </nav>
            </div>
        </div>
    </section>

    <section id="archiveDeliveryPanel" class="delivery-table-panel d-none" role="tabpanel">
        <div class="app-card management-card">
            <div class="table-responsive management-table-responsive">
                <table class="table app-table">
                    <thead>
                        <tr>
                            <th>Delivery ID</th>
                            <th>Batch ID</th>
                            <th>Received By</th>
                            <th>Date Received</th>
                            <th class="text-end">Products</th>
                            <th class="text-end">Total Units</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var delivery in archivedDeliveries)
                        {
                            string code = delivery.batch_ID.Replace("BATCH-", "DEL-");
                            int units = delivery.DeliveryDetails.Sum(detail => detail.product_quantity);

                            <tr class="delivery-row archive-delivery-row"
                                data-href="@Url.Action("Details", new { id = delivery.delivery_ID })"
                                data-search="@($"{code} {delivery.batch_ID} {delivery.received_by}".ToLowerInvariant())">
                                <td class="fw-semibold">@code</td>
                                <td>@delivery.batch_ID</td>
                                <td>@delivery.received_by</td>
                                <td>@delivery.date_delivered.ToString("MMM d, yyyy")</td>
                                <td class="text-end">@delivery.DeliveryDetails.Count</td>
                                <td class="text-end fw-semibold">@units</td>
                                <td><span class="status-badge status-archived">Archived</span></td>
                                <td class="text-end action-cell">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light no-caret dropdown-toggle"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                data-bs-boundary="viewport"
                                                aria-label="Archived delivery actions">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-action="Details"
                                                   asp-route-id="@delivery.delivery_ID">
                                                    <i class="bi bi-eye me-2"></i>View
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <button class="dropdown-item text-danger delete-delivery"
                                                        type="button"
                                                        data-id="@delivery.delivery_ID"
                                                        data-code="@code">
                                                    <i class="bi bi-trash me-2"></i>Delete
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }

                        <tr id="archiveDeliveryEmpty" class="d-none">
                            <td colspan="8">
                                <div class="empty-state">
                                    <i class="bi bi-archive"></i>
                                    No archived deliveries found.
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="list-footer">
                <div class="range-indicator">
                    <div id="archiveDeliveryRangeText" class="small text-muted">Showing 0 items</div>
                    <div class="pagination-range-track"><span id="archiveDeliveryRangeBar"></span></div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label for="archiveDeliveryPageSize" class="small text-muted text-nowrap">Items per page</label>
                    <select id="archiveDeliveryPageSize" class="form-select form-select-sm page-size-select">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                    </select>
                </div>
                <nav aria-label="Archived delivery pages">
                    <ul id="archiveDeliveryPagination" class="pagination pagination-sm mb-0"></ul>
                </nav>
            </div>
        </div>
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/delivery-management.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/delivery-management.js" asp-append-version="true"></script>
}
