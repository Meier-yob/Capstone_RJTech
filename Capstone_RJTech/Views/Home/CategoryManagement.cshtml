@model IEnumerable<Capstone_RJTech.Models.ProductCategory>
@{
    ViewData["Title"] = "Category Management";
    Layout = "_Layout";
    var products = ViewBag.Products as List<Capstone_RJTech.Models.Product> ?? new List<Capstone_RJTech.Models.Product>();
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h4 mb-1">Category Management</h2>
           
        </div>
        <button class="btn btn-primary px-4" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
            <i class="bi bi-plus-lg me-1"></i> Add Category
        </button>   
    </div>

    <div class="row g-4">
        <!-- LEFT COLUMN: Categories List & Search -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="searchCategoryInput" class="form-control bg-light border-start-0" placeholder="Search categories...">
                    </div>
                </div>
                <div class="card-body p-2">
                    <div class="list-group list-group-flush" id="categoryList">
                        <!-- All Categories Option -->
                        <a href="javascript:void(0)" class="list-group-item list-group-item-action category-item active rounded mb-1 border-0 d-flex justify-content-between align-items-center p-3" data-category-id="all">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-grid-fill me-3 fs-5"></i>
                                <div>
                                    <h6 class="mb-0 fw-bold">All Products</h6>
                                    <small class="text-muted">Master Inventory View</small>
                                </div>
                            </div>
                            <span class="badge bg-primary rounded-pill">@products.Count</span>
                        </a>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var cat in Model)
                            {
                                var catProductCount = products.Count(p => p.category_ID == cat.category_ID);
                                <div class="category-wrapper mb-1">
                                    <a href="javascript:void(0)" class="list-group-item list-group-item-action category-item rounded border-0 d-flex justify-content-between align-items-center p-3" data-category-id="@cat.category_ID" data-category-name="@cat.category_name">
                                        <div class="d-flex align-items-center me-2">
                                            <i class="bi bi-folder2-open me-3 fs-5 text-secondary"></i>
                                            <div class="text-truncate" style="max-width: 160px;">
                                                <h6 class="mb-0 fw-bold category-title">@cat.category_name</h6>
                                                <small class="text-muted">ID: CAT-@cat.category_ID.ToString("D3")</small>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-light text-dark border rounded-pill">@catProductCount</span>
                                            <!-- Edit Category Trigger Button -->
                                            <button type="button" class="btn btn-sm btn-outline-secondary border-0 edit-category-btn p-1 px-2" data-id="@cat.category_ID" data-name="@cat.category_name" title="Edit Category">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </div>
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">No categories configured.</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Products in Selected Category -->
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-0" id="selectedCategoryHeader">All Products</h5>
                        <small class="text-muted" id="selectedCategorySub">Showing items across all categories</small>
                    </div>
                    <div class="input-group style-search" style="width: 250px;">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="searchProductInput" class="form-control bg-light border-start-0 ps-0" placeholder="Search items...">
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="categoryProductsTable">
                        <thead class="table-light">
                            <tr>
                                <th>Product Code</th>
                                <th>Brand</th>
                                <th>Description</th>
                                <th>Quantity</th>
                                <th>Price</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (products.Any())
                            {
                                foreach (var prod in products)
                                {
                                    <tr class="product-row-item" data-category-id="@prod.category_ID">
                                        <td class="fw-medium">@Capstone_RJTech.Controllers.HomeController.GetFormattedCodeForProduct(prod)</td>
                                        <td>@prod.product_brand</td>
                                        <td class="text-truncate" style="max-width: 200px;">@prod.product_description</td>
                                        <td>@prod.product_quantity</td>
                                        <td>@prod.Product_price.ToString("C")</td>
                                        <td>
                                            <span class="badge rounded-pill @(prod.product_status == "Available" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                                                @prod.product_status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="noProductsRow">
                                    <td colspan="6" class="text-center text-muted py-4">No products found in this category.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CREATE CATEGORY MODAL -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold">Create New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createCategoryForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Category Name</label>
                        <input type="text" name="category_name" class="form-control" placeholder="e.g. Storage Devices" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT CATEGORY MODAL -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold">Edit Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editCategoryForm">
                <input type="hidden" id="editCategoryID" name="category_ID" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Category Name</label>
                        <input type="text" id="editCategoryName" name="category_name" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Update Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .card {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 8px;
    }

    .category-item {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        color: #212529;
    }

        .category-item.active {
            background-color: #0d6efd !important;
            color: #fff !important;
        }

            .category-item.active small, .category-item.active i {
                color: #fff !important;
            }

        .category-item:hover:not(.active) {
            background-color: #f8f9fa;
        }

    .table thead th {
        font-weight: 600;
        font-size: 0.85rem;
        color: #6c757d;
    }

    .table tbody td {
        font-size: 0.9rem;
        padding: 0.75rem;
    }
</style>

<!-- jQuery Client Script -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {

        // 1. FILTER PRODUCTS BY CATEGORY SELECTION
        $(document).on('click', '.category-item', function(e) {
            // Avoid triggering category select when clicking the inline edit button
            if ($(e.target).closest('.edit-category-btn').length) return;

            $('.category-item').removeClass('active');
            $(this).addClass('active');

            var catId = $(this).data('category-id');
            var catName = $(this).data('category-name') || 'All Products';

            $('#selectedCategoryHeader').text(catName);
            $('#selectedCategorySub').text(catId === 'all' ? 'Showing items across all categories' : 'Filtered by selected category');

            var visibleCount = 0;
            $('.product-row-item').each(function() {
                var rowCatId = $(this).data('category-id');
                if (catId === 'all' || rowCatId == catId) {
                    $(this).show();
                    visibleCount++;
                } else {
                    $(this).hide();
                }
            });

            if (visibleCount === 0) {
                if ($('#noProductsRow').length === 0) {
                    $('#categoryProductsTable tbody').append('<tr id="noProductsRow"><td colspan="6" class="text-center text-muted py-4">No products found in this category.</td></tr>');
                } else {
                    $('#noProductsRow').show();
                }
            } else {
                $('#noProductsRow').hide();
            }
        });

        // 2. SEARCH CATEGORIES IN REAL-TIME
        $('#searchCategoryInput').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            $('#categoryList .category-wrapper').filter(function() {
                var title = $(this).find('.category-title').text().toLowerCase();
                $(this).toggle(title.indexOf(value) > -1);
            });
        });

        // 3. FILTER PRODUCTS TABLE BY INPUT
        $('#searchProductInput').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            $('.product-row-item:visible').filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });

        // 4. OPEN EDIT CATEGORY MODAL
        $(document).on('click', '.edit-category-btn', function(e) {
            e.stopPropagation();
            var id = $(this).data('id');
            var name = $(this).data('name');

            $('#editCategoryID').val(id);
            $('#editCategoryName').val(name);
            $('#editCategoryModal').modal('show');
        });

        // 5. SUBMIT EDIT CATEGORY FORM (AJAX)
        $('#editCategoryForm').on('submit', function(e) {
            e.preventDefault();
            $.ajax({
                url: '/Home/EditCategory',
                type: 'POST',
                data: $(this).serialize(),
                success: function(res) {
                    if (res.success) {
                        location.reload(); // Refresh to sync category names
                    } else {
                        alert(res.message || 'Failed to update category.');
                    }
                }
            });
        });

        // 6. SUBMIT CREATE CATEGORY FORM (AJAX)
        $('#createCategoryForm').on('submit', function(e) {
            e.preventDefault();
            $.ajax({
                url: '/Home/CreateCategory',
                type: 'POST',
                data: $(this).serialize(),
                success: function(res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message || 'Failed to create category.');
                    }
                }
            });
        });

    });
</script>