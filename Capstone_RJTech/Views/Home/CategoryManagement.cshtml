@model IEnumerable<Capstone_RJTech.Models.ProductCategory>
@{
    ViewData["Title"] = "Category Management";
    ViewData["Description"] = "Manage product categories and their associated products.";
    Layout = "_Layout";
    var products = ViewBag.Products as List<Capstone_RJTech.Models.Product> ?? new List<Capstone_RJTech.Models.Product>();
}

<div class="container-fluid px-4 py-3 bg-light">
    <!-- Top Action Bar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="h4 mb-0 text-dark fw-bold">Category Management</h3>
        <button type="button" class="btn btn-teal btn-sm px-3 fw-semibold text-white d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
            <i class="bi bi-plus-lg me-1"></i> Add Category
        </button>
    </div>

    <div class="row g-3">
        <!-- LEFT COLUMN: Categories List & Search -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100 rounded-3 overflow-hidden">
                <!-- Category Search Header -->
                <div class="card-header bg-white py-3 border-bottom-0">
                    <div class="position-relative">
                        <label for="searchCategoryInput" class="form-label text-muted fs-8 mb-0 d-block">Search categories</label>
                        <div class="input-group input-group-sm border-bottom">
                            <span class="input-group-text bg-transparent border-0 ps-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" id="searchCategoryInput" class="form-control border-0 bg-transparent shadow-none" placeholder="Filter categories...">
                        </div>
                    </div>
                </div>

                <div class="card-body p-2">
                    <div class="list-group list-group-flush gap-1" id="categoryList">
                        <!-- All Categories Option -->
                        <a href="javascript:void(0)" class="list-group-item list-group-item-action category-item active rounded mb-1 border-0 d-flex justify-content-between align-items-center p-3" data-category-id="all">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-grid-fill me-3 fs-5"></i>
                                <div>
                                    <h6 class="mb-0 fw-bold">All Products</h6>
                                    <small class="text-white-50 fs-8">Master Inventory View</small>
                                </div>
                            </div>
                            <span class="badge rounded-pill bg-white text-teal fw-bold">@products.Count</span>
                        </a>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var cat in Model)
                            {
                                var catProductCount = products.Count(p => p.category_ID == cat.category_ID);
                                <div class="category-wrapper">
                                    <a href="javascript:void(0)" class="list-group-item list-group-item-action category-item rounded border-0 d-flex justify-content-between align-items-center p-3" data-category-id="@cat.category_ID" data-category-name="@cat.category_name">
                                        <div class="d-flex align-items-center me-2">
                                            <i class="bi bi-folder2-open me-3 fs-5 category-icon"></i>
                                            <div class="text-truncate" style="max-width: 160px;">
                                                <h6 class="mb-0 fw-bold category-title">@cat.category_name</h6>
                                                <small class="text-muted fs-8 category-sub">ID: CAT-@cat.category_ID.ToString("D3")</small>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge rounded-pill bg-light text-dark border count-badge">@catProductCount</span>
                                            <!-- Edit Category Trigger Button -->
                                            <button type="button" class="btn btn-sm btn-outline-teal border-0 edit-category-btn p-1 px-2" data-id="@cat.category_ID" data-name="@cat.category_name" title="Edit Category">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </div>
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4 fs-7">No categories configured.</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Products in Selected Category -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title fw-bold text-dark mb-0 fs-6" id="selectedCategoryHeader">All Products</h5>
                        <span class="text-muted fs-8" id="selectedCategorySub">Showing items across all categories</span>
                    </div>
                    <div class="position-relative" style="width: 220px;">
                        <div class="input-group input-group-sm border-bottom">
                            <span class="input-group-text bg-transparent border-0 ps-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" id="searchProductInput" class="form-control border-0 bg-transparent shadow-none ps-0" placeholder="Search items...">
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0 custom-product-table" id="categoryProductsTable">
                        <thead>
                            <tr>
                                <th class="fw-semibold ps-3">Product Code</th>
                                <th class="fw-semibold">Brand</th>
                                <th class="fw-semibold">Description</th>
                                <th class="fw-semibold text-center">Quantity</th>
                                <th class="fw-semibold">Price</th>
                                <th class="fw-semibold text-center pe-3">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (products.Any())
                            {
                                foreach (var prod in products)
                                {
                                    <tr class="product-row-item" data-category-id="@prod.category_ID">
                                        <td class="fw-bold text-dark ps-3">@Capstone_RJTech.Controllers.HomeController.GetFormattedCodeForProduct(prod)</td>
                                        <td class="text-secondary">@(string.IsNullOrEmpty(prod.product_brand) ? "-" : prod.product_brand)</td>
                                        <td class="text-secondary text-truncate" style="max-width: 200px;">@prod.product_description</td>
                                        <td class="text-center fw-semibold text-dark">@prod.product_quantity</td>
                                        <td class="fw-semibold text-dark">₱@prod.Product_price.ToString("#,##0.00")</td>
                                        <td class="text-center pe-3">
                                            @if (prod.product_status == "Available")
                                            {
                                                <span class="badge-pill-custom badge-available">
                                                    <i class="bi bi-dot me-1"></i>Available
                                                </span>
                                            }
                                            else if (prod.product_status == "Low Stock")
                                            {
                                                <span class="badge-pill-custom badge-lowstock">
                                                    <i class="bi bi-dot me-1"></i>Low Stock
                                                </span>
                                            }
                                            else if (prod.product_status == "Out of Stock")
                                            {
                                                <span class="badge-pill-custom badge-outofstock">
                                                    <i class="bi bi-dot me-1"></i>Out of Stock
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge-pill-custom badge-pendingdelivery">
                                                    <i class="bi bi-dot me-1"></i>@prod.product_status
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="noProductsRow">
                                    <td colspan="6" class="text-center text-muted py-4 fs-7">No products found in this category.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CREATE CATEGORY MODAL -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-teal text-white">
                <h5 class="modal-title fw-bold fs-6"><i class="bi bi-plus-square me-2"></i>Create New Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createCategoryForm">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label text-secondary fs-8 fw-bold text-uppercase">Category Name</label>
                        <input type="text" name="category_name" class="form-control form-control-sm border-0 border-bottom rounded-0 bg-light shadow-none" placeholder="e.g. Storage Devices" required />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-teal px-4 fw-semibold text-white">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT CATEGORY MODAL -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-teal text-white">
                <h5 class="modal-title fw-bold fs-6"><i class="bi bi-pencil-square me-2"></i>Edit Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editCategoryForm">
                <input type="hidden" id="editCategoryID" name="category_ID" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label text-secondary fs-8 fw-bold text-uppercase">Category Name</label>
                        <input type="text" id="editCategoryName" name="category_name" class="form-control form-control-sm border-0 border-bottom rounded-0 bg-light shadow-none" required />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-teal px-4 fw-semibold text-white">Update Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    :root {
        --teal-color: #0b6b5d;
        --teal-hover: #085247;
    }

    .text-teal {
        color: var(--teal-color) !important;
    }

    .bg-teal {
        background-color: var(--teal-color) !important;
    }

    .btn-teal {
        background-color: var(--teal-color);
        border-color: var(--teal-color);
    }

        .btn-teal:hover {
            background-color: var(--teal-hover);
            border-color: var(--teal-hover);
        }

    .btn-outline-teal {
        color: var(--teal-color);
        border-color: var(--teal-color);
    }

        .btn-outline-teal:hover {
            background-color: var(--teal-color);
            color: #ffffff !important;
        }

    .fs-7 {
        font-size: 0.85rem;
    }

    .fs-8 {
        font-size: 0.75rem;
    }

    /* Category List Styling */
    .category-item {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        color: #212529;
        background-color: #f8f9fa;
    }

        .category-item .category-icon {
            color: var(--teal-color);
        }

        .category-item.active {
            background-color: var(--teal-color) !important;
            color: #fff !important;
        }

            .category-item.active .category-sub,
            .category-item.active .category-icon {
                color: #ffffff !important;
            }

            .category-item.active .btn-outline-teal {
                color: #ffffff;
                border-color: rgba(255, 255, 255, 0.4);
            }

                .category-item.active .btn-outline-teal:hover {
                    background-color: rgba(255, 255, 255, 0.2);
                    color: #ffffff !important;
                }

        .category-item:hover:not(.active) {
            background-color: #e9ecef;
        }

    /* Custom Table Design matched to Product Management */
    .custom-product-table {
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
        font-size: 0.875rem;
    }

        .custom-product-table thead th {
            background-color: #f8f9fa;
            color: #495057;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 12px 16px;
            border-bottom: 1px solid #e9ecef;
            white-space: nowrap;
        }

        .custom-product-table tbody tr {
            transition: background-color 0.2s ease;
            cursor: pointer;
        }

            .custom-product-table tbody tr:hover {
                background-color: #f1f5f4 !important;
            }

        .custom-product-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid #f1f3f5;
            vertical-align: middle;
        }

    /* Soft Pill Badges */
    .badge-pill-custom {
        font-size: 0.725rem;
        font-weight: 600;
        padding: 0.35em 0.8em;
        border-radius: 50rem;
        letter-spacing: 0.3px;
        display: inline-block;
    }

    .badge-available {
        background-color: #e6f4ea;
        color: #137333;
    }

    .badge-lowstock {
        background-color: #fff4e5;
        color: #b45f00;
    }

    .badge-outofstock {
        background-color: #fce8e6;
        color: #c5221f;
    }

    .badge-pendingdelivery {
        background-color: #f2f2f2;
        color: #6c757d;
    }
</style>

<!-- jQuery Client Script -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {

        // 1. FILTER PRODUCTS BY CATEGORY SELECTION
        $(document).on('click', '.category-item', function(e) {
            // Avoid triggering category select when clicking the inline edit button
            if ($(e.target).closest('.edit-category-btn').length) return;

            $('.category-item').removeClass('active');
            $(this).addClass('active');

            var catId = $(this).data('category-id');
            var catName = $(this).data('category-name') || 'All Products';

            $('#selectedCategoryHeader').text(catName);
            $('#selectedCategorySub').text(catId === 'all' ? 'Showing items across all categories' : 'Filtered by selected category');

            var visibleCount = 0;
            $('.product-row-item').each(function() {
                var rowCatId = $(this).data('category-id');
                if (catId === 'all' || rowCatId == catId) {
                    $(this).show();
                    visibleCount++;
                } else {
                    $(this).hide();
                }
            });

            if (visibleCount === 0) {
                if ($('#noProductsRow').length === 0) {
                    $('#categoryProductsTable tbody').append('<tr id="noProductsRow"><td colspan="6" class="text-center text-muted py-4 fs-7">No products found in this category.</td></tr>');
                } else {
                    $('#noProductsRow').show();
                }
            } else {
                $('#noProductsRow').hide();
            }
        });

        // 2. SEARCH CATEGORIES IN REAL-TIME
        $('#searchCategoryInput').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            $('#categoryList .category-wrapper').filter(function() {
                var title = $(this).find('.category-title').text().toLowerCase();
                $(this).toggle(title.indexOf(value) > -1);
            });
        });

        // 3. FILTER PRODUCTS TABLE BY INPUT
        $('#searchProductInput').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            $('.product-row-item:visible').filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });

        // 4. OPEN EDIT CATEGORY MODAL
        $(document).on('click', '.edit-category-btn', function(e) {
            e.stopPropagation();
            var id = $(this).data('id');
            var name = $(this).data('name');

            $('#editCategoryID').val(id);
            $('#editCategoryName').val(name);
            $('#editCategoryModal').modal('show');
        });

        // 5. SUBMIT EDIT CATEGORY FORM (AJAX)
        $('#editCategoryForm').on('submit', function(e) {
            e.preventDefault();
            $.ajax({
                url: '/Home/EditCategory',
                type: 'POST',
                data: $(this).serialize(),
                success: function(res) {
                    if (res.success) {
                        location.reload(); // Refresh to sync category names
                    } else {
                        alert(res.message || 'Failed to update category.');
                    }
                }
            });
        });

        // 6. SUBMIT CREATE CATEGORY FORM (AJAX)
        $('#createCategoryForm').on('submit', function(e) {
            e.preventDefault();
            $.ajax({
                url: '/Home/CreateCategory',
                type: 'POST',
                data: $(this).serialize(),
                success: function(res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message || 'Failed to create category.');
                    }
                }
            });
        });

    });
</script>