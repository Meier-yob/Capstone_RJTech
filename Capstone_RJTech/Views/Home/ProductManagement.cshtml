@using Capstone_RJTech.Controllers
@model IEnumerable<Capstone_RJTech.Models.Product>
@{
    ViewData["Title"] = "Product Management";
    ViewData["Description"] = "Manage your products, including adding, editing, and viewing details.";

    Layout = "_Layout";
    var categories = ViewBag.Categories as List<Capstone_RJTech.Models.ProductCategory> ?? new List<Capstone_RJTech.Models.ProductCategory>();

    var totalItems = Model.Count();
    var reorderItems = Model.Count(x => x.product_quantity <= x.reorder_level && x.product_quantity > 0);
    var outOfStockItems = Model.Count(x => x.product_quantity == 0 || x.product_status == "Out of Stock");
}

<div class="container-fluid px-4 py-3 bg-light">

    <!-- Top Action Bar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="h4 mb-0 text-dark fw-bold">Items</h3>
        <div class="d-flex align-items-center gap-2">

            <button type="button" class="btn btn-outline-teal btn-sm px-3 text-teal fw-semibold ms-2" id="btnTriggerQuickEdit">
                <i class="bi bi-list-task me-1"></i> QUICK EDIT
            </button>

            <!-- Quick Add Toggle -->
            <button type="button" class="btn btn-outline-teal btn-sm px-3 text-teal fw-semibold ms-2" id="btnToggleQuickAdd">
                <i class="bi bi-plus-square me-1"></i> QUICK ADD
            </button>

            <!-- Create Product Modal Button -->
            <button type="button" class="btn btn-teal btn-sm px-3 fw-semibold text-white d-flex align-items-center gap-1" id="btnOpenAddProduct">
                <i class="bi bi-plus-lg me-1"></i> New Item
            </button>
        </div>
    </div>

    <!-- Upper Filter Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center mb-2">
                <!-- Search Input -->
                <div class="col-md-5">
                    <div class="position-relative">
                        <label for="searchInput" class="form-label text-muted fs-8 mb-0 d-block">Search items</label>
                        <div class="input-group input-group-sm border-bottom">
                            <span class="input-group-text bg-transparent border-0 ps-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" id="searchInput" class="form-control border-0 bg-transparent shadow-none" placeholder="">
                        </div>
                    </div>
                </div>

                <!-- Category Filter Dropdown -->
                <div class="col-md-3">
                    <div class="d-flex align-items-center">
                        <div class="w-100">
                            <select id="filterCategory" class="form-select form-select-sm border-0 border-bottom bg-transparent shadow-none">
                                <option value="">Category</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.category_name">@cat.category_name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Status / Type Filter Dropdown -->
                <div class="col-md-2">
                    <select id="filterStatus" class="form-select form-select-sm border-0 border-bottom bg-transparent shadow-none">
                        <option value="">Status</option>
                        <option value="Available">Available</option>
                        <option value="Low Stock">Low Stock</option>
                        <option value="Out of Stock">Out of Stock</option>
                        <option value="Pending Delivery">Pending Delivery</option>
                    </select>
                </div>

            </div>

            <!-- Checkbox Bar -->
            <div class="pt-2">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="chkBatches">
                    <label class="form-check-label fs-7 text-secondary" for="chkBatches">Only Items With Batches</label>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Badges Pill Bar -->
    <div class="d-flex gap-2 mb-3">
        <button type="button" class="btn btn-sm btn-light-pill border rounded-pill px-3 active filter-badge" data-filter="all">
            All Items:<span class="fw-bold ms-1" id="cntAll">@totalItems</span>
        </button>
        <button type="button" class="btn btn-sm btn-light-pill border rounded-pill px-3 filter-badge" data-filter="lowstock">
            Low Stock:<span class="fw-bold ms-1" id="cntLow">@Model.Count(x => x.product_status == "Low Stock")</span>
        </button>
        <button type="button" class="btn btn-sm btn-light-pill border rounded-pill px-3 filter-badge" data-filter="outofstock">
            Out of Stock:<span class="fw-bold ms-1" id="cntOut">@Model.Count(x => x.product_status == "Out of Stock")</span>
        </button>
        <button type="button" class="btn btn-sm btn-light-pill border rounded-pill px-3 filter-badge" data-filter="pendingdelivery">
            Pending Delivery:<span class="fw-bold ms-1" id="cntPending">@Model.Count(x => x.product_status == "Pending Delivery")</span>
        </button>
    </div>

    <!-- Quick Add Inline Bar -->
    <div id="quickAddContainer" class="card border-0 shadow-sm mb-3 border-start border-4 border-teal d-none">
        <div class="card-body bg-light-gray py-2 px-3">
            <form id="quickAddForm" class="row g-2 align-items-center">
                <div class="col-auto">
                    <button type="button" class="btn btn-teal btn-sm rounded-circle p-0 text-white d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                        <i class="bi bi-plus"></i>
                    </button>
                </div>
                <div class="col-md-4">
                    <input type="text" id="quickDescription" name="product_description" class="form-control form-control-sm bg-white" placeholder="Item name" required>
                </div>

                <!-- Replaced SKU field with Category Dropdown -->
                <div class="col-md-2">
                    <select id="quickCategory" name="category_ID" class="form-select form-select-sm bg-white" required>
                        <option value="" disabled selected>Category</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.category_ID">@cat.category_name</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted">Rate <br> ₱</span>
                        <input type="number" step="0.01" id="quickPrice" name="Product_price" class="form-control border-start-0 bg-white" placeholder="0.00" required>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" id="btnSubmitQuickAdd" class="btn btn-teal btn-sm fw-bold px-3 text-white">
                        <i class="bi bi-plus-lg me-1"></i> ADD
                    </button>
                </div>
                <div class="col-auto">
                    <span class="text-muted fs-8">Press Enter to add.</span>
                </div>
                <div class="col-auto ms-auto">
                    <button type="button" id="btnCancelQuickAdd" class="btn btn-link text-secondary btn-sm p-0">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0 custom-product-table" id="productTable">
                <thead>
                    <tr>
                        <th class="fw-semibold ps-3">Product ID <i class="bi bi-caret-down-fill ms-1 fs-8"></i></th>
                        <th class="fw-semibold">Category</th>
                        <th class="fw-semibold">Brand</th>
                        <th class="fw-semibold">Description</th>
                        <th class="fw-semibold text-center">Total Qty</th>
                        <th class="fw-semibold">Price</th>
                        <th class="fw-semibold text-center">Reorder Lvl</th>
                        <th class="fw-semibold text-center pe-3">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="product-row" data-id="@item.product_ID" data-reorder="@item.reorder_level" data-qty="@item.product_quantity" data-status="@item.product_status">
                            <td class="fw-bold text-dark ps-3">@HomeController.GetFormattedCodeForProduct(item)</td>
                            <td class="text-secondary fw-medium">@(item.Category?.category_name ?? "N/A")</td>
                            <td class="text-secondary">@(string.IsNullOrEmpty(item.product_brand) ? "-" : item.product_brand)</td>
                            <td class="text-secondary text-truncate" style="max-width: 250px;">@item.product_description</td>
                            <td class="text-center fw-semibold text-dark">@item.product_quantity</td>
                            <td class="fw-semibold text-dark">₱@item.Product_price.ToString("#,##0.00")</td>
                            <td class="text-center text-muted">@item.reorder_level</td>
                            <td class="text-center pe-3">
                                @if (item.product_status == "Available")
                                {
                                    <span class="badge-pill-custom badge-available">
                                        <i class="bi bi-dot me-1"></i>Available
                                    </span>
                                }
                                else if (item.product_status == "Low Stock")
                                {
                                    <span class="badge-pill-custom badge-lowstock">
                                        <i class="bi bi-dot me-1"></i>Low Stock
                                    </span>
                                }
                                else if (item.product_status == "Out of Stock")
                                {
                                    <span class="badge-pill-custom badge-outofstock">
                                        <i class="bi bi-dot me-1"></i>Out of Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-pill-custom badge-pendingdelivery">
                                        <i class="bi bi-dot me-1"></i>@item.product_status
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Styling matched to screenshot theme */
    :root {
        --teal-color: #0b6b5d;
        --teal-hover: #085247;
    }

    .bg-light-gray {
        background-color: #f7f9fa;
    }

    .text-teal {
        color: var(--teal-color) !important;
    }

    .btn-teal {
        background-color: var(--teal-color);
        border-color: var(--teal-color);
    }

        .btn-teal:hover {
            background-color: var(--teal-hover);
            border-color: var(--teal-hover);
        }

    .btn-outline-teal {
        color: var(--teal-color);
        border-color: var(--teal-color);
    }

        .btn-outline-teal:hover {
            background-color: var(--teal-color);
            color: #ffffff !important;
        }

    .border-teal {
        border-color: var(--teal-color) !important;
    }

    .custom-btn-outline {
        color: #495057;
        border-color: #ced4da;
        background-color: #ffffff;
        font-size: 0.75rem;
        font-weight: 600;
    }

        .custom-btn-outline:hover {
            background-color: #f8f9fa;
            color: #212529;
        }

    .btn-light-pill {
        background-color: #e9ecef;
        color: #495057;
        font-size: 0.75rem;
    }

        .btn-light-pill.active {
            background-color: #dee2e6;
            color: #212529;
        }

    .fs-7 {
        font-size: 0.85rem;
    }

    .fs-8 {
        font-size: 0.75rem;
    }

            .custom-product-table {
                border-collapse: separate;
                border-spacing: 0;
                width: 100%;
                font-size: 0.875rem;
            }

                .custom-product-table thead th {
                    background-color: #f8f9fa;
                    color: #495057;
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    padding: 12px 16px;
                    border-bottom: 1px solid #e9ecef;
                    white-space: nowrap;
                }

                .custom-product-table tbody tr {
                    transition: background-color 0.2s ease;
                    cursor: pointer;
                }

                    .custom-product-table tbody tr:hover {
