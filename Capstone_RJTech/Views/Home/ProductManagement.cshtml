@using Capstone_RJTech.Controllers
@model IEnumerable<Capstone_RJTech.Models.Product>
@{
    ViewData["Title"] = "Product Management";
    ViewData["Description"] = "Manage your products, including adding, editing, and viewing details.";

    Layout = "_Layout";
    var categories = ViewBag.Categories as List<Capstone_RJTech.Models.ProductCategory> ?? new List<Capstone_RJTech.Models.ProductCategory>();
    var pendingReorderProductIds = ViewBag.PendingReorderProductIds as HashSet<int> ?? new HashSet<int>();

    var totalItems = Model.Count();
    var reorderItems = Model.Count(x => x.product_quantity <= x.reorder_level && x.product_quantity > 0);
    var outOfStockItems = Model.Count(x => x.product_quantity == 0 || x.product_status == "Out of Stock");
}

<div id="productManagementWrapper" class="container-fluid px-4 py-3 bg-light">

    <!-- Top Action Bar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="h4 mb-0 text-dark fw-bold">Items</h3>
        <div class="d-flex align-items-center gap-2">

            

            <!-- Create Product Modal Button -->
            <button type="button" class="btn btn-teal btn-sm px-3 fw-semibold text-white d-flex align-items-center gap-1" id="btnOpenAddProduct">
                <i class="bi bi-plus-lg me-1"></i> New Item
            </button>
        </div>
    </div>

    <!-- Upper Filter Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center mb-2">
                <!-- Search Input -->
                <div class="col-md-5">
                    <div class="position-relative">
                        <label for="searchInput" class="form-label text-muted fs-8 mb-0 d-block">Search items</label>
                        <div class="input-group input-group-sm border-bottom">
                            <span class="input-group-text bg-transparent border-0 ps-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" id="searchInput" class="form-control border-0 bg-transparent shadow-none" placeholder="">
                        </div>
                    </div>
                </div>

                <!-- Category Filter Dropdown -->
                <div class="col-md-3">
                    <div class="d-flex align-items-center">
                        <div class="w-100">
                            <select id="filterCategory" class="form-select form-select-sm border-0 border-bottom bg-transparent shadow-none">
                                <option value="">Category</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.category_name">@cat.category_name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Status / Type Filter Dropdown -->
                <div class="col-md-2">
                    <select id="filterStatus" class="form-select form-select-sm border-0 border-bottom bg-transparent shadow-none">
                        <option value="">Status</option>
                        <option value="Available">Available</option>
                        <option value="Low Stock">Low Stock</option>
                        <option value="Out of Stock">Out of Stock</option>
                        <option value="Unavailable">Unavailable</option>
                    </select>
                </div>

            </div>

            <!-- Checkbox Bar -->
            <div class="pt-2">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="chkBatches">
                    <label class="form-check-label fs-7 text-secondary" for="chkBatches">Only Items With Batches</label>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Badges Pill Bar -->
    <div class="d-flex gap-2 mb-3">
        <button type="button" class="btn btn-sm btn-light-pill border rounded-pill px-3 active filter-badge" data-filter="all">
            All Items:<span class="fw-bold ms-1" id="cntAll">@totalItems</span>
        </button>
        <button type="button" class="btn btn-sm btn-light-pill border rounded-pill px-3 filter-badge" data-filter="lowstock">
            Low Stock:<span class="fw-bold ms-1" id="cntLow">@Model.Count(x => x.product_status == "Low Stock")</span>
        </button>
        <button type="button" class="btn btn-sm btn-light-pill border rounded-pill px-3 filter-badge" data-filter="outofstock">
            Out of Stock:<span class="fw-bold ms-1" id="cntOut">@Model.Count(x => x.product_status == "Out of Stock")</span>
        </button>
        <button type="button" class="btn btn-sm btn-light-pill border rounded-pill px-3 filter-badge" data-filter="unavailable">
            Unavailable:<span class="fw-bold ms-1" id="cntUnavailable">@Model.Count(x => x.product_status == "Unavailable")</span>
        </button>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0 custom-product-table" id="productTable">
                <thead>
                    <tr>
                        <th class="fw-semibold ps-3">Product ID <i class="bi bi-caret-down-fill ms-1 fs-8"></i></th>
                        <th class="fw-semibold">Category</th>
                        <th class="fw-semibold">Brand</th>
                        <th class="fw-semibold">Product Name</th>
                        <th class="fw-semibold text-center">Total Qty</th>
                        <th class="fw-semibold text-end">Price</th>
                        <th class="fw-semibold text-center">Reorder Lvl</th>
                        <th class="fw-semibold text-center pe-3">Status</th>
                        <th class="fw-semibold text-center pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="product-row" data-id="@item.product_ID" data-reorder="@item.reorder_level" data-qty="@item.product_quantity" data-status="@item.product_status">
                            <td class="fw-bold text-dark ps-3">@HomeController.GetFormattedCodeForProduct(item)</td>
                            <td class="text-secondary fw-medium">@(item.Category?.category_name ?? "N/A")</td>
                            <td class="text-secondary">@(string.IsNullOrEmpty(item.product_brand) ? "-" : item.product_brand)</td>
                            <td class="text-secondary fw-medium">@item.product_name</td>
                            <td class="text-center fw-semibold text-dark">@item.product_quantity</td>
                            <td class="fw-semibold text-dark text-end">₱@item.Product_price.ToString("#,##0.00")</td>
                            <td class="text-center text-muted">@item.reorder_level</td>
                            <td class="text-center pe-3">
                                @if (item.product_status == "Available")
                                {
                                    <span class="badge-pill-custom badge-available">
                                        <i class="bi bi-dot me-1"></i>Available
                                    </span>
                                }
                                else if (item.product_status == "Low Stock")
                                {
                                    <span class="badge-pill-custom badge-lowstock">
                                        <i class="bi bi-dot me-1"></i>Low Stock
                                    </span>
                                }
                                else if (item.product_status == "Out of Stock")
                                {
                                    <span class="badge-pill-custom badge-outofstock">
                                        <i class="bi bi-dot me-1"></i>Out of Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-pill-custom badge-pendingdelivery">
                                        <i class="bi bi-dot me-1"></i>@item.product_status
                                    </span>
                                }
                            </td>
                            <td class="text-center pe-3">
                                @if (pendingReorderProductIds.Contains(item.product_ID))
                                {
                                    <a asp-action="DeliveryManagement" asp-route-tab="pending" class="btn btn-sm btn-light border text-warning-emphasis">
                                        <i class="bi bi-hourglass-split me-1"></i>Pending Order
                                    </a>
                                }
                                else if (item.product_status == "Low Stock" || item.product_status == "Out of Stock")
                                {
                                    var suggestedQuantity = Math.Max(1, (item.reorder_level * 2) - item.product_quantity);
                                    <button type="button"
                                            class="btn btn-sm btn-outline-teal btn-reorder-product"
                                            data-id="@item.product_ID"
                                            data-code="@HomeController.GetFormattedCodeForProduct(item)"
                                            data-name="@item.product_name"
                                            data-qty="@item.product_quantity"
                                            data-level="@item.reorder_level"
                                            data-suggested="@suggestedQuantity">
                                        <i class="bi bi-arrow-repeat me-1"></i>Reorder
                                    </button>
                                }
                                else if (item.product_status == "Unavailable")
                                {
                                    <span class="badge-pill-custom badge-unavailable">
                                        <i class="bi bi-dot me-1"></i>Unavailable
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted fs-8">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="reorderModal" class="d-none" role="dialog" aria-modal="true" aria-labelledby="reorderModalTitle">
    <div class="reorder-modal-card card border-0 shadow-lg">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <div>
                <h5 class="mb-0 fw-bold" id="reorderModalTitle">Reorder Product</h5>
                <small class="text-muted">Confirm the suggested quantity</small>
            </div>
            <button type="button" class="btn-close btn-close-reorder" aria-label="Close"></button>
        </div>
        <div class="card-body p-4">
            <input type="hidden" id="reorderProductId">
            <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
                <div>
                    <span class="badge bg-light text-dark border mb-2" id="reorderProductCode">-</span>
                    <div class="fw-bold" id="reorderProductName">-</div>
                </div>
                <div class="text-end fs-8 text-muted">
                    Current stock: <strong class="text-dark" id="reorderCurrentQty">0</strong><br>
                    Reorder level: <strong class="text-dark" id="reorderLevel">0</strong>
                </div>
            </div>
            <label for="reorderQuantity" class="form-label fw-semibold">Order Quantity*</label>
            <input type="number" id="reorderQuantity" class="form-control" min="1" step="1" required>
            <div class="form-text">Suggested quantity raises stock to twice the reorder level.</div>
            <div id="reorderError" class="text-danger small mt-2 d-none"></div>
        </div>
        <div class="card-footer bg-white d-flex justify-content-end gap-2 py-3">
            <button type="button" class="btn btn-outline-secondary btn-sm btn-close-reorder">Cancel</button>
            <button type="button" class="btn btn-teal btn-sm px-4 text-white" id="btnConfirmReorder">
                <span class="spinner-border spinner-border-sm me-1 d-none" aria-hidden="true"></span>
                Confirm Reorder
            </button>
        </div>
    </div>
</div>

<style>
    /* Styling matched to screenshot theme */
    :root {
        --teal-color: #0b6b5d;
        --teal-hover: #085247;
    }

    .bg-light-gray {
        background-color: #f7f9fa;
    }

    .text-teal {
        color: var(--teal-color) !important;
    }

    .btn-teal {
        background-color: var(--teal-color);
        border-color: var(--teal-color);
    }

        .btn-teal:hover {
            background-color: var(--teal-hover);
            border-color: var(--teal-hover);
        }

    .btn-outline-teal {
        color: var(--teal-color);
        border-color: var(--teal-color);
    }

        .btn-outline-teal:hover {
            background-color: var(--teal-color);
            color: #ffffff !important;
        }

    .border-teal {
        border-color: var(--teal-color) !important;
    }

    .custom-btn-outline {
        color: #495057;
        border-color: #ced4da;
        background-color: #ffffff;
        font-size: 0.75rem;
        font-weight: 600;
    }

        .custom-btn-outline:hover {
            background-color: #f8f9fa;
            color: #212529;
        }

    .btn-light-pill {
        background-color: #e9ecef;
        color: #495057;
        font-size: 0.75rem;
    }

        .btn-light-pill.active {
            background-color: #dee2e6;
            color: #212529;
        }

    .fs-7 {
        font-size: 0.85rem;
    }

    .fs-8 {
        font-size: 0.75rem;
    }

            .custom-product-table {
                border-collapse: separate;
                border-spacing: 0;
                width: 100%;
                font-size: 0.875rem;
            }

                .custom-product-table thead th {
                    background-color: #f8f9fa;
                    color: #495057;
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    padding: 12px 16px;
                    border-bottom: 1px solid #e9ecef;
                    white-space: nowrap;
                    position: sticky;
                    top: 0;
                    z-index: 2;
                }

                .custom-product-table tbody tr {
                    transition: background-color 0.2s ease;
                    cursor: pointer;
                }

                    .custom-product-table tbody tr:hover {
                        background-color: #f1f5f4 !important;
                    }

                    .custom-product-table tbody tr.table-active {
                        background-color: #e6f2f0 !important;
                    }

                .custom-product-table tbody td {
                    padding: 14px 16px;
                    border-bottom: 1px solid #f1f3f5;
                    vertical-align: middle;
                }

            /* Soft Pill Badges */
            .badge-pill-custom {
                font-size: 0.725rem;
                font-weight: 600;
                padding: 0.35em 0.8em;
                border-radius: 50rem;
                letter-spacing: 0.3px;
                display: inline-block;
            }

            .badge-available {
                background-color: #e6f4ea;
                color: #137333;
            }

            .badge-outofstock {
                background-color: #fce8e6;
                color: #c5221f;
            }

            .badge-pending {
                background-color: #fef7e0;
                color: #b06000;
            }
    .badge-lowstock {
        background-color: #fff4e5;
        color: #b45f00;
    }

    .badge-pendingdelivery {
        background-color: #f2f2f2;
        color: #6c757d;
    }

    .badge-unavailable {
        background-color: #edf0f2;
        color: #5f6870;
    }

    #reorderModal {
        position: fixed;
        inset: 0;
        z-index: 1085;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(20, 31, 29, 0.45);
    }

    #reorderModal.d-none {
        display: none !important;
    }

    .reorder-modal-card {
        width: min(460px, 100%);
    }
    

</style>

@await Html.PartialAsync("SelectedItemView")
@await Html.PartialAsync("AddProductView")

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
    let originalData = {};
    const editableInputs = '#detailProductName, #detailBrand, #detailPrice, #detailDescription, #detailReorderLevel';

    function setDuplicateNameError(inputSelector, errorSelector, show) {
        $(inputSelector).toggleClass('is-invalid', show);
        $(errorSelector).toggleClass('d-none', !show);
    }

    $('#detailProductName').on('input', function() {
        setDuplicateNameError('#detailProductName', '#detailProductNameError', false);
    });

    $('#createProductName').on('input', function() {
        setDuplicateNameError('#createProductName', '#createProductNameError', false);
    });

    function renderStatusBadge(status) {
        const map = {
            'Available': 'badge-pill-custom badge-available',
            'Low Stock': 'badge-pill-custom badge-lowstock',
            'Out of Stock': 'badge-pill-custom badge-outofstock',
            'Unavailable': 'badge-pill-custom badge-unavailable'
        };
        const cls = map[status] || 'badge-pill-custom badge-outofstock';
        return `<span class="${cls}"><i class="bi bi-dot me-1"></i>${status}</span>`;
    }

    function buildProductRow(item) {
        const brand = item.product_brand || '-';
        const price = parseFloat(item.product_price).toFixed(2);
        return `
            <tr class="product-row" data-id="${item.product_ID}" data-reorder="${item.reorder_level}" data-qty="${item.product_quantity}" data-status="${item.product_status}">
                <td class="fw-bold text-dark ps-3">${item.formatted_code}</td>
                <td class="text-secondary fw-medium">${item.category_name}</td>
                <td class="text-secondary">${brand}</td>
                <td class="text-secondary fw-medium">${item.product_name || ''}</td>
                <td class="text-center fw-semibold text-dark">${item.product_quantity}</td>
                <td class="fw-semibold text-dark text-end">₱${price}</td>
                <td class="text-center text-muted">${item.reorder_level}</td>
                <td class="text-center pe-3">${renderStatusBadge(item.product_status)}</td>
                <td class="text-center pe-3">${buildReorderAction(item)}</td>
            </tr>`;
    }

    function buildReorderAction(item) {
        if (item.has_pending_reorder) {
            return `<a href="/Home/DeliveryManagement?tab=pending" class="btn btn-sm btn-light border text-warning-emphasis">
                        <i class="bi bi-hourglass-split me-1"></i>Pending Order
                    </a>`;
        }

        if (item.product_status !== 'Low Stock' && item.product_status !== 'Out of Stock') {
            return '<span class="text-muted fs-8">—</span>';
        }

        const currentQty = parseInt(item.product_quantity) || 0;
        const reorderLevel = parseInt(item.reorder_level) || 0;
        const suggested = Math.max(1, (reorderLevel * 2) - currentQty);
        return `<button type="button" class="btn btn-sm btn-outline-teal btn-reorder-product"
                    data-id="${item.product_ID}" data-code="${item.formatted_code}"
                    data-name="${item.product_name || ''}" data-qty="${currentQty}"
                    data-level="${reorderLevel}" data-suggested="${suggested}">
                    <i class="bi bi-arrow-repeat me-1"></i>Reorder
                </button>`;
    }

    function populateSelectedItem(data) {
        $('#detailTitle').text(data.formatted_code);
        $('#detailSubtitle').text(data.product_name || data.product_description || '');
        $('#detailProductID').val(data.formatted_code);
        $('#detailProductName').val(data.product_name || '');
        $('#detailBrand').val(data.product_brand || '');
        $('#detailCategory').val(data.category_name);
        $('#detailQuantity').val(data.product_quantity);
        $('#detailPrice').val(parseFloat(data.product_price).toFixed(2));
        $('#detailDescription').val(data.product_description || '');
        $('#detailReorderLevel').val(data.reorder_level);

        originalData = {
            name: data.product_name || '',
            brand: data.product_brand || '',
            price: parseFloat(data.product_price).toFixed(2),
            description: data.product_description || '',
            reorderLevel: data.reorder_level
        };

        $('#modalHealthBadge').html(renderStatusBadge(data.product_status));

        let serialRows = '';
        if (data.serials && data.serials.length > 0) {
            $.each(data.serials, function(i, serial) {
                serialRows += `<tr><td>${serial.serial_No}</td><td>${serial.batch_ID || '-'}</td></tr>`;
            });
        } else {
            serialRows = '<tr><td colspan="2" class="text-center text-muted py-3">No serial numbers found.</td></tr>';
        }
        $('#serialQueueTable').html(serialRows);

        $('#tab-overview')[0] && bootstrap.Tab.getOrCreateInstance($('#tab-overview')[0]).show();
        $('#selectedProductOverlay').removeClass('d-none');
    }

    function loadProductDetails(productId) {
        $.ajax({
            url: '/Home/GetDetails',
            type: 'GET',
            data: { id: productId },
            success: function(data) {
                if (data.success) {
                    populateSelectedItem(data);
                } else {
                    showToast(data.message || 'Failed to retrieve item details.', 'error');
                }
            },
            error: function() {
                showToast('Failed to retrieve item details.', 'error');
            }
        });
    }

        

   

        function closeSelectedPanel() {
            $('#selectedProductOverlay').addClass('d-none');
            $('.product-row').removeClass('table-active');
            disableLayoutBlur();
        }
        $('#btnCloseSelectedPanel').click(closeSelectedPanel);
        // 3. ROW CLICK: OPENS PANEL, BLURS LAYOUT & LOADS DETAILS
        $(document).on('click', '.product-row', function(e) {
            if ($(e.target).closest('.btn-reorder-product, a, button').length) return;
            $('.product-row').removeClass('table-active');
            $(this).addClass('table-active');

            $('#selectedProductOverlay').removeClass('d-none');
            enableLayoutBlur();

            loadProductDetails($(this).data('id'));
        });

        $(document).on('click', '.btn-reorder-product', function(e) {
            e.stopPropagation();
            const $button = $(this);
            $('#reorderProductId').val($button.data('id'));
            $('#reorderProductCode').text($button.data('code'));
            $('#reorderProductName').text($button.data('name'));
            $('#reorderCurrentQty').text($button.data('qty'));
            $('#reorderLevel').text($button.data('level'));
            $('#reorderQuantity').val($button.data('suggested'));
            $('#reorderError').addClass('d-none').text('');
            $('#reorderModal').removeClass('d-none');
        });

        $('.btn-close-reorder').on('click', function() {
            $('#reorderModal').addClass('d-none');
        });

        $('#reorderQuantity').on('input', function() {
            $('#reorderError').addClass('d-none').text('');
        });

        $('#btnConfirmReorder').on('click', function() {
            const productId = parseInt($('#reorderProductId').val());
            const quantity = parseInt($('#reorderQuantity').val());
            if (!quantity || quantity < 1) {
                $('#reorderError').removeClass('d-none').text('Enter a valid reorder quantity.');
                return;
            }

            const $button = $(this);
            $button.prop('disabled', true).find('.spinner-border').removeClass('d-none');
            $.ajax({
                url: '/Home/CreateReorder',
                type: 'POST',
                data: { product_ID: productId, quantity: quantity },
                success: function(res) {
                    if (res.success) {
                        $('#reorderModal').addClass('d-none');
                        const $actionCell = $(`.product-row[data-id="${productId}"] td:last`);
                        $actionCell.html(`<a href="/Home/DeliveryManagement?tab=pending" class="btn btn-sm btn-light border text-warning-emphasis">
                            <i class="bi bi-hourglass-split me-1"></i>Pending Order
                        </a>`);
                        showToast('Reorder submitted. It is now pending in Delivery Management.');
                    } else {
                        $('#reorderError').removeClass('d-none').text(res.message || 'Unable to create reorder.');
                        showToast(res.message || 'Unable to create reorder.', 'warning');
                    }
                },
                error: function() {
                    $('#reorderError').removeClass('d-none').text('Server error while creating reorder.');
                },
                complete: function() {
                    $button.prop('disabled', false).find('.spinner-border').addClass('d-none');
                }
            });
        });

        // 4. CANCEL EDIT MODE HANDLER
        $('#btnCancelEdit, #btnCloseSelectedPanel').click(function() {
            if (typeof originalData !== 'undefined' && originalData) {
                $('#detailProductName').val(originalData.name);
                $('#detailBrand').val(originalData.brand);
                $('#detailPrice').val(originalData.price);
                $('#detailDescription').val(originalData.description);
                $('#detailReorderLevel').val(originalData.reorderLevel);
            }
            setDuplicateNameError('#detailProductName', '#detailProductNameError', false);
            closeSelectedPanel();
        });

        // 5. ESCAPE KEY CLOSES PANEL & REMOVES BLUR
        $(document).on('keydown', function(e) {
            if (e.key === "Escape") {
                if (!$('#addProductOverlay').hasClass('d-none')) {
                    $('.btn-close-overlay').trigger('click');
                }
                if (!$('#selectedProductOverlay').hasClass('d-none')) {
                    closeSelectedPanel();
                }
            }
        });

    // 5. SAVE EDITED PRODUCT DETAILS FROM PANEL
    $('#btnSaveDetail').click(function() {
        const activeRow = $('.product-row.table-active');
        const productId = activeRow.data('id');
        if (!productId) return;

        const payload = {
            product_ID: productId,
            product_name: $('#detailProductName').val(),
            product_brand: $('#detailBrand').val(),
            product_price: parseFloat($('#detailPrice').val()) || 0,
            product_description: $('#detailDescription').val(),
            product_status: 'Available',
            reorder_level: parseInt($('#detailReorderLevel').val()) || 0
        };

        $('#btnSaveDetail').prop('disabled', true);
        $('#saveSpinner').removeClass('d-none');

        $.ajax({
            url: '/Home/UpdateProductDetails',
            type: 'POST',
            data: payload,
            success: function(res) {
                if (res.success) {
                    setDuplicateNameError('#detailProductName', '#detailProductNameError', false);
                    closeSelectedPanel();
                    location.reload();
                } else if (res.message === 'Item Already Exists') {
                    setDuplicateNameError('#detailProductName', '#detailProductNameError', true);
                    showToast('Item Already Exists', 'warning');
                } else {
                    showToast(res.message || 'Failed to update product.', 'error');
                }
            },
            error: function() { showToast('Server error occurred while saving.', 'error'); },
            complete: function() {
                $('#btnSaveDetail').prop('disabled', false);
                $('#saveSpinner').addClass('d-none');
            }
        });
    });

    // 6. DELETE PRODUCT HANDLER
    $('#btnDeleteProduct').click(function() {
        const activeRow = $('.product-row.table-active');
        const productId = activeRow.data('id');
        if (!productId) return;

        if (confirm('Are you sure you want to delete this product?')) {
            $.ajax({
                url: '/Home/DeleteProduct',
                type: 'POST',
                data: { id: productId },
                success: function(res) {
                    if (res.success) {
                        closeSelectedPanel();
                        location.reload();
                    } else {
                        showToast(res.message || 'Failed to delete product.', 'error');
                    }
                },
                error: function() { showToast('Server error occurred while deleting.', 'error'); }
            });
        }
    });

    // 7. FILTER BADGES & SEARCH COMBINED
    $('.filter-badge').click(function() {
        $('.filter-badge').removeClass('active');
        $(this).addClass('active');
        applyFilters();
    });

    $('#filterCategory, #filterStatus').change(function() {
        applyFilters();
    });

    function applyFilters() {
        const badgeFilter = $('.filter-badge.active').data('filter');
        const categoryFilter = $('#filterCategory').val().toLowerCase();
        const statusFilter = $('#filterStatus').val().toLowerCase();

        $('#productTable tbody tr').each(function() {
            const row = $(this);
            if (!row.hasClass('product-row')) return;

            const status = (row.data('status') || '').toString().toLowerCase();
            const catText = row.find('td').eq(1).text().toLowerCase();

            let showByBadge = true;
            if (badgeFilter === 'lowstock') showByBadge = status === 'low stock';
            else if (badgeFilter === 'outofstock') showByBadge = status === 'out of stock';
            else if (badgeFilter === 'unavailable') showByBadge = status === 'unavailable';

            const showByCat = !categoryFilter || catText.includes(categoryFilter);
            const showByStatus = !statusFilter || status === statusFilter;

            row.toggle(showByBadge && showByCat && showByStatus);
        });
    }

    // 8. REAL-TIME SEARCH
    let searchTimer;
    $('#searchInput').on('keyup search input', function() {
        clearTimeout(searchTimer);
        var searchQuery = $(this).val();

        searchTimer = setTimeout(function() {
            $.ajax({
                url: '/Home/SearchProducts',
                type: 'GET',
                data: { query: searchQuery },
                success: function(response) {
                    if (response.success) {
                        var $tbody = $('#productTable tbody');
                        $tbody.empty();

                        if (response.data && response.data.length > 0) {
                            $.each(response.data, function(i, item) {
                                $tbody.append(buildProductRow(item));
                            });
                            applyFilters();
                        } else {
                            $tbody.html(`
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-3">
                                        No products matching "<strong>${searchQuery}</strong>"
                                    </td>
                                </tr>`);
                        }
                    }
                }
            });
        }, 300);
    });
        // Open Overlay and apply 12px blur
        $('#btnOpenAddProduct').on('click', function() {
            $('#addProductOverlay').removeClass('d-none');
            enableLayoutBlur();
        });

        function closeAddProductOverlay() {
            $('#addProductOverlay').addClass('d-none');
            disableLayoutBlur();
            if ($('#createProductForm').length) {
                $('#createProductForm')[0].reset();
            }
            $('#generatedCode').val('');
            setDuplicateNameError('#createProductName', '#createProductNameError', false);
        }

        // Hide Overlay, reset form, and remove blur
        $('.btn-close-overlay').on('click', function() {
            closeAddProductOverlay();
        });
        
        // Category Code Generation
        $(document).on('change', '#categorySelect', function() {
            var categoryId = $(this).val();
            $.ajax({
                url: '/Home/GetNextCategoryCode',
                type: 'GET',
                data: { categoryId: categoryId },
                success: function(response) {
                    if (response.success) {
                        $('#generatedCode').val(response.formattedCode);
                    }
                }
            });
        });

        // Submit AJAX Form
        $(document).on('submit', '#createProductForm', function(e) {
            e.preventDefault();
            var $btn = $('#btnSaveProduct');
            var $spinner = $btn.find('.spinner-border');

            $btn.prop('disabled', true);
            $spinner.removeClass('d-none');

            $.ajax({
                url: '/Home/Create',
                type: 'POST',
                data: $(this).serialize(),
                success: function(response) {
                    if (response.success) {
                        $('#productTable tbody').append(buildProductRow(response.data));
                        $('#cntAll').text($('#productTable tbody tr.product-row').length);
                        if (response.data.product_status === 'Unavailable') {
                            $('#cntUnavailable').text((parseInt($('#cntUnavailable').text()) || 0) + 1);
                        }
                        $('#createProductForm')[0].reset();
                        $('#generatedCode').val('');
                        setDuplicateNameError('#createProductName', '#createProductNameError', false);
                        showToast('New item created.');
                    } else if (response.message === 'Item Already Exists') {
                        setDuplicateNameError('#createProductName', '#createProductNameError', true);
                        showToast('Item Already Exists', 'warning');
                    } else {
                        // Show detailed validation errors when available to help
                        // the user correct missing/invalid fields.
                        var msg = response.errors && response.errors.length ? response.errors.join('\n') : (response.message || 'Error saving product.');
                        showToast(msg, 'error');
                    }
                },
                error: function() {
                    showToast('Server error occurred.', 'error');
                },
                complete: function() {
                    $btn.prop('disabled', false);
                    $spinner.addClass('d-none');
                }
            });
        });

        // Product drawers close on an outside click.
        $(document).on('mousedown', function(e) {
            if (!$('#addProductOverlay').hasClass('d-none') &&
                !$(e.target).closest('#addProductOverlay, #btnOpenAddProduct').length) {
                closeAddProductOverlay();
            }

            if (!$('#selectedProductOverlay').hasClass('d-none') &&
                !$(e.target).closest('#selectedProductOverlay, .product-row, #btnTriggerQuickEdit').length) {
                closeSelectedPanel();
            }
        });

        const requestedStatus = new URLSearchParams(window.location.search).get('status');
        if (requestedStatus) {
            $('#filterStatus').val(requestedStatus);
            $('.filter-badge').removeClass('active');
            applyFilters();
        }
});
</script>
