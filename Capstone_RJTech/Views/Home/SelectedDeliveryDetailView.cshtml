@model Capstone_RJTech.Models.Delivery

@{
    var deliveryCode = Model?.batch_ID?.Replace("BATCH-", "DEL-") ?? $"DEL-{Model?.date_delivered:yyyyMMdd}-000";
}



<!-- RIGHT-SIDE EXPANDED OVERLAY: DELIVERY DETAILS -->
<div class="d-flex flex-column h-100">
    <!-- PANEL HEADER -->
    <div class="panel-header d-flex justify-content-between align-items-center">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0 fw-bold text-dark">Delivery Details</h5>
            </div>
            <small class="text-muted">Read-only Receipt Summary</small>
        </div>
        <button type="button" id="btn-close-drawer" class="btn btn-sm btn-light border rounded-circle p-1 btn-close-drawer" aria-label="Close" style="width:32px; height:32px;">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <!-- PANEL BODY -->
    <div class="panel-body">

        <!-- Step 1: Master Record Card (Header Details) -->
        <div class="card border-0 shadow-sm rounded-3 mb-3">
            <div class="card-body p-3">
                <div class="section-title mb-3"><i class="bi bi-card-heading me-1"></i> Delivery Header</div>
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="floating-group mb-2">
                            <label>Delivery ID</label>
                            <input type="text" class="form-control bg-light" value="@deliveryCode" readonly>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="floating-group mb-2">
                            <label>Batch ID</label>
                            <input type="text" class="form-control bg-light" value="@(Model?.batch_ID ?? "N/A")" readonly>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="floating-group mb-0">
                            <label>Date Delivered</label>
                            <input type="text" class="form-control bg-light" value="@(Model != null ? Model.date_delivered.ToString("MMM dd, yyyy hh:mm tt") : "N/A")" readonly>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="floating-group mb-0">
                            <label>Received By</label>
                            <input type="text" class="form-control bg-light text-teal fw-semibold" value="@(Model?.received_by ?? "N/A")" readonly>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 2: Delivered Products & Serials Card List -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-3">
                <div class="section-title mb-3"><i class="bi bi-box-seam me-1"></i> Delivered Products & Serials</div>

                @if (Model?.DeliveryDetails != null && Model.DeliveryDetails.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var detail in Model.DeliveryDetails)
                        {
                            var displayProductCode = !string.IsNullOrEmpty(detail.Product?.formatted_code)
                                ? detail.Product.formatted_code
                                : $"P-{detail.product_ID:D3}";

                            var productBrand = detail.Product?.product_brand;
                            var productDesc = detail.Product?.product_description;

                            <div class="border rounded-3 p-3 bg-white shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                    <div>
                                        <div class="fw-bold text-dark fs-7">
                                            <i class="bi bi-tag-fill me-1 text-teal"></i> Product: @displayProductCode
                                        </div>
                                        @if (!string.IsNullOrEmpty(productBrand) || !string.IsNullOrEmpty(productDesc))
                                        {
                                            <div class="text-muted fs-8">
                                                @productBrand @(string.IsNullOrEmpty(productDesc) ? "" : $"- {productDesc}")
                                            </div>
                                        }
                                    </div>
                                    <span class="badge bg-dark rounded-pill px-2 py-1">Qty: @detail.product_quantity</span>
                                </div>

                                <!-- Registered Serials -->
                                <div class="mt-2">
                                    <span class="text-muted fs-8 fw-semibold d-block mb-1">
                                        <i class="bi bi-barcode me-1"></i> Registered Serials:
                                    </span>
                                    @if (detail.DelSerials != null && detail.DelSerials.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var serial in detail.DelSerials)
                                            {
                                                <span class="serial-tag">@serial.serial_No</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-8 italic">No serial numbers attached to this line item.</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-2 d-block text-secondary mb-1"></i>
                        <p class="mb-0 fs-8">No item details found for this delivery receipt.</p>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- PANEL FOOTER -->
    <div class="panel-footer p-3 d-flex justify-content-end">
        <button type="button" id="btn-close-drawer" class="btn btn-outline-secondary btn-sm px-4 btn-close-drawer">Close</button>
    </div>
</div>


