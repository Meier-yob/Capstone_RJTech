@{
ViewData["Title"] = "Delivery Management";
    ViewData["Description"] = "Tracks and validates stock arrivals with serial numbers for accurate inventory intake.";
Layout = "_Layout";
}

<div class="container-fluid px-4 py-3 bg-light">

<!-- Top Action Bar -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="h4 mb-0 text-dark fw-bold">Deliveries</h3>

    <div class="d-flex align-items-center gap-2">
        <button type="button"
                class="btn btn-teal btn-sm px-3 fw-semibold text-white d-flex align-items-center gap-1"
                id="btnOpenCreateDelivery">
            <i class="bi bi-plus-lg me-1"></i> New Delivery
        </button>
    </div>
</div>


<!-- Search Card -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-3">

        <div class="row g-3 align-items-center">

            <!-- Search Input -->
            <div class="col-md-6">
                <div class="position-relative">
                    <label for="txtReceiptSearch"
                           class="form-label text-muted fs-8 mb-0 d-block">
                        Search deliveries
                    </label>

                    <div class="input-group input-group-sm border-bottom">
                        <span class="input-group-text bg-transparent border-0 ps-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="txtReceiptSearch"
                               class="form-control border-0 bg-transparent shadow-none"
                               placeholder="Delivery ID, Batch ID, or Receiver...">
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>


<!-- Delivery Summary Pills -->
<div class="d-flex gap-2 mb-3">

    <button type="button"
            class="btn btn-sm btn-light-pill border rounded-pill px-3 active"
            id="btnAllDeliveries">
        All Deliveries:
        <span class="fw-bold ms-1" id="cntDeliveries">0</span>
    </button>

</div>

<!-- Delivery Table -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0 custom-delivery-table" id="tblReceipts">
                <thead>
                    <tr>
                        <th class="fw-semibold ps-3">
                            Delivery ID
                            <i class="bi bi-caret-down-fill ms-1 fs-8"></i>
                        </th>
                        <th class="fw-semibold">
                            Batch ID
                        </th>
                        <th class="fw-semibold">
                            Date Received
                        </th>
                        <th class="fw-semibold">
                            Received By
                        </th>
                        <th class="fw-semibold text-center">
                            Items
                        </th>
                        <th class="fw-semibold text-center pe-3">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody id="deliverySummaryBody">
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No receipts found.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<style>
:root { 
    --teal-color: #0b6b5d; 
    --teal-hover: #085247; 
}

/* Backgrounds & Colors */
.bg-light-gray { 
    background-color: #f7f9fa; 
} 

.text-teal { 
    color: var(--teal-color) !important; 
} 

.border-teal { 
    border-color: var(--teal-color) !important; 
} 

/* Teal Buttons */ 
.btn-teal { 
    background-color: var(--teal-color); 
    border-color: var(--teal-color); 
} 

.btn-teal:hover { 
    background-color: var(--teal-hover); 
    border-color: var(--teal-hover); 
} 

.btn-outline-teal { 
    color: var(--teal-color); 
    border-color: var(--teal-color); 
} 

.btn-outline-teal:hover { 
    background-color: var(--teal-color); 
    color: #ffffff !important; 
} 

/* Filter Pills */ 
.btn-light-pill { 
    background-color: #e9ecef; 
    color: #495057; 
    font-size: 0.75rem; 
} 

.btn-light-pill.active { 
    background-color: #dee2e6; 
    color: #212529; 
} 

/* Font Sizes */ 
.fs-7 { 
    font-size: 0.85rem; 
} 

.fs-8 { 
    font-size: 0.75rem; 
} 

/* ========================================== 
   DELIVERY TABLE 
========================================== */ 
.custom-delivery-table { 
    border-collapse: separate; 
    border-spacing: 0; 
    width: 100%; 
    font-size: 0.875rem; 
} 

.custom-delivery-table thead th { 
    background-color: #f8f9fa; 
    color: #495057; 
    font-size: 0.75rem; 
    text-transform: uppercase; 
    letter-spacing: 0.5px; 
    padding: 12px 16px; 
    border-bottom: 1px solid #e9ecef; 
    white-space: nowrap; 
} 

.custom-delivery-table tbody tr { 
    transition: background-color 0.2s ease; 
    cursor: pointer; 
} 

.custom-delivery-table tbody tr:hover { 
    background-color: #f1f5f4 !important; 
} 

.custom-delivery-table tbody tr.table-active { 
    background-color: #e6f2f0 !important; 
} 

.custom-delivery-table tbody td { 
    padding: 14px 16px; 
    border-bottom: 1px solid #f1f3f5; 
    vertical-align: middle; 
}

/* Delivery ID */ 
.delivery-id { 
    font-weight: 700; 
    color: #212529; 
} 

/* Batch Badge */ 
.batch-badge { 
    display: inline-block; 
    padding: 0.35em 0.8em; 
    border-radius: 50rem; 
    background-color: #f2f2f2; 
    color: #495057; 
    font-size: 0.725rem; 
    font-weight: 600; 
    letter-spacing: 0.3px; 
} 

/* Item Count */
.items-count { 
    display: inline-flex; 
    align-items: center; 
    justify-content: center; 
    min-width: 34px; 
    height: 26px; 
    padding: 0 10px; 
    border-radius: 50rem; 
    background-color: #e6f2f0; 
    color: var(--teal-color); 
    font-size: 0.725rem; 
    font-weight: 600; 
} 

/* Delete Button */ 
.btn-delete-receipt { 
    font-size: 0.75rem; 
    font-weight: 600; 
    border-radius: 0.4rem; 
}

/* Search */ 
#txtReceiptSearch { 
    font-size: 0.85rem; 
    width:100%;
} 

#txtReceiptSearch:focus { 
    box-shadow: none !important; 
    outline: none !important; 
} 

/* Empty / Loading State */ 
.custom-delivery-table tbody td[colspan] { 
    cursor: default; 
}
</style>
@await Html.PartialAsync("CreateDelivery")

<!-- AJAX injection target for selected delivery detail drawer (will be populated by SelectedDeliveryDetailView partial) -->
<div id="selectedDeliveryOverlay" class="d-none"></div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(function() {
        let receipts = [];
        let selectedProduct = null;
        let serialQueue = [];
        let deliveryItems = [];
        const STORAGE_KEY = 'delivery_intake_draft';

        // Helper function for safe HTML string rendering
        function escapeHtml(str) {
            return String(str || '').replace(/[&<>"']/g, function(m) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
            });
        }

        // ==========================================
        // 1. DATA LOADING & INITIALIZATION
        // ==========================================
        function initPage() {
            loadReceipts();
            refreshDeliveryIdentifiers();
            restoreDraftFromStorage();
        }

        function loadReceipts() {
            $.ajax({
                url: '/Home/GetDeliveries',
                type: 'GET',
                success: function(res) {
                    if (!res || !res.success) return;
                    receipts = res.data || [];
                    renderReceiptsTable(receipts);
                },
                error: function() {
                    console.error('Failed to load delivery receipts.');
                }
            });
        }

        function renderReceiptsTable(deliveries) {
            const $tbody = $('#deliverySummaryBody');
            $tbody.empty();

            if (!deliveries || deliveries.length === 0) {
                $tbody.append('<tr><td colspan="6" class="text-center text-muted py-4">No receipts found.</td></tr>');
                $('#cntDeliveries').text(0);
                return;
            }

            $('#cntDeliveries').text(deliveries.length);

            // Helper function to format delivery codes and batch IDs
            function formatDeliveryCode(rawCode, rawId, prefix = 'DEL') {
                if (rawCode && rawCode !== 'N/A') return rawCode;
                if (!rawId || rawId === 'N/A') return 'N/A';

                // If rawId is already formatted
                if (typeof rawId === 'string' && rawId.includes('-')) return rawId;

                // Fallback: formats numeric IDs to 3-digit padded codes
                const paddedNum = String(rawId).padStart(3, '0');
                return `${prefix}-${paddedNum}`;
            }

            deliveries.forEach((item, index) => {
                const rawDeliveryId = item.delivery_ID || item.deliveryId || item.Delivery_ID;
                const rawDeliveryCode = item.delivery_code || item.deliveryCode || item.Delivery_Code;
                const rawBatchId = item.batch_ID || item.batchId || item.Batch_ID;

                const displayDeliveryId = formatDeliveryCode(rawDeliveryCode, rawDeliveryId, 'DEL');
                const displayBatchId = formatDeliveryCode(null, rawBatchId, 'BATCH');

                let dateVal = item.date_delivered || item.dateReceived || item.Date_Delivered || '';
                if (dateVal) {
                    const parsedDate = new Date(dateVal);
                    if (!isNaN(parsedDate.getTime())) {
                        dateVal = parsedDate.toLocaleString();
                    }
                }

                const receivedBy = item.received_by || item.receivedBy || item.Received_By || '';
                const itemsCount = item.itemsCount || item.items_count || (item.items ? item.items.length : 1);

                const rowHtml = `
                                <tr data-id="${escapeHtml(rawDeliveryId)}">
                                    <td class="ps-3 fw-bold">${escapeHtml(displayDeliveryId)}</td>
                                    <td><span class="badge bg-light text-dark border">${escapeHtml(displayBatchId)}</span></td>
                                    <td>${escapeHtml(dateVal)}</td>
                                    <td>${escapeHtml(receivedBy)}</td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill bg-light text-teal border px-3">${itemsCount}</span>
                                    </td>
                                    <td class="text-center pe-3">
                                        <button type="button" class="btn btn-sm btn-danger btn-delete-receipt" data-id="${escapeHtml(rawDeliveryId)}" data-index="${index}">
                                            <i class="bi bi-trash-fill me-1"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            `;
                $tbody.append(rowHtml);
            });
        }

        function refreshDeliveryIdentifiers() {
            fetch('/Home/GetNextDeliveryInfo')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const deliveryIdInput = document.getElementById('delivery_code') || document.getElementById('delivery_ID') || document.getElementById('txtDeliveryID');
                        const batchIdInput = document.getElementById('batch_ID') || document.getElementById('txtBatchID');

                        if (deliveryIdInput) deliveryIdInput.value = data.delivery_ID;
                        if (batchIdInput) batchIdInput.value = data.batch_ID;
                    }
                })
                .catch(error => console.error('Error refreshing delivery IDs:', error));
        }

        // ==========================================
        // 2. DRAFT PERSISTENCE (SESSION STORAGE)
        // ==========================================
        function saveDraftToStorage() {
            const draftData = {
                dateDelivered: $('#dtDateDelivered').val(),
                receivedBy: $('#txtReceivedBy').val(),
                selectedProduct: selectedProduct,
                serialQueue: serialQueue,
                deliveryItems: deliveryItems
            };
            sessionStorage.setItem(STORAGE_KEY, JSON.stringify(draftData));
        }

        function restoreDraftFromStorage() {
            const saved = sessionStorage.getItem(STORAGE_KEY);
            if (!saved) return;

            try {
                const draft = JSON.parse(saved);
                if (draft.dateDelivered) $('#dtDateDelivered').val(draft.dateDelivered);
                if (draft.receivedBy) $('#txtReceivedBy').val(draft.receivedBy);

                if (draft.selectedProduct) {
                    selectedProduct = draft.selectedProduct;
                    $('#lblProductCode').text(selectedProduct.formatted_code || selectedProduct.product_code);
                    $('#lblBrandDesc').text(`${selectedProduct.product_brand || ''} - ${selectedProduct.product_description || ''}`);
                    $('#lblCategory').text(selectedProduct.category_name || '');
                    $('#lblCurrentQty').text(selectedProduct.current_quantity || selectedProduct.product_quantity || 0);
                    $('#productContextPanel').removeClass('d-none');
                }

                if (Array.isArray(draft.deliveryItems)) {
                    deliveryItems = draft.deliveryItems;
                    renderSummaryTable();
                }
            } catch (e) {
                console.error("Failed to parse saved delivery draft.", e);
            }
        }

        function clearDraftStorage() {
            sessionStorage.removeItem(STORAGE_KEY);
        }

        function resetProductContext() {
            selectedProduct = null;
            $('#productContextPanel').addClass('d-none');
            $('#txtQtyReceived').val('').trigger('input');
            saveDraftToStorage();
        }

        function resetLineItemInputs() {
            selectedProduct = null;
            $('#txtSearchProductID').val('');
            $('#txtQtyReceived').val('');
            $('#productContextPanel').addClass('d-none');
            $('#serialInputsContainer').html('<p class="text-muted fs-8 mb-0 italic">Specify product quantity above to generate serial number fields.</p>');
        }

        // ==========================================
        // 3. MAIN TABLE EVENTS & OVERLAY NAVIGATION
        // ==========================================
        function viewDeliveryDetails(deliveryId) {
            var $overlay = $('#selectedDeliveryOverlay');
            if ($overlay.length === 0) {
                $overlay = $('<div id="selectedDeliveryOverlay"></div>').appendTo('body');
            } else {
                $overlay.appendTo('body');
            }
            if (typeof enableLayoutBlur === 'function') enableLayoutBlur();
            $overlay.removeClass('d-none').html(`
                            <div class="d-flex justify-content-center align-items-center h-100">
                                <div class="spinner-border text-teal" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        `);

            $.ajax({
                url: '/Home/SelectedDeliveryDetailView',
                type: 'GET',
                data: { deliveryId: deliveryId },
                success: function(response) {
                    $overlay.html(response);
                    setTimeout(function() {
                        var $drawer = $('#deliveryDetailDrawer');
                        if ($drawer.length && !$drawer.hasClass('active')) {
                            $drawer.addClass('active');
                        }
                    }, 20);
                },
                error: function(xhr) {
                    var msg = 'Failed to load delivery details.';
                    try {
                        if (xhr && xhr.responseText) msg = xhr.responseText;
                    } catch (e) { }

                    $overlay.html(`
                                    <div class="p-3 text-center text-danger">${escapeHtml(msg)}<br/>
                                        <button class="btn btn-sm btn-secondary mt-2 btn-close-overlay">Close</button>
                                    </div>
                                `);
                }
            });
        }

        // Row click handler
        $(document).on('click', '#deliverySummaryBody tr, #tblReceipts tbody tr', function(e) {
            if ($(e.target).closest('.btn-delete-receipt').length > 0) return;
            const id = $(this).data('id');
            if (!id) return;
            viewDeliveryDetails(id);
        });

        // Delete Receipt Action
        $(document).on('click', '.btn-delete-receipt', function(e) {
            e.stopPropagation();
            const id = $(this).data('id');
            if (!id) return;

            if (!confirm('Delete this delivery receipt and rollback inventory?')) return;

            const $btn = $(this);
            $btn.prop('disabled', true);

            $.ajax({
                url: '/Home/DeleteDeliveryReceipt',
                type: 'POST',
                data: { delivery_ID: id },
                success: function(res) {
                    if (res.success) {
                        receipts = receipts.filter(r => r.delivery_ID != id);
                        renderReceiptsTable(receipts);
                        $('#selectedDeliveryOverlay').addClass('d-none').empty();
                        if (typeof disableLayoutBlur === 'function') disableLayoutBlur();
                        alert(res.message || 'Receipt deleted successfully.');
                    } else {
                        alert('Failed to delete: ' + (res.message || ''));
                        $btn.prop('disabled', false);
                    }
                },
                error: function() {
                    alert('Server error while deleting receipt.');
                    $btn.prop('disabled', false);
                }
            });
        });

        // Close Selected Delivery Drawer/Overlay
        $(document).on('click', '#btn-close-drawer, .btn-close-overlay', function() {
            $('#selectedDeliveryOverlay').addClass('d-none').empty();
            if (typeof disableLayoutBlur === 'function') disableLayoutBlur();
        });

        // Close Create Delivery Drawer/Overlay
        $(document).on('click', '#btnCloseDeliveryPanel, #btnCancelDeliveryPanel', function() {
            $('#createDeliveryOverlay').addClass('d-none');
            if (typeof disableLayoutBlur === 'function') disableLayoutBlur();
        });

        // Press ESC to close overlays
        $(document).on('keydown', function(e) {
            if (e.key === "Escape") {
                if (!$('#createDeliveryOverlay').hasClass('d-none')) {
                    $('#createDeliveryOverlay').addClass('d-none');
                    if (typeof disableLayoutBlur === 'function') disableLayoutBlur();
                }
                if (!$('#selectedDeliveryOverlay').hasClass('d-none')) {
                    $('#selectedDeliveryOverlay').addClass('d-none').empty();
                    if (typeof disableLayoutBlur === 'function') disableLayoutBlur();
                }
            }
        });

        // Drawer Toggles
        $(document).on('click', '#btnOpenCreateDelivery', function() {
            $('#createDeliveryOverlay').removeClass('d-none');
            if (typeof enableLayoutBlur === 'function') enableLayoutBlur();
        });

        // Search Filter
        $('#txtReceiptSearch').on('input', function() {
            const q = $(this).val().toLowerCase().trim();
            $('#deliverySummaryBody tr').each(function() {
                const txt = $(this).text().toLowerCase();
                $(this).toggle(txt.indexOf(q) !== -1);
            });
        });

        $('#dtDateDelivered, #txtReceivedBy').on('input change', function() {
            saveDraftToStorage();
        });

        // ==========================================
        // 4. LIVE PRODUCT SEARCH & SUGGESTIONS
        // ==========================================
        let suggestionTimer = null;
        $('#txtSearchProductID').on('input', function() {
            const q = $(this).val().trim();
            clearTimeout(suggestionTimer);

            if (!q || (selectedProduct && q !== selectedProduct.formatted_code)) {
                resetProductContext();
            }

            if (!q) {
                $('#productSuggestions').hide().empty();
                return;
            }

            suggestionTimer = setTimeout(function() {
                $.ajax({
                    url: '/Home/SearchProducts',
                    type: 'GET',
                    data: { query: q },
                    success: function(res) {
                        if (!res.success) return;
                        let items = res.data || [];

                        // FILTER: Exclude products already present in deliveryItems summary
                        items = items.filter(it => !deliveryItems.some(existing => existing.product_ID == it.product_ID));

                        const priority = { 'Pending Delivery': 1, 'Low Stock': 2, 'Out of Stock': 3 };
                        items.sort((a, b) => (priority[a.product_status] || 99) - (priority[b.product_status] || 99));

                        const $list = $('#productSuggestions');
                        $list.empty().css({
                            'position': 'absolute',
                            'top': '100%',
                            'left': '0',
                            'right': '0',
                            'z-index': '1060',
                            'background-color': '#ffffff',
                            'box-shadow': '0 8px 16px rgba(0,0,0,0.15)',
                            'max-height': '220px',
                            'overflow-y': 'auto'
                        });

                        items.slice(0, 10).forEach(it => {
                            const badgeClass = it.product_status === 'Available' ? 'badge bg-success' :
                                (it.product_status === 'Low Stock' ? 'badge bg-warning text-dark' :
                                    (it.product_status === 'Out of Stock' ? 'badge bg-danger' : 'badge bg-secondary'));

                            const $el = $(`
                                            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-2" data-id="${it.product_ID}">
                                                <div>
                                                    <div class="fw-bold fs-7">${escapeHtml(it.formatted_code)} - ${escapeHtml(it.product_brand)}</div>
                                                    <div class="text-muted fs-8">${escapeHtml(it.category_name)} · ${escapeHtml(it.product_description || '')}</div>
                                                </div>
                                                <div><span class="${badgeClass}">${escapeHtml(it.product_status)}</span></div>
                                            </button>
                                        `);

                            $el.on('click', function() {
                                $('#txtSearchProductID').val(it.formatted_code);
                                $('#productSuggestions').hide().empty();

                                selectedProduct = it;
                                $('#lblProductCode').text(it.formatted_code);
                                $('#lblBrandDesc').text(`${it.product_brand} - ${it.product_description}`);
                                $('#lblCategory').text(it.category_name);
                                $('#lblCurrentQty').text(it.product_quantity || 0);
                                $('#productContextPanel').removeClass('d-none');

                                $('#txtQtyReceived').trigger('input');
                                saveDraftToStorage();
                            });
                            $list.append($el);
                        });

                        if (items.length > 0) $list.show(); else $list.hide();
                    }
                });
            }, 250);
        });

        $(document).on('click', function(e) {
            if (!$(e.target).closest('#txtSearchProductID, #productSuggestions').length) {
                $('#productSuggestions').hide();
            }
        });

        // ==========================================
        // 5. DYNAMIC SERIAL GENERATION & VALIDATION
        // ==========================================
        $('#txtQtyReceived').on('input', function() {
            const qty = parseInt($(this).val()) || 0;
            const $container = $('#serialInputsContainer');
            $container.empty();

            if (!selectedProduct) {
                $container.html('<p class="text-muted fs-8 mb-0 italic">Please select a product first above.</p>');
                return;
            }

            if (qty <= 0) {
                $container.html('<p class="text-muted fs-8 mb-0 italic">Specify product quantity above to generate serial number fields.</p>');
                return;
            }

            for (let i = 0; i < qty; i++) {
                const $row = $(`
                                <div class="input-group input-group-sm mb-2">
                                    <span class="input-group-text">${escapeHtml(selectedProduct.formatted_code)}</span>
                                    <input type="text" class="form-control serial-input" data-index="${i}" placeholder="Serial #${i + 1}">
                                </div>
                            `);
                $container.append($row);
            }

            $container.find('.serial-input').on('input', function() {
                const vals = $container.find('.serial-input').map(function() { return $(this).val().trim(); }).get().filter(v => v);
                const dupes = vals.filter((v, i, arr) => arr.indexOf(v) !== i);

                $container.find('.serial-input').each(function() {
                    const v = $(this).val().trim();
                    if (!v) {
                        $(this).removeClass('is-invalid');
                        return;
                    }
                    if (dupes.includes(v)) {
                        $(this).addClass('is-invalid');
                    } else {
                        $(this).removeClass('is-invalid');
                    }
                });
                saveDraftToStorage();
            });
        });

        $('#btnValidateMatch').click(function() {
            if (!selectedProduct) {
                alert('Please search and select a product first.');
                return;
            }

            // VALIDATION: Block addition if product is already in the summary table
            const isAlreadyAdded = deliveryItems.some(item => item.product_ID == selectedProduct.product_ID);
            if (isAlreadyAdded) {
                alert('This product is already in the summary table. Please edit the existing entry or select a different product.');
                return;
            }

            const qtyReceived = parseInt($('#txtQtyReceived').val());
            if (isNaN(qtyReceived) || qtyReceived <= 0) {
                alert('Please enter a valid Quantity Received.');
                return;
            }

            let serialsToUse = [];
            $('#serialInputsContainer .serial-input').each(function() {
                const v = $(this).val().trim();
                if (v) serialsToUse.push(v);
            });

            if (serialsToUse.length !== qtyReceived) {
                if (!confirm('The number of serials entered does not match the quantity. Continue and mark as mismatch?')) {
                    return;
                }
            }

            const duplicateInInputs = serialsToUse.filter((s, idx, arr) => arr.indexOf(s) !== idx);
            if (duplicateInInputs.length > 0) {
                alert('Duplicate serial numbers found in your inputs: ' + [...new Set(duplicateInInputs)].join(', '));
                return;
            }

            const existingSummarySerials = deliveryItems.flatMap(item => item.serialNumbers || []);
            const summaryDuplicates = serialsToUse.filter(s => existingSummarySerials.includes(s));

            if (summaryDuplicates.length > 0) {
                alert('Serial number(s) already exist in the delivery summary: ' + [...new Set(summaryDuplicates)].join(', '));
                return;
            }

            const $btn = $(this);
            $btn.prop('disabled', true);

            $.ajax({
                url: '/Home/CheckSerials',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(serialsToUse),
                success: function(res) {
                    $btn.prop('disabled', false);
                    if (res.success) {
                        const conflicts = (res.data || []).filter(r => r.exists);
                        if (conflicts.length > 0) {
                            alert('Duplicate serials detected in database: ' + conflicts.map(c => c.serial).join(', '));
                            return;
                        }

                        const deliveryId = $('#txtDeliveryID').val() || $('#delivery_ID').val();
                        const batchId = $('#txtBatchID').val() || $('#batch_ID').val();
                        const isMatched = serialsToUse.length === qtyReceived;

                        const item = {
                            deliveryId: deliveryId,
                            batchId: batchId,
                            product_ID: selectedProduct.product_ID,
                            productCode: selectedProduct.formatted_code,
                            productBrand: selectedProduct.product_brand,
                            productDesc: selectedProduct.product_description,
                            categoryName: selectedProduct.category_name,
                            currentQty: selectedProduct.current_quantity || selectedProduct.product_quantity || 0,
                            quantity: qtyReceived,
                            serialNumbers: serialsToUse,
                            isMatched: isMatched,
                            rawProduct: selectedProduct
                        };

                        deliveryItems.push(item);
                        renderSummaryTable();
                        resetLineItemInputs();
                        saveDraftToStorage();
                    } else {
                        alert('Failed to validate serials on server.');
                    }
                },
                error: function() {
                    $btn.prop('disabled', false);
                    alert('Error validating serials.');
                }
            });
        });

        // ==========================================
        // 6. SUMMARY TABLE & COMPLETION
        // ==========================================
        function renderSummaryTable() {
            const $tbody = $('#tblSummary tbody');
            $tbody.empty();

            if (deliveryItems.length === 0) {
                $tbody.append('<tr><td colspan="5" class="text-center text-muted py-3 fs-8">No matched items added yet.</td></tr>');
                return;
            }

            deliveryItems.forEach((item, index) => {
                const badge = item.isMatched
                    ? '<span class="badge bg-success">Matched</span>'
                    : '<span class="badge bg-danger">Mismatch</span>';

                const row = `
                                <tr class="summary-row" data-index="${index}" style="cursor: pointer;">
                                    <td>
                                        <div class="fw-bold">${escapeHtml(item.productCode)}</div>
                                        <div class="text-muted fs-8 text-truncate" style="max-width: 140px;">${escapeHtml(item.productBrand)} ${escapeHtml(item.productDesc || '')}</div>
                                    </td>
                                    <td class="text-center fw-bold">${item.quantity}</td>
                                    <td class="text-center">${item.serialNumbers.length}</td>
                                    <td class="text-center">${badge}</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-link text-danger p-0 btn-remove-item" data-index="${index}">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>`;
                $tbody.append(row);
            });
        }

        $(document).on('click', '#tblSummary tbody tr.summary-row', function(e) {
            if ($(e.target).closest('.btn-remove-item').length) return;

            const index = $(this).data('index');
            const [item] = deliveryItems.splice(index, 1);
            if (!item) return;

            renderSummaryTable();

            selectedProduct = item.rawProduct || {
                product_ID: item.product_ID,
                formatted_code: item.productCode,
                product_brand: item.productBrand,
                product_description: item.productDesc,
                category_name: item.categoryName,
                current_quantity: item.currentQty
            };

            $('#txtSearchProductID').val(item.productCode);
            $('#lblProductCode').text(item.productCode);
            $('#lblBrandDesc').text(`${item.productBrand} - ${item.productDesc || ''}`);
            $('#lblCategory').text(item.categoryName || '');
            $('#lblCurrentQty').text(item.currentQty || 0);
            $('#productContextPanel').removeClass('d-none');

            $('#txtQtyReceived').val(item.quantity).trigger('input');

            const $inputs = $('#serialInputsContainer .serial-input');
            (item.serialNumbers || []).forEach((s, idx) => {
                if ($inputs.eq(idx).length) {
                    $inputs.eq(idx).val(s);
                }
            });

            saveDraftToStorage();
        });

        $(document).on('click', '.btn-remove-item', function(e) {
            e.stopPropagation();
            const index = $(this).data('index');
            deliveryItems.splice(index, 1);
            renderSummaryTable();
            saveDraftToStorage();
        });

        $('#btnCompleteDelivery').click(function() {
            const receivedBy = $('#txtReceivedBy').val().trim();
            const dateDelivered = $('#dtDateDelivered').val();
            const batchId = $('#txtBatchID').val() || $('#batch_ID').val();

            if (!receivedBy) {
                alert('Please enter the Receiver Name.');
                $('#txtReceivedBy').focus();
                return;
            }

            if (deliveryItems.length === 0) {
                alert('Please add at least one item to the delivery before completing.');
                return;
            }

            const hasMismatch = deliveryItems.some(i => !i.isMatched);
            if (hasMismatch) {
                if (!confirm('Some items have a quantity mismatch with serial entries. Continue completing delivery?')) {
                    return;
                }
            }

            const payload = {
                Date_Delivered: dateDelivered,
                Received_By: receivedBy,
                Batch_ID: batchId,
                Items: deliveryItems.map(i => ({
                    Product_ID: i.product_ID,
                    Quantity: i.quantity,
                    SerialNumbers: i.serialNumbers
                }))
            };

            const $btn = $(this);
            $btn.prop('disabled', true);

            $.ajax({
                url: '/Home/CompleteDelivery',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    $btn.prop('disabled', false);
                    if (res.success) {
                        alert(res.message || 'Delivery completed successfully.');
                        clearDraftStorage();

                        deliveryItems = [];
                        renderSummaryTable();
                        resetLineItemInputs();
                        $('#txtReceivedBy').val('');
                        $('#createDeliveryOverlay').addClass('d-none');
                        if (typeof disableLayoutBlur === 'function') disableLayoutBlur();

                        if (res.delivery) {
                            const d = res.delivery;
                            receipts.unshift(d);
                            renderReceiptsTable(receipts);

                            const $new = $(`#tblReceipts tbody tr[data-id="${d.delivery_ID}"]`);
                            if ($new.length) {
                                $new.css({ backgroundColor: '#e8fff7' }).animate({ backgroundColor: '#ffffff' }, 1400, function() {
                                    $(this).css('background-color', '');
                                });
                            }
                        } else {
                            loadReceipts();
                        }
                        refreshDeliveryIdentifiers();
                    } else {
                        alert('Error: ' + (res.message || 'Failed to complete delivery.'));
                    }
                },
                error: function() {
                    $btn.prop('disabled', false);
                    alert('An error occurred while completing the delivery.');
                }
            });
        });

        // Execute Page Initialization
        initPage();
    });
</script>