@* Selected product detail panel – included in ProductManagement *@
<!-- RIGHT-SIDE OVERLAY: SELECTED PRODUCT DETAILS -->
<div id="selectedProductOverlay" class="d-none">
    <!-- PANEL HEADER -->
    <div class="panel-header d-flex justify-content-between align-items-center">
        <div>
            <h5 id="detailTitle" class="mb-0 fw-bold text-dark">Item Details</h5>
            <small id="detailSubtitle" class="text-muted"></small>
        </div>
        <button type="button" class="btn btn-sm btn-light border rounded-circle p-1" id="btnCloseSelectedPanel" aria-label="Close" style="width:32px; height:32px;">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <!-- PANEL BODY -->
    <div class="panel-body">
        <!-- Navigation Tabs -->
        <ul class="nav nav-tabs nav-tabs-custom mb-3" id="detailTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-overview" data-bs-toggle="tab" data-bs-target="#pane-overview" type="button" role="tab">OVERVIEW</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-serials" data-bs-toggle="tab" data-bs-target="#pane-serials" type="button" role="tab">SERIAL NUMBERS</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-trans" data-bs-toggle="tab" data-bs-target="#pane-trans" type="button" role="tab">TRANSACTIONS</button>
            </li>
        </ul>

        <div class="tab-content">
            <!-- TAB 1: OVERVIEW -->
            <div class="tab-pane fade show active" id="pane-overview" role="tabpanel">

                <!-- Card 1: Categorization & Codes -->
                <div class="card border-0 shadow-sm rounded-3 mb-3">
                    <div class="card-body p-3">
                        <div class="section-title mb-3"><i class="bi bi-tags me-1"></i> Categorization & Identity</div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="floating-group">
                                    <label>Product Code</label>
                                    <input type="text" id="detailProductID" class="form-control bg-light" readonly>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="floating-group">
                                    <label>Category</label>
                                    <input type="text" id="detailCategory" class="form-control bg-light" readonly>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="floating-group">
                                    <label>Product Name*</label>
                                    <input type="text" id="detailProductName" class="form-control" required>
                                    <div id="detailProductNameError" class="text-danger small mt-1 d-none">Item already exists</div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="floating-group mb-0">
                                    <label>Brand</label>
                                    <input type="text" id="detailBrand" class="form-control">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Pricing & Stock Levels -->
                <div class="card border-0 shadow-sm rounded-3 mb-3">
                    <div class="card-body p-3">
                        <div class="section-title mb-3"><i class="bi bi-currency-dollar me-1"></i> Stock & Pricing Info</div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="floating-group">
                                    <label>Price (₱)</label>
                                    <input type="number" step="0.01" id="detailPrice" class="form-control">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="floating-group">
                                    <label>Reorder Level</label>
                                    <input type="number" id="detailReorderLevel" class="form-control">
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="floating-group mb-0">
                                    <label>Quantity On Hand</label>
                                    <input type="number" id="detailQuantity" class="form-control bg-light" readonly>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Description & Status -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3">
                        <div class="section-title mb-3"><i class="bi bi-file-text me-1"></i> Description & Health Status</div>

                        <div class="floating-group mb-3">
                            <label>Description</label>
                            <textarea id="detailDescription" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="d-flex align-items-center justify-content-between pt-1">
                            <span class="section-title mb-0">Current Status</span>
                            <div id="modalHealthBadge"></div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- TAB 2: SERIAL NUMBERS -->
            <div class="tab-pane fade" id="pane-serials" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3">
                        <div class="section-title mb-3"><i class="bi bi-barcode me-1"></i> Assigned Serial Numbers</div>
                        <div class="table-responsive" style="max-height: 340px; overflow-y: auto;">
                            <table class="table table-sm align-middle mb-0 serial-table">
                                <thead>
                                    <tr>
                                        <th>Serial No.</th>
                                        <th>Batch ID</th>
                                    </tr>
                                </thead>
                                <tbody id="serialQueueTable">
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-3">No serial numbers found.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 3: TRANSACTIONS -->
            <div class="tab-pane fade" id="pane-trans" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-clock-history fs-2 text-muted mb-2 d-block"></i>
                        <div class="section-title mb-1">Transaction History</div>
                        <div class="text-muted small">Transaction log features will be populated here in a future release.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PANEL FOOTER -->
    <div class="panel-footer p-3 d-flex justify-content-between align-items-center">
        <button type="button" class="btn btn-outline-danger btn-sm px-3" id="btnDeleteProduct">
            <i class="bi bi-trash me-1"></i> Delete
        </button>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm px-3" id="btnCancelEdit">Cancel</button>
            <button type="button" class="btn btn-teal btn-sm px-4 fw-semibold d-flex align-items-center gap-1" id="btnSaveDetail">
                <span class="spinner-border spinner-border-sm d-none" id="saveSpinner" role="status" aria-hidden="true"></span>
                <i class="bi bi-floppy-fill me-1"></i> Save Changes
            </button>
        </div>
    </div>
</div>
