@* Selected product detail panel – included in ProductManagement *@
<style>
    :root {
        --teal-color: #0b6b5d;
        --teal-hover: #085247;
    }

    /* Right-Side Overlay Drawer Aligned with CreateDelivery */
    #selectedProductOverlay {
        position: fixed;
        right: 0;
        top: 0;
        height: 100vh;
        width: 620px;
        background: #fff;
        box-shadow: -8px 0 24px rgba(0, 0, 0, 0.12);
        z-index: 1055;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        z-index: 99999 !important;
        filter: none !important;
    }

        #selectedProductOverlay .panel-header {
            padding: 16px 20px;
            border-bottom: 1px solid #eef2f1;
            flex-shrink: 0;
            background: #fff;
        }

        #selectedProductOverlay .panel-body {
            padding: 20px;
            flex: 1;
            overflow-y: auto;
            background-color: #f8f9fa;
        }

        #selectedProductOverlay .panel-footer {
            flex-shrink: 0;
            background: #fff;
            border-top: 1px solid #eef2f1;
        }

        /* Nav Custom Tabs */
        #selectedProductOverlay .nav-tabs-custom {
            border-bottom: 1px solid #dee2e6;
        }

            #selectedProductOverlay .nav-tabs-custom .nav-link {
                border: none;
                color: #6c757d;
                font-weight: 600;
                font-size: 0.75rem;
                letter-spacing: 0.5px;
                padding-bottom: 8px;
                margin-right: 16px;
                background: transparent;
            }

                #selectedProductOverlay .nav-tabs-custom .nav-link.active {
                    color: var(--teal-color, #0b6b5d);
                    border-bottom: 2px solid var(--teal-color, #0b6b5d);
                    background: transparent;
                }

        /* Form Floating Labels & Inputs */
        #selectedProductOverlay .floating-group {
            position: relative;
            margin-bottom: 1.25rem;
        }

            #selectedProductOverlay .floating-group label {
                position: absolute;
                top: -9px;
                left: 10px;
                background: #ffffff;
                padding: 0 4px;
                font-size: 0.75rem;
                color: #6c757d;
                font-weight: 600;
                z-index: 2;
            }

            #selectedProductOverlay .floating-group .form-control,
            #selectedProductOverlay .floating-group .form-select {
                font-size: 0.875rem;
                border-radius: 6px;
            }

        #selectedProductOverlay .section-title {
            font-size: 0.725rem;
            font-weight: 700;
            color: #6c757d;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        /* Badges */
        #selectedProductOverlay .badge-pill-custom {
            font-size: 0.725rem;
            font-weight: 600;
            padding: 0.35em 0.8em;
            border-radius: 50rem;
            letter-spacing: 0.3px;
            display: inline-block;
        }

        #selectedProductOverlay .badge-available {
            background-color: #e6f4ea;
            color: #137333;
        }

        #selectedProductOverlay .badge-lowstock {
            background-color: #fff4e5;
            color: #b45f00;
        }

        #selectedProductOverlay .badge-outofstock {
            background-color: #fce8e6;
            color: #c5221f;
        }

        #selectedProductOverlay .badge-pendingdelivery {
            background-color: #f2f2f2;
            color: #6c757d;
        }

        /* Serial Table Design */
        #selectedProductOverlay .serial-table thead th {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #6c757d;
            background-color: #f8f9fa;
            padding: 10px 12px;
        }

        #selectedProductOverlay .serial-table tbody td {
            font-size: 0.85rem;
            vertical-align: middle;
            padding: 10px 12px;
        }

        /* Action Buttons */
        #selectedProductOverlay .btn-teal {
            background-color: var(--teal-color, #0b6b5d);
            border-color: var(--teal-color, #0b6b5d);
            color: #fff;
        }

            #selectedProductOverlay .btn-teal:hover {
                background-color: var(--teal-hover, #085247);
                border-color: var(--teal-hover, #085247);
                color: #fff;
            }
</style>

<!-- RIGHT-SIDE OVERLAY: SELECTED PRODUCT DETAILS -->
<div id="selectedProductOverlay" class="d-none">
    <!-- PANEL HEADER -->
    <div class="panel-header d-flex justify-content-between align-items-center">
        <div>
            <h5 id="detailTitle" class="mb-0 fw-bold text-dark">Item Details</h5>
            <small id="detailSubtitle" class="text-muted"></small>
        </div>
        <button type="button" class="btn btn-sm btn-light border rounded-circle p-1" id="btnCloseSelectedPanel" aria-label="Close" style="width:32px; height:32px;">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <!-- PANEL BODY -->
    <div class="panel-body">
        <!-- Navigation Tabs -->
        <ul class="nav nav-tabs nav-tabs-custom mb-3" id="detailTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-overview" data-bs-toggle="tab" data-bs-target="#pane-overview" type="button" role="tab">OVERVIEW</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-serials" data-bs-toggle="tab" data-bs-target="#pane-serials" type="button" role="tab">SERIAL NUMBERS</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-trans" data-bs-toggle="tab" data-bs-target="#pane-trans" type="button" role="tab">TRANSACTIONS</button>
            </li>
        </ul>

        <div class="tab-content">
            <!-- TAB 1: OVERVIEW -->
            <div class="tab-pane fade show active" id="pane-overview" role="tabpanel">

                <!-- Card 1: Categorization & Codes -->
                <div class="card border-0 shadow-sm rounded-3 mb-3">
                    <div class="card-body p-3">
                        <div class="section-title mb-3"><i class="bi bi-tags me-1"></i> Categorization & Identity</div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="floating-group">
                                    <label>Product Code</label>
                                    <input type="text" id="detailProductID" class="form-control bg-light" readonly>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="floating-group">
                                    <label>Category</label>
                                    <input type="text" id="detailCategory" class="form-control bg-light" readonly>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="floating-group mb-0">
                                    <label>Brand</label>
                                    <input type="text" id="detailBrand" class="form-control">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Pricing & Stock Levels -->
                <div class="card border-0 shadow-sm rounded-3 mb-3">
                    <div class="card-body p-3">
                        <div class="section-title mb-3"><i class="bi bi-currency-dollar me-1"></i> Stock & Pricing Info</div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="floating-group">
                                    <label>Price (₱)</label>
                                    <input type="number" step="0.01" id="detailPrice" class="form-control">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="floating-group">
                                    <label>Reorder Level</label>
                                    <input type="number" id="detailReorderLevel" class="form-control">
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="floating-group mb-0">
                                    <label>Quantity On Hand</label>
                                    <input type="number" id="detailQuantity" class="form-control bg-light" readonly>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Description & Status -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3">
                        <div class="section-title mb-3"><i class="bi bi-file-text me-1"></i> Description & Health Status</div>

                        <div class="floating-group mb-3">
                            <label>Description</label>
                            <textarea id="detailDescription" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="d-flex align-items-center justify-content-between pt-1">
                            <span class="section-title mb-0">Current Status</span>
                            <div id="modalHealthBadge"></div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- TAB 2: SERIAL NUMBERS -->
            <div class="tab-pane fade" id="pane-serials" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3">
                        <div class="section-title mb-3"><i class="bi bi-barcode me-1"></i> Assigned Serial Numbers</div>
                        <div class="table-responsive" style="max-height: 340px; overflow-y: auto;">
                            <table class="table table-sm align-middle mb-0 serial-table">
                                <thead>
                                    <tr>
                                        <th>Serial No.</th>
                                        <th>Batch ID</th>
                                    </tr>
                                </thead>
                                <tbody id="serialQueueTable">
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-3">No serial numbers found.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 3: TRANSACTIONS -->
            <div class="tab-pane fade" id="pane-trans" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-clock-history fs-2 text-muted mb-2 d-block"></i>
                        <div class="section-title mb-1">Transaction History</div>
                        <div class="text-muted small">Transaction log features will be populated here in a future release.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PANEL FOOTER -->
    <div class="panel-footer p-3 d-flex justify-content-between align-items-center">
        <button type="button" class="btn btn-outline-danger btn-sm px-3" id="btnDeleteProduct">
            <i class="bi bi-trash me-1"></i> Delete
        </button>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm px-3" id="btnCancelEdit">Cancel</button>
            <button type="button" class="btn btn-teal btn-sm px-4 fw-semibold d-flex align-items-center gap-1" id="btnSaveDetail">
                <span class="spinner-border spinner-border-sm d-none" id="saveSpinner" role="status" aria-hidden="true"></span>
                <i class="bi bi-floppy-fill me-1"></i> Save Changes
            </button>
        </div>
    </div>
</div>