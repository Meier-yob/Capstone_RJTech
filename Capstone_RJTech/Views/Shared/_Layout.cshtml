        </div>

        <!-- Main Content Area -->
        <div class="main-wrapper">
            <header class="top-navbar">
                <div class="selected-page">
                    <h5>@ViewData["Title"]</h5>
                    <p>@ViewData["Description"]</p>
                </div>

           
                <div class="user-profile">
                    <div class="d-flex align-items-center">
                        <button class="btn d-lg-none me-2 p-0" id="sidebarToggle">
                            <i class="fa-solid fa-bars fs-5"></i>
                        </button>

                        <div class="search-bar">
                            <i class="fa-solid fa-magnifying-glass text-muted" style="font-size: 0.8rem;"></i>
                            <input type="text" placeholder="Quick Search...">
                        </div>
                    </div>
                    <div class="position-relative me-2">
                        <i class="fa-regular fa-bell fs-5 text-muted"></i>
                        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                    </div>
                    <div class="user-info d-none d-sm-block text-end">
                        <h8 class="name">Rjtech</h8>
                        <!-- <p class="role">@ViewBag.Role</p> -->
                    </div>
                    <div class="bg-primary rounded-circle text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.8rem;">
                        <i class="fa-solid fa-user"></i>
                    </div>
                </div>
            </header>

            <!-- MAIN VIEW AREA -->
            <div class="main-content d-flex flex-column">
                <main role="main" class="flex-grow-1">
                    @RenderBody()
                </main>

           
            </div>
        </div>
    </div>

    <style>
            .sidebar,
            .top-navbar,
            .main-content {
                transition: filter 0.3s ease-in-out;
            }

            /* Blur only the background elements when overlay-open is active on body */
            body.overlay-open .sidebar,
            body.overlay-open .top-navbar,
            body.overlay-open .main-content > main > *:not(#addProductOverlay):not(#selectedProductOverlay):not(#createDeliveryOverlay):not(#selectedDeliveryOverlay) {
                filter: blur(12px) !important;
                pointer-events: none !important;
                user-select: none !important;
            }
    </style>

    <!-- SCRIPTS -->
    <script>
            // Prevent browser from navigating away when dropping files anywhere on the page
            window.addEventListener("dragover", function(e) {
                e.preventDefault();
            }, false);

            window.addEventListener("drop", function(e) {
                e.preventDefault();
            }, false);
            function enableLayoutBlur() {
                $('body').addClass('overlay-open');
            }

            function disableLayoutBlur() {
                $('body').removeClass('overlay-open');
            }
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/navigation.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>