@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DraftSYSTEM</title>

    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DraftSYSTEM.styles.css" asp-append-version="true" />
    
</head>

<body>
    <div id="appLayout">
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar" aria-label="Primary navigation">
            <div class="sidebar-header">
                <div class="mild-bg">
                    <div class="brand-mark"><img src="~/sources/logo-svg.png" alt="RJTech logo"></div>
                    <div class="brand-copy">
                        <h5>RJTech</h5>
                        <span>Inventory System</span>
                    </div>
                </div> 
            </div>

            <div class="sidebar-scroll">
                <section class="nav-section" aria-labelledby="mainMenuLabel">
                    <div class="nav-section-label" id="mainMenuLabel">Main Menu</div>
                    <ul class="sidebar-nav">
                        <li class="nav-item">
                            <a asp-action="Dashboard" asp-controller="Home" class="nav-link-custom @(currentAction == "Dashboard" && currentController == "Home" ? "active" : "")">
                                <span class="nav-icon"><i class="fa-solid fa-house"></i></span>
                                <span class="nav-label">Dashboard</span>
                            </a>
                        </li>

                        <li class="nav-item nav-group @(currentController == "Product" ? "open" : "")">
                            <button type="button" class="nav-link-custom nav-group-toggle" aria-expanded="@(currentController == "Product" ? "true" : "false")" aria-controls="productSubmenu">
                                <span class="nav-icon"><i class="fa-solid fa-boxes-stacked"></i></span>
                                <span class="nav-label">Product</span>
                                <i class="fa-solid fa-chevron-down nav-chevron"></i>
                            </button>
                            <div class="nav-submenu-shell" id="productSubmenu">
                                <ul class="nav-submenu">
                                    <li><a asp-action="ProductManagement" asp-controller="Product" class="nav-sublink @(currentAction == "ProductManagement" ? "active" : "")"><span></span>All Products</a></li>
                                    <li><a asp-action="Create" asp-controller="Product" class="nav-sublink @(currentAction == "Create" ? "active" : "")"><span></span>Add New Product</a></li>
                                    <li><a asp-action="CategoryManagement" asp-controller="Product" class="nav-sublink @(currentAction == "CategoryManagement" ? "active" : "")"><span></span>Category</a></li>
                                </ul>
                            </div>
                        </li>

                        <li class="nav-item nav-group @(currentController == "Delivery" ? "open" : "")">
                            <button type="button" class="nav-link-custom nav-group-toggle" aria-expanded="@(currentController == "Delivery" ? "true" : "false")" aria-controls="deliverySubmenu">
                                <span class="nav-icon"><i class="fa-solid fa-truck-ramp-box"></i></span>
                                <span class="nav-label">Delivery</span>
                                <i class="fa-solid fa-chevron-down nav-chevron"></i>
                            </button>
                            <div class="nav-submenu-shell" id="deliverySubmenu">
                                <ul class="nav-submenu">
                                    <li><a asp-action="DeliveryManagement" asp-controller="Delivery" class="nav-sublink @(currentAction == "DeliveryManagement" ? "active" : "")"><span></span>Delivery</a></li>
                                    <li><a asp-action="Receive" asp-controller="Delivery" class="nav-sublink @(currentAction == "Receive" ? "active" : "")"><span></span>Receive Products</a></li>
                                </ul>
                            </div>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="ScanSN" asp-action="ScanSerialNumber" class="nav-link-custom @(currentController == "ScanSN" ? "active" : "")">
                                <span class="nav-icon"><i class="fa-solid fa-barcode"></i></span>
                                <span class="nav-label">Scan SN</span>
                            </a>
                        </li>
                    </ul>
                </section>

                <section class="nav-section" aria-labelledby="analyticsLabel">
                    <div class="nav-section-label" id="analyticsLabel">Analytics</div>
                    <ul class="sidebar-nav">
                        <li class="nav-item"><a asp-controller="Sales" asp-action="Checkout" class="nav-link-custom @(currentAction == "Checkout" ? "active" : "")"><span class="nav-icon"><i class="fa-solid fa-cart-shopping"></i></span><span class="nav-label">Checkout</span></a></li>
                        <li class="nav-item"><a asp-controller="Sales" asp-action="Refund" class="nav-link-custom @(currentAction == "Refund" ? "active" : "")"><span class="nav-icon"><i class="fa-solid fa-arrow-rotate-left"></i></span><span class="nav-label">Refund</span></a></li>
                    </ul>
                </section>

                <section class="nav-section" aria-labelledby="notificationLabel">
                    <div class="nav-section-label" id="notificationLabel">Notification</div>
                    <ul class="sidebar-nav">
                        <li class="nav-item"><a asp-controller="Notification" asp-action="Notification" class="nav-link-custom @(currentAction == "Notification" ? "active" : "")"><span class="nav-icon"><i class="fa-regular fa-bell"></i></span><span class="nav-label">Notification</span><span class="nav-count">3</span></a></li>
                        <li class="nav-item"><a asp-controller="Notification" asp-action="Calendar" class="nav-link-custom @(currentAction == "Calendar" ? "active" : "")"><span class="nav-icon"><i class="fa-regular fa-calendar"></i></span><span class="nav-label">Calendar</span></a></li>
                    </ul>
                </section>
            </div>

            <div class="sidebar-footer">
                <div class="nav-section-label">System</div>
                <ul class="sidebar-nav">
                    <li class="nav-item"><a href="#" class="nav-link-custom" data-nav-placeholder="Settings"><span class="nav-icon"><i class="fa-solid fa-gear"></i></span><span class="nav-label">Settings</span></a></li>
                    <li class="nav-item"><a href="#" class="nav-link-custom nav-logout" data-nav-placeholder="Logout"><span class="nav-icon"><i class="fa-solid fa-arrow-right-from-bracket"></i></span><span class="nav-label">Logout</span></a></li>
                </ul>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="main-wrapper">
            <header class="top-navbar">
                <div class="header-primary">
                    <button type="button" class="header-icon-button d-lg-none" id="sidebarToggle" aria-label="Open navigation">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="selected-page">
                        <h5 class="page-eyebrow">RJTech Workspace</h5>
                        
                    </div>
                </div>

                <div class="header-actions">
                    <label class="search-bar" aria-label="Quick search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search" placeholder="Search workspace">
                        <kbd>⌘ K</kbd>
                    </label>
                    <a asp-controller="Notification" asp-action="Notification" class="header-icon-button header-notification" aria-label="Notifications">
                        <i class="fa-regular fa-bell"></i>
                        <span class="notification-dot"></span>
                    </a>
                    <div class="header-divider"></div>
                    <button type="button" class="profile-chip" data-nav-placeholder="Account settings" aria-label="Open account menu">
                        <span class="profile-avatar">RJ</span>
                        <span class="user-info d-none d-sm-flex">
                            <strong class="name">RJTech Admin</strong>
                            <small>Administrator</small>
                        </span>
                        <i class="fa-solid fa-chevron-down profile-chevron d-none d-sm-block"></i>
                    </button>
                </div>
            </header>

            <!-- MAIN VIEW AREA -->
            <div class="main-content d-flex flex-column" style="background-color:#ffffff;">
                <main role="main" class="flex-grow-1">
                    @RenderBody()
                </main>

           
            </div>
        </div>
    </div>

    <div id="appToastContainer" class="toast-container position-fixed top-0 end-0 p-3">
        <div id="appToast" class="toast border-0 shadow" role="status" aria-live="polite" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i id="appToastIcon" class="bi bi-check-circle-fill"></i>
                    <span id="appToastMessage"></span>
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <style>
            #appToastContainer {
                z-index: 200000 !important;
                margin-top: 64px;
                pointer-events: none;
            }

            #appToastContainer .toast {
                pointer-events: auto;
            }

    </style>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/navigation.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
