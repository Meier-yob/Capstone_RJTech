@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var salesSummaryOpen = currentController == "Sales" &&
        (currentAction == "SalesOrders" || currentAction == "Checkout" || currentAction == "SelectedCheckoutDetails");
    var salesListActive = currentController == "Sales" &&
        (currentAction == "SalesOrders" || currentAction == "SelectedCheckoutDetails");
    var newCheckoutActive = currentController == "Sales" && currentAction == "Checkout";

    // Initials for the account chips (derived from the FullName claim)
    var _userFullName = User.FindFirstValue("FullName") ?? User.Identity?.Name ?? "User";
    var _userInitials = string.Concat(
        _userFullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                     .Take(2)
                     .Select(w => char.ToUpperInvariant(w[0])));
    if (_userInitials.Length == 0) _userInitials = "U";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>@ViewData["Title"] - DraftSYSTEM</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>

    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/global-search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DraftSYSTEM.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />

</head>

<body>
    <div id="appLayout">
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar" aria-label="Primary navigation">
            <div class="sidebar-header">
                <div class="mild-bg">
                    <div class="brand-mark"><img src="~/sources/logo-svg.png" alt="RJTech logo"></div>
                    <div class="brand-copy">
                        <h5>RJTech</h5>
                        <span>Inventory System</span>
                    </div>
                </div> 
            </div>

            <div class="sidebar-scroll">
                <section class="nav-section" aria-labelledby="mainMenuLabel">
                    <div class="nav-section-label" id="mainMenuLabel">Main Menu</div>
                    <ul class="sidebar-nav">
                        <li class="nav-item">
                            <a asp-action="Index" asp-controller="Dashboard" class="nav-link-custom @(currentController == "Dashboard" || currentAction == "Dashboard" && currentController == "Home" ? "active" : "")">
                                <span class="nav-icon"><i class="fa-solid fa-house"></i></span>
                                <span class="nav-label">Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item nav-group @(currentController == "Delivery" ? "open" : "")">
                            <button type="button" class="nav-link-custom nav-group-toggle" aria-expanded="@(currentController == "Delivery" ? "true" : "false")" aria-controls="deliverySubmenu">
                                <span class="nav-icon"><i class="fa-solid fa-truck-ramp-box"></i></span>
                                <span class="nav-label">Delivery</span>
                                <i class="fa-solid fa-chevron-down nav-chevron"></i>
                            </button>
                            <div class="nav-submenu-shell" id="deliverySubmenu">
                                <ul class="nav-submenu">
                                    <li><a asp-action="DeliveryManagement" asp-controller="Delivery" class="nav-sublink @(currentAction == "DeliveryManagement" ? "active" : "")"><span></span>Delivery</a></li>
                                    <li><a asp-action="Receive" asp-controller="Delivery" class="nav-sublink @(currentAction == "Receive" ? "active" : "")"><span></span>Receive Products</a></li>
                                </ul>
                            </div>
                        </li>
                        <li class="nav-item nav-group @(currentController == "Product" ? "open" : "")">
                            <button type="button" class="nav-link-custom nav-group-toggle" aria-expanded="@(currentController == "Product" ? "true" : "false")" aria-controls="productSubmenu">
                                <span class="nav-icon"><i class="fa-solid fa-boxes-stacked"></i></span>
                                <span class="nav-label">Product</span>
                                <i class="fa-solid fa-chevron-down nav-chevron"></i>
                            </button>
                            <div class="nav-submenu-shell" id="productSubmenu">
                                <ul class="nav-submenu">
                                    <li><a asp-action="ProductManagement" asp-controller="Product" class="nav-sublink @(currentAction == "ProductManagement" ? "active" : "")"><span></span>All Products</a></li>
                                    <li><a asp-action="Create" asp-controller="Product" class="nav-sublink @(currentAction == "Create" ? "active" : "")"><span></span>Add New Product</a></li>
                                    <li><a asp-action="CategoryManagement" asp-controller="Product" class="nav-sublink @(currentAction == "CategoryManagement" ? "active" : "")"><span></span>Category</a></li>
                                </ul>
                            </div>
                        </li>
                        <li class="nav-item"><a asp-controller="Reports" asp-action="Index" class="nav-link-custom @(currentController == "Reports" ? "active" : "")"><span class="nav-icon"><i class="fa-solid fa-chart-column"></i></span><span class="nav-label">Reports</span></a></li>



                    </ul>
                </section>

                <section class="nav-section" aria-labelledby="analyticsLabel">
                    <div class="nav-section-label" id="analyticsLabel">Sales</div>
                    <ul class="sidebar-nav">
                        <li class="nav-item nav-group @(salesSummaryOpen ? "open" : "")">
                            <button type="button" class="nav-link-custom nav-group-toggle" aria-expanded="@(salesSummaryOpen ? "true" : "false")" aria-controls="salesSummarySubmenu">
                                <span class="nav-icon"><i class="fa-solid fa-receipt"></i></span>
                                <span class="nav-label">Sales</span>
                                <i class="fa-solid fa-chevron-down nav-chevron"></i>
                            </button>
                            <div class="nav-submenu-shell" id="salesSummarySubmenu">
                                <ul class="nav-submenu">
                                    <li><a asp-controller="Sales" asp-action="SalesOrders" class="nav-sublink @(salesListActive ? "active" : "")"><span></span>Sales</a></li>
                                    <li><a asp-controller="Sales" asp-action="Checkout" class="nav-sublink @(newCheckoutActive ? "active" : "")"><span></span>New Checkout</a></li>
                                </ul>
                            </div>
                        </li>
                        <li class="nav-item"><a asp-controller="Sales" asp-action="Customer" class="nav-link-custom @(currentController == "Sales" && currentAction == "Customer" ? "active" : "")"><span class="nav-icon"><i class="fa-solid fa-users"></i></span><span class="nav-label">Customers</span></a></li>

                        <li class="nav-item"><a asp-controller="Sales" asp-action="SalesHistory" class="nav-link-custom @(currentController == "Sales" && currentAction == "SalesHistory" ? "active" : "")"><span class="nav-icon"><i class="bi bi-clock-history"></i></span><span class="nav-label">Purchase History</span></a></li>
                        <li class="nav-item"><a asp-controller="Installment" asp-action="Index" class="nav-link-custom @(currentController == "Installment" ? "active" : "")"><span class="nav-icon"><i class="fa-solid fa-calendar-check"></i></span><span class="nav-label">Installments</span></a></li>
                    </ul>
                </section>

                <section class="nav-section" aria-labelledby="notificationLabel">
                    <div class="nav-section-label" id="notificationLabel">Notification</div>
                    <ul class="sidebar-nav">
                        <li class="nav-item"><a asp-controller="Notification" asp-action="Notification" class="nav-link-custom @(currentAction == "Notification" ? "active" : "")"><span class="nav-icon"><i class="fa-regular fa-bell"></i></span><span class="nav-label">Notification</span><span class="nav-count"></span></a></li>
                    </ul>
                </section>
            </div>

            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <a asp-controller="Setting" asp-action="AccountMenu" class="sidebar-user-link">
                        <span class="sidebar-user-avatar">@_userInitials[..1]</span>
                        <span class="sidebar-user-copy"><strong>@(User.Identity?.Name ?? "User")</strong><small>Owner</small></span>
                    </a>
                    <button class="sidebar-user-action" type="button" aria-label="Logout"
                            data-bs-toggle="modal" data-bs-target="#logoutConfirmationModal">
                        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="main-wrapper">
            <header class="top-navbar">
                <div class="header-primary">
                    <button type="button" id="sidebarToggle" class="header-icon-button d-lg-none" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar"><i class="bi bi-list" aria-hidden="true"></i></button>
                    <button class="search-bar global-search-trigger" id="globalSearchTrigger" type="button"
                            aria-label="Search all pages" aria-haspopup="dialog" aria-controls="globalSearchModal"
                            title="Search all pages (Ctrl+K or Windows+K)">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <span class="global-search-trigger-text">Search all pages</span>
                        <kbd>Ctrl K</kbd>
                    </button>
                </div>

                <div class="header-actions">
                    <a asp-controller="Sales" asp-action="Checkout" class="btn btn-primary"><span></span>New Checkout</a>

                   
                    <button id="themeToggle" class="header-icon-button" type="button" aria-label="Dark mode" aria-pressed="false" title="Switch to dark mode">
                        <i class="bi bi-moon" aria-hidden="true"></i>
                    </button>
                    <button id="notificationToggle" class="header-icon-button header-notification" type="button"
                            aria-label="Notifications" aria-expanded="false" aria-controls="notificationFlyout">
                        <i class="fa-regular fa-bell"></i>
                        <span id="notificationDot" class="notification-dot d-none"></span>
                        <span id="notificationBadge" class="notification-badge d-none">0</span>
                    </button>
                    <div id="notificationFlyout" class="notification-flyout d-none"
                         data-list-url="@Url.Action("GetNotifications", "Notification")"
                         data-read-url="@Url.Action("MarkAsRead", "Notification")"
                         data-read-all-url="@Url.Action("MarkAllAsRead", "Notification")">
                        <div class="notification-flyout-header">
                            <div><strong>Notifications</strong><span id="flyoutUnreadCount" class="notification-count">0</span></div>
                            <button id="flyoutMarkAllRead" class="btn btn-sm btn-link" type="button">Mark all read</button>
                        </div>
                        <div id="notificationFlyoutList" class="notification-flyout-list">
                            <div class="notification-loading">Loading notifications…</div>
                        </div>
                        <a asp-controller="Notification" asp-action="Notification" class="notification-flyout-footer">View all notifications</a>
                    </div>
                    <div class="header-divider"></div>
                    <div class="dropdown">
                        <button type="button" class="profile-chip dropdown-toggle" data-bs-toggle="dropdown"
                                aria-expanded="false" aria-label="Open account menu">
                            <span class="profile-avatar">@_userInitials</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end account-dropdown-menu">
                            <li class="account-dropdown-header">
                                <strong>@_userFullName</strong>
                                <small>Owner</small>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Setting" asp-action="AccountMenu">
                                    <i class="fa-solid fa-gear"></i> Account Settings
                                </a>
                            </li>
                            <li>
                                <button class="dropdown-item text-danger" type="button"
                                        data-bs-toggle="modal" data-bs-target="#logoutConfirmationModal">
                                    <i class="fa-solid fa-arrow-right-from-bracket"></i> Sign Out
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- MAIN VIEW AREA -->
            <div class="main-content d-flex flex-column" style="padding:0;">
                <main role="main" class="flex-grow-1">
                    @RenderBody()
                </main>


            </div>
        </div>
    </div>

    <div class="global-search-layer" id="globalSearchModal" hidden>
        <section class="global-search-dialog" role="dialog" aria-modal="true" aria-labelledby="globalSearchTitle">
            <h2 class="visually-hidden" id="globalSearchTitle">Search all pages</h2>
            <div class="global-search-input-row">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input id="globalSearchInput" type="search" placeholder="Type a page name..."
                       autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list"
                       aria-expanded="true" aria-controls="globalSearchResults" />
                <button class="global-search-close" id="globalSearchClose" type="button" aria-label="Close search">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <div class="global-search-content">
                <div class="global-search-section-heading">
                    <span>Pages</span>
                    <span id="globalSearchCount"></span>
                </div>
                <div class="global-search-results" id="globalSearchResults" role="listbox" aria-label="Page search results"></div>
                <div class="global-search-empty" id="globalSearchEmpty" hidden>
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <strong>No pages found</strong>
                    <span>Try another page name or keyword.</span>
                </div>
            </div>
            <footer class="global-search-footer" aria-hidden="true">
                <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
                <span><kbd>Enter</kbd> Open</span>
                <span><kbd>Esc</kbd> Close</span>
            </footer>
        </section>
    </div>

    <!-- Logout confirmation modal -->
    <div class="modal fade" id="logoutConfirmationModal" tabindex="-1" role="dialog"
         aria-labelledby="logoutConfirmationTitle" aria-describedby="logoutConfirmationMessage"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered logout-modal-dialog">
            <div class="modal-content logout-modal-content">
                <div class="modal-body text-center logout-modal-body">
                    <span class="logout-modal-icon" aria-hidden="true"><i class="fa-solid fa-arrow-right-from-bracket"></i></span>
                    <h2 class="modal-title fs-5 logout-modal-title" id="logoutConfirmationTitle">Log out of RJTech?</h2>
                    <p class="logout-modal-message" id="logoutConfirmationMessage">You&rsquo;ll need to sign in again to access your inventory.</p>

                    <span class="logout-account-chip">
                        <i class="fa-solid fa-user" aria-hidden="true"></i>
                        <span class="logout-account-name">@(User.Identity?.Name ?? "User")</span>
                        <span class="logout-account-sep" aria-hidden="true">&middot;</span>
                        <span class="logout-account-role">Owner</span>
                    </span>

                    @if (ViewData["LogoutHasUnsavedWork"] is true)
                    {
                        <div class="logout-unsaved-warning d-none" id="logoutUnsavedWarning" role="alert">
                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                            <span>You have unsaved changes that will be lost.</span>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 logout-modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="logout-modal-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary logout-submit">
                            <span class="logout-submit-label">Log out</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div id="appToastContainer" class="toast-container position-fixed top-0 end-0 p-3"
         data-success-message="@(TempData["ToastSuccess"] ?? TempData["ImageSuccess"])"
         data-error-message="@(TempData["ToastError"] ?? TempData["ImageError"])"
         data-warning-message="@TempData["ToastWarning"]"
         data-info-message="@TempData["ToastInfo"]">
        <div id="appToast" class="toast fade border-0 shadow" role="status" aria-live="polite" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i id="appToastIcon" class="bi bi-check-circle-fill"></i>
                    <span id="appToastMessage"></span>
                    <button id="appToastAction" type="button" class="btn btn-sm btn-light text-dark rounded-pill px-3 ms-auto d-none"></button>
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/table-enhancements.js" asp-append-version="true"></script>
    <script src="~/js/navigation.js" asp-append-version="true"></script>
    <script src="~/js/global-search.js" asp-append-version="true"></script>
    <script src="~/js/notification-center.js" asp-append-version="true"></script>
    <script>
        window.addEventListener("pageshow", function (event) {
            if (event.persisted) {
                window.location.reload();
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
