@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Signing out - RJTech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <main class="container py-5">
        <p>Signing out of Clerk...</p>
    </main>
    <script async crossorigin="anonymous" data-clerk-publishable-key="@ViewData["ClerkPublishableKey"]" src="@ViewData["ClerkAuthority"]/npm/@@clerk/clerk-js@latest/dist/clerk.browser.js"></script>
    <script>
        window.addEventListener("load", async () => {
            const publishableKey = "@ViewData["ClerkPublishableKey"]";
            if (publishableKey) {
                await Clerk.load({ publishableKey });
                await Clerk.signOut();
            }
            window.location.assign("/Developer/Login");
        });
    </script>
</body>
</html>