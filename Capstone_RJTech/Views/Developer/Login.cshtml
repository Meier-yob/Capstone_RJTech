@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
    var signInCompletionUrl = Url.Action("Login", "Developer", new { returnUrl }) ?? "/Developer/Login";
    var accessDeniedMessage = TempData["DeveloperAccessDenied"] as string;
    // The flag is also carried in the URL (?accessDenied=true) so the redirect guard
    // survives page reloads triggered by Clerk's signOut() (which consume TempData).
    var accessDeniedFlag = accessDeniedMessage is string || Context.Request.Query.ContainsKey("accessDenied");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>System Developer Login - RJTech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light" data-clerk-publishable-key="@ViewData["ClerkPublishableKey"]"
      data-return-url="@returnUrl" data-sign-in-completion-url="@signInCompletionUrl"
      data-auth-error="@(ViewData["AuthorizationError"] is string ? "1" : "0")"
      data-access-denied="@(accessDeniedFlag ? "1" : "0")">
    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h1 class="h3 mb-3">System Developer Login</h1>
                        <p class="text-muted">
                            Sign in with the authorized Clerk account to access the Developer Portal.
                        </p>
                        @if (ViewData["AuthorizationError"] is string authorizationError)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <strong>Developer access denied.</strong>
                                <span>@authorizationError</span>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        @if (accessDeniedMessage is string deniedMessage)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <span>@deniedMessage</span>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        <div id="clerk-sign-in"></div>
                        <p id="clerk-config-missing" class="alert alert-warning d-none mb-0">
                            Clerk is not configured. Set the Clerk configuration environment variables before signing in.
                        </p>
                        @if (!string.IsNullOrWhiteSpace(returnUrl))
                        {
                            <p class="small text-muted mt-3 mb-0">You will return to the requested Developer Portal page after signing in.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </main>
    <script async crossorigin="anonymous" data-clerk-publishable-key="@ViewData["ClerkPublishableKey"]" src="@ViewData["ClerkAuthority"]/npm/@@clerk/clerk-js@latest/dist/clerk.browser.js"></script>
    <script>
        window.addEventListener("load", async () => {
            const publishableKey = document.body.dataset.clerkPublishableKey;
            const signInElement = document.getElementById("clerk-sign-in");

            if (!publishableKey) {
                document.getElementById("clerk-config-missing").classList.remove("d-none");
                return;
            }

            await Clerk.load({ publishableKey });

            const signInCompletionUrl = document.body.dataset.signInCompletionUrl || "/Developer/Login";
            const accessDenied = document.body.dataset.accessDenied === "1";

            // A non-SystemDeveloper Clerk session was terminated server-side. Revoke any
            // lingering Clerk session BEFORE the widget mounts: if a session is
            // still active when mountSignIn runs, the widget restores it, redirects
            // to afterSignInUrl, and bounces this page in a loop.
            if (accessDenied) {
                for (let attempt = 0; attempt < 3 && Clerk.session; attempt++) {
                    try {
                        await Clerk.signOut();
                    } catch (err) {
                        console.warn("Clerk signOut attempt failed:", err);
                    }
                }

                // Belt-and-suspenders: revoke any session Clerk restores
                // asynchronously right after load. Genuine sign-ins take the user
                // longer than this window, so they are not affected.
                const restoreWindowMs = 5000;
                const mountTime = Date.now();
                Clerk.addListener(({ session }) => {
                    const signInInProgress = Boolean(Clerk.client?.signIn?.status);
                    if (session && !signInInProgress && Date.now() - mountTime < restoreWindowMs) {
                        Clerk.signOut().catch((err) =>
                            console.warn("Clerk signOut failed on restored session:", err));
                    }
                });

                if (Clerk.session) {
                    // Still signed in after retries: mounting the widget would
                    // immediately bounce the page again, so fall back to a manual
                    // sign-out instead of looping.
                    signInElement.innerHTML =
                        '<div class="alert alert-warning" role="alert">' +
                        "Your previous Clerk session could not be terminated automatically. " +
                        '<a href="/Developer/Logout" class="alert-link">Sign out of Clerk</a> and try again.</div>';
                    return;
                }
            }

            const redirectToDeveloperPortal = ({ session } = {}) => {
                // When the server rendered an error / access-denied state, do not
                // bounce back to the sign-in completion URL (avoids a reload loop).
                // data-access-denied survives reloads because the server also carries
                // the flag in the URL (?accessDenied=true).
                const showError = document.body.dataset.authError === "1" || document.body.dataset.accessDenied === "1";
                if (session && !showError) {
                    window.location.replace(signInCompletionUrl);
                }
            };

            Clerk.addListener(redirectToDeveloperPortal);
            redirectToDeveloperPortal({ session: Clerk.session });

            Clerk.mountSignIn(signInElement, {
                // forceRedirectUrl is intentionally omitted: it redirects even when a
                // session already exists at mount time, which would create a redirect
                // loop on the access-denied page. afterSignInUrl navigates only after a
                // genuine new sign-in completes.
                preferSession: false,
                afterSignInUrl: signInCompletionUrl,
                afterSignUpUrl: signInCompletionUrl
            });
        });
    </script>
    <script>
        // Dependency-free dismiss for the alert banners (Bootstrap JS is not loaded).
        document.querySelectorAll(".alert .btn-close").forEach((button) => {
            button.addEventListener("click", () => {
                const alert = button.closest(".alert");
                if (alert) {
                    alert.remove();
                }
            });
        });
    </script>
</body>
</html>
