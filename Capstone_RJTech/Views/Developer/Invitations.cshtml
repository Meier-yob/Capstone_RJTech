@model Capstone_RJTech.ViewModels.InvitationListViewModel
@{
    ViewData["Title"] = "Developer Invitations";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Developer Portal</h1>
            <p class="text-muted mb-0">Manage Owner invitations.</p>
        </div>
        <form asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary">Sign out</button>
        </form>
    </div>

    @if (TempData["InvitationSuccess"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }
    @if (TempData["InvitationError"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <section class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Send invitation</h2>
            <form asp-action="SendInvitation" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-8">
                    <label asp-for="NewInvitation.Email" class="form-label">Owner email</label>
                    <input asp-for="NewInvitation.Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="NewInvitation.Email" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">Send invitation</button>
                </div>
            </form>
        </div>
    </section>

    <section>
        <h2 class="h5">Invitations</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Created</th>
                        <th>Expires</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Invitations.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-muted">No invitations are available yet.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var invitation in Model.Invitations)
                        {
                            <tr>
                                <td>@invitation.Email</td>
                                <td>@invitation.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td>@invitation.ExpiresAt.ToLocalTime().ToString("g")</td>
                                <td>@invitation.Status</td>
                                <td class="text-end">
                                    <form asp-action="ResendInvitation" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="InvitationID" value="@invitation.InvitationID" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Resend</button>
                                    </form>
                                    <form asp-action="RevokeInvitation" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="InvitationID" value="@invitation.InvitationID" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
