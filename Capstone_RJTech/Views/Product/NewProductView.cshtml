@model Capstone_RJTech.ViewModels.ProductCreateViewModel

@{
    ViewData["Title"] = "New Product";
    ViewData["Description"] = "Add a new product to the catalog.";

    var categories =
        ViewBag.Categories as IEnumerable<ProductCategory>
        ?? Enumerable.Empty<ProductCategory>();
}

<div class="app-page new-product-page"
     id="newProductPage"
     data-products-url="@Url.Action("ProductManagement")"
     data-bulk-create-url="@Url.Action("BulkCreate")">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home"
                   asp-action="Dashboard">
                    Dashboard
                </a>
            </li>

            <li class="breadcrumb-item">
                <a asp-action="ProductManagement">
                    Products
                </a>
            </li>

            <li class="breadcrumb-item active">
                New Product
            </li>
        </ol>
    </nav>


    <!-- Page Heading -->
    <div class="page-heading new-product-heading">
        <div>
            <h1>New Product</h1>

            <p>
                Add a catalog item. Stock is updated only when products are received.
            </p>
        </div>

        <button class="btn btn-primary new-product-bulk-button"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#bulkAddModal">

            <i class="bi bi-table me-1"></i>
            Bulk Add Products
        </button>
    </div>


    <!-- Create Product Form -->
    <form id="createProductForm"
          method="post"
          asp-action="Create"
          novalidate>

        <div class="new-product-layout">

            <!-- =====================================================
                 LEFT SIDE
                 ===================================================== -->
            <div class="new-product-main">


                <!-- =================================================
                     SECTION 1 - PRODUCT DETAILS
                     ================================================= -->
                <section class="app-card new-product-card"
                         aria-labelledby="productDetailsTitle">

                    <div class="new-product-section-heading">

                        <div class="new-product-section-title">
                            <span class="new-product-step">
                                1
                            </span>

                            <h2 id="productDetailsTitle">
                                Product Details
                            </h2>
                        </div>

                        <small>
                            Enter the product name, brand, and description.
                        </small>

                    </div>


                    <div class="new-product-card-body">

                        <div class="row g-3">

                            <!-- Product Name -->
                            <div class="col-md-7">

                                <label asp-for="product_name"
                                       class="form-label">
                                    Product Name
                                </label>

                                <input asp-for="product_name"
                                       class="form-control"
                                       placeholder="e.g. Mechanical Gaming Keyboard"
                                       required />

                                <span asp-validation-for="product_name"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Brand -->
                            <div class="col-md-5">

                                <label asp-for="product_brand"
                                       class="form-label">
                                    Brand
                                </label>

                                <input asp-for="product_brand"
                                       class="form-control"
                                       placeholder="e.g. Logitech"
                                       required />

                                <span asp-validation-for="product_brand"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Description -->
                            <div class="col-12">

                                <label asp-for="product_description"
                                       class="form-label">
                                    Description
                                </label>

                                <textarea asp-for="product_description"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Describe the model, features, or compatibility."></textarea>

                            </div>


                            <!-- Inventory Tracking Type -->
                            <div class="col-12">

                                <label class="form-label">
                                    Inventory Tracking Type
                                </label>

                                <div class="inventory-track-options">

                                    <input type="radio"
                                           class="btn-check"
                                           name="IsSerialized"
                                           id="trackNonSerialized"
                                           value="false"
                                           autocomplete="off"
                                           checked />

                                    <label class="btn btn-outline-primary btn-sm"
                                           for="trackNonSerialized">
                                        <i class="bi bi-box-seam me-1"></i>
                                        Non-Serialized
                                    </label>

                                    <input type="radio"
                                           class="btn-check"
                                           name="IsSerialized"
                                           id="trackSerialized"
                                           value="true"
                                           autocomplete="off" />

                                    <label class="btn btn-outline-primary btn-sm"
                                           for="trackSerialized">
                                        <i class="bi bi-upc-scan me-1"></i>
                                        Serialized
                                    </label>

                                </div>
                            </div>

                        </div>

                    </div>

                </section>


                <!-- =================================================
                     SECTION 2 - INVENTORY & PRICING
                     ================================================= -->
                <section class="app-card new-product-card"
                         aria-labelledby="inventoryPricingTitle">

                    <div class="new-product-section-heading">

                        <div class="new-product-section-title">

                            <span class="new-product-step">
                                2
                            </span>

                            <h2 id="inventoryPricingTitle">
                                Inventory &amp; Pricing
                            </h2>

                        </div>

                        <small>
                            Set the selling price and low-stock alert level.
                        </small>

                    </div>


                    <div class="new-product-card-body">

                        <div class="row g-3">


                            <!-- Quantity -->
                            <div class="col-md-4">

                                <label asp-for="product_quantity"
                                       class="form-label">
                                    Quantity
                                </label>

                                <input asp-for="product_quantity"
                                       class="form-control"
                                       type="number"
                                       value="0"
                                       disabled />

                                <div class="form-hint mt-1">
                                    Stock is updated through Delivery.
                                </div>

                            </div>


                            <!-- Selling Price -->
                            <div class="col-md-4">

                                <label asp-for="Product_price"
                                       class="form-label">
                                    Selling Price
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₱
                                    </span>

                                    <input asp-for="Product_price"
                                           class="form-control"
                                           type="number"
                                           min="0.01"
                                           step="0.01"
                                           required />

                                </div>

                                <span asp-validation-for="Product_price"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Reorder Level -->
                            <div class="col-md-4">

                                <label asp-for="reorder_level"
                                       class="form-label">
                                    Reorder Level
                                </label>

                                <input asp-for="reorder_level"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       step="1"
                                       required />

                               
                                <span asp-validation-for="reorder_level"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>

                </section>

            </div>



            <!-- =====================================================
                 RIGHT SIDE
                 ===================================================== -->
            <aside class="new-product-sidebar">

                <!-- =================================================
                     SECTION 3 - ORGANIZATION & STATUS
                     ================================================= -->
                <section class="app-card new-product-card new-product-sidebar-card"
                         aria-labelledby="organizationStatusTitle">

                    <div class="new-product-section-heading">

                        <div class="new-product-section-title">

                            <span class="new-product-step">
                                3
                            </span>

                            <h2 id="organizationStatusTitle">
                                Categorization &amp; Status
                            </h2>

                        </div>

                        <small>
                            Assign a category and review the initial status.
                        </small>

                    </div>


                    <div class="new-product-card-body">


                        <!-- Category -->
                        <div class="mb-3">

                            <label asp-for="category_ID"
                                   class="form-label">
                                Category
                            </label>

                            <input type="hidden"
                                   name="category_ID"
                                   id="categoryIdHidden" />

                            <div class="category-search">

                                <button type="button"
                                        class="category-search-trigger"
                                        id="categorySearchTrigger"
                                        aria-haspopup="listbox"
                                        aria-expanded="false">

                                    <span class="category-search-value is-placeholder"
                                          id="categorySelectedText">
                                        Select a category
                                    </span>

                                    <i class="bi bi-chevron-down category-search-caret"></i>

                                </button>

                                <div class="category-search-panel d-none"
                                     id="categorySearchPanel">

                                    <input type="text"
                                           class="form-control category-search-input"
                                           id="categorySearchInput"
                                           placeholder="Search categories..."
                                           autocomplete="off"
                                           aria-label="Search categories" />

                                    <ul class="category-search-list"
                                        role="listbox"
                                        id="categorySearchList">

                                        @foreach (var category in categories)
                                        {
                                            <li role="option"
                                                data-category-id="@category.category_ID"
                                                data-category-name="@category.category_name">
                                                @category.category_name
                                            </li>
                                        }

                                        <li role="option"
                                            class="category-search-empty d-none"
                                            id="categorySearchEmpty">
                                            No matching categories.
                                        </li>

                                    </ul>

                                </div>

                            </div>

                            <span asp-validation-for="category_ID"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Initial Status -->
                        <div class="new-product-status-panel mb-4">

                            <label class="form-label">
                                Initial Status
                            </label>

                            <div class="mt-1">

                                <span class="status-badge status-unavailable">
                                    Unavailable
                                </span>

                            </div>

                            <div class="form-hint mt-2">
                                The status changes only after stock is received through Delivery.
                            </div>

                        </div>


                        <!-- Hidden Product Status -->
                        <input asp-for="product_status"
                               type="hidden"
                               value="Unavailable" />


                        <!-- Actions -->
                        <div class="new-product-actions">

                            <a asp-action="ProductManagement"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button id="submitProduct"
                                    type="submit"
                                    class="btn btn-primary">

                                <span class="spinner-border spinner-border-sm d-none me-1">
                                </span>

                                <i class="bi bi-plus-circle me-1"></i>

                                Add Product

                            </button>

                        </div>

                    </div>

                </section>

            </aside>

        </div>

    </form>

</div>



<!-- =============================================================
     BULK ADD PRODUCTS MODAL
     ============================================================= -->
<div class="modal fade"
     id="bulkAddModal"
     tabindex="-1"
     aria-labelledby="bulkAddTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable bulk-add-dialog">

        <div class="modal-content">


            <!-- Modal Header -->
            <div class="modal-header bulk-add-header">

                <div>

                    <h2 class="modal-title fs-5"
                        id="bulkAddTitle">
                        Bulk Add Products
                    </h2>

                    <p class="small text-muted mb-0 bulk-add-subtitle">
                        Create multiple catalog items.

                        <span class="stock-note-chip">
                            Stock starts at 0 &middot; updated through Delivery
                        </span>

                    </p>

                </div>


                <button class="btn-close"
                        type="button"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- Modal Body -->
            <div class="modal-body bulk-add-body">


                <!-- Bulk Error -->
                <div id="bulkErrors"
                     class="alert alert-danger d-none small">
                </div>


                <!-- Products Table -->
                <div class="bulk-table-scroll">

                    <table class="table align-middle bulk-product-table"
                           data-no-selection="true"
                           data-sortable="false">

                        <thead>
                            <tr>
                                <th scope="col" class="bulk-col-row text-center">#</th>
                                <th scope="col">Category</th>
                                <th scope="col">Product Name</th>
                                <th scope="col">Brand</th>
                                <th scope="col" class="text-center">Serialized</th>
                                <th scope="col">Price</th>
                                <th scope="col">Reorder</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody id="bulkRows">
                        </tbody>

                        <tfoot>
                            <tr>
                                <td colspan="8">

                                    <button id="addBulkRow"
                                            class="bulk-add-row-button"
                                            type="button">

                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                        Add another product

                                    </button>

                                </td>
                            </tr>
                        </tfoot>

                    </table>

                </div>

            </div>


            <!-- Modal Footer -->
            <div class="modal-footer bulk-add-footer">

                <button class="btn btn-outline-secondary"
                        type="button"
                        data-bs-dismiss="modal">

                    Cancel

                </button>


                <button id="saveBulkProducts"
                        class="btn btn-primary"
                        type="button">

                    <span class="spinner-border spinner-border-sm d-none me-1">
                    </span>

                    Add Products

                </button>

            </div>

        </div>

    </div>

</div>



<!-- =============================================================
     BULK PRODUCT ROW TEMPLATE
     ============================================================= -->
<template id="bulkRowTemplate">

    <tr class="bulk-row">


        <!-- Row Number -->
        <td class="bulk-row-number-cell text-center">

            <span class="bulk-row-number">1</span>

        </td>


        <!-- Category -->
        <td>

            <select class="form-select bulk-category"
                    required>

                <option value="">
                    Select category
                </option>

                @foreach (var category in categories)
                {
                    <option value="@category.category_ID">
                        @category.category_name
                    </option>
                }

            </select>

        </td>


        <!-- Product Name -->
        <td>

            <input class="form-control bulk-name"
                   placeholder="e.g. Mechanical Keyboard"
                   required />

        </td>


        <!-- Brand -->
        <td>

            <input class="form-control bulk-brand"
                   placeholder="e.g. Logitech"
                   required />

        </td>


        <!-- Serialized -->
        <td class="text-center">

            <div class="form-check form-switch bulk-serialized-switch">

                <input class="form-check-input bulk-serialized"
                       type="checkbox"
                       role="switch"
                       aria-label="Serialized" />

            </div>

        </td>


        <!-- Price -->
        <td>

            <input class="form-control bulk-price"
                   type="number"
                   min="0.01"
                   step="0.01"
                   placeholder="0.00"
                   required />

        </td>


        <!-- Reorder Level -->
        <td>

            <input class="form-control bulk-reorder"
                   type="number"
                   min="0"
                   step="1"
                   value="0"
                   required />

        </td>


        <!-- Actions -->
        <td class="text-end">

            <div class="bulk-row-actions">

                <button class="btn duplicate-bulk-row"
                        type="button"
                        title="Duplicate row (copies category, brand, reorder)"
                        aria-label="Duplicate row">

                    <i class="bi bi-files" aria-hidden="true"></i>

                </button>

                <button class="btn btn-outline-danger remove-bulk-row"
                        type="button"
                        title="Remove row"
                        aria-label="Remove row">

                    <i class="bi bi-trash3" aria-hidden="true"></i>

                </button>

            </div>

        </td>

    </tr>

</template>



<!-- =============================================================
     CONFIRM EXIT MODAL
     ============================================================= -->
<div class="modal fade confirm-exit-modal"
     id="confirmExitModal"
     tabindex="-1"
     aria-labelledby="confirmExitTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered confirm-exit-dialog">

        <div class="modal-content">


            <!-- Header -->
            <div class="confirm-exit-head">

                <span class="confirm-exit-icon" aria-hidden="true">
                    <i class="bi bi-exclamation-triangle"></i>
                </span>

                <div>
                    <h2 class="modal-title fs-5 confirm-exit-title"
                        id="confirmExitTitle">
                        Unsaved changes
                    </h2>

                    <p class="confirm-exit-subtitle">
                        This action can&apos;t be undone.
                    </p>
                </div>

            </div>


            <!-- Body -->
            <div class="modal-body">

                <p class="mb-0 confirm-exit-message">
                    You have unsaved changes. Are you sure you want to leave?
                </p>

            </div>


            <!-- Footer -->
            <div class="modal-footer confirm-exit-footer">

                <button class="btn btn-outline-secondary confirm-exit-cancel"
                        type="button"
                        data-bs-dismiss="modal">

                    Cancel

                </button>


                <button id="discardAndLeave"
                        class="btn btn-danger confirm-exit-leave"
                        type="button">

                    Discard &amp; Leave

                </button>

            </div>

        </div>

    </div>

</div>



@section Styles {

    <link rel="stylesheet"
          href="~/css/new-product.css"
          asp-append-version="true" />

}


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/product-create.js"
            asp-append-version="true">
    </script>

}
