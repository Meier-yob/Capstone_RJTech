@model IEnumerable<Capstone_RJTech.Models.ProductCategory>
@using System.Globalization
@{
    ViewData["Title"] = "Category Management";
    ViewData["Description"] = "Organize product categories and browse your inventory.";
    var categories = Model.ToList();
    var products = ViewBag.Products as List<Product> ?? new List<Product>();
    var productCounts = products.GroupBy(product => product.category_ID)
        .ToDictionary(group => group.Key, group => group.Count());
    string StatusClass(string status) => status.ToLowerInvariant().Replace(" ", "-");
}

<div class="app-page category-page" id="categoryManagementPage">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="ProductManagement">Products</a></li>
            <li class="breadcrumb-item active" aria-current="page">Categories</li>
        </ol>
    </nav>

    <div class="page-heading">
        <div>
            <h1>Category Management</h1>
            <p>Organize product categories and browse your inventory.</p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Add Category
        </button>
    </div>

    <div class="category-layout">
        <section class="app-card category-directory" aria-labelledby="categoriesHeading">
            <div class="category-directory-header">
                <h2 class="card-title-sm" id="categoriesHeading">Categories <span class="category-total">@categories.Count</span></h2>
                <p class="card-subtitle-sm">Select a category to view its products.</p>
                <label for="searchCategoryInput" class="visually-hidden">Search categories</label>
                <div class="input-group search-control category-search">
                    <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                    <input type="search" id="searchCategoryInput" class="form-control" placeholder="Search categories..." autocomplete="off" />
                </div>
            </div>
            <div class="category-list" id="categoryList">
                <div class="category-entry active">
                    <button type="button" class="category-item active" data-category-id="all"
                            data-category-name="All Products" aria-pressed="true" aria-controls="categoryProductsTable">
                        <span class="category-list-icon"><i class="bi bi-grid" aria-hidden="true"></i></span>
                        <span class="category-copy"><strong>All Products</strong><small>Your complete inventory</small></span>
                        <span class="category-product-count" aria-label="@products.Count products">@products.Count</span>
                    </button>
                </div>
                @foreach (var category in categories)
                {
                    var count = productCounts.GetValueOrDefault(category.category_ID);
                    <div class="category-entry category-wrapper">
                        <button type="button" class="category-item" data-category-id="@category.category_ID"
                                data-category-name="@category.category_name" data-category-code="CAT-@category.category_ID.ToString("D3")"
                                aria-pressed="false" aria-controls="categoryProductsTable">
                            <span class="category-list-icon"><i class="bi bi-folder2" aria-hidden="true"></i></span>
                            <span class="category-copy">
                                <strong class="category-title">@category.category_name</strong>
                                <small>CAT-@category.category_ID.ToString("D3")</small>
                            </span>
                            <span class="category-product-count" aria-label="@count products">@count</span>
                        </button>
                        <button type="button" class="category-edit edit-category-btn" data-id="@category.category_ID" data-name="@category.category_name"
                                aria-label="Edit @category.category_name category" title="Edit category">
                            <i class="bi bi-pencil" aria-hidden="true"></i>
                        </button>
                    </div>
                }
                <div id="categorySearchEmpty" class="category-list-empty d-none" role="status">No categories match your search.</div>
                @if (categories.Count == 0)
                {
                    <div class="category-list-empty">No categories yet. Add a category to get started.</div>
                }
            </div>
        </section>

        <section class="app-card management-card category-products-card" aria-labelledby="selectedCategoryHeader">
            <div class="category-products-header">
                <div>
                    <h2 class="card-title-sm" id="selectedCategoryHeader">All Products</h2>
                    <p class="card-subtitle-sm" id="selectedCategorySub">Products across all categories</p>
                </div>
                <span class="category-products-total" id="selectedProductCount">@products.Count products</span>
            </div>
            <div class="category-products-toolbar">
                <label for="searchProductInput" class="visually-hidden">Search products in selected category</label>
                <div class="input-group search-control">
                    <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                    <input type="search" id="searchProductInput" class="form-control" placeholder="Search name, code, or brand..." autocomplete="off" />
                </div>
                <a asp-action="ProductManagement" class="category-inventory-link">Manage products <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
            </div>
            <div class="table-responsive">
                <table class="table app-table category-products-table" id="categoryProductsTable">
                    <caption class="visually-hidden">Products in the selected category</caption>
                    <thead>
                        <tr>
                            <th scope="col">Product Code</th>
                            <th scope="col">Product</th>
                            <th scope="col">Category</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Quantity</th>
                            <th scope="col" class="text-end">Selling Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in products)
                        {
                            var search = $"{product.formatted_code} {product.product_name} {product.product_brand} {product.product_description} {product.Category?.category_name}".ToLowerInvariant();
                            <tr class="product-row-item" data-category-id="@product.category_ID" data-search="@search">
                                <td class="fw-semibold text-nowrap">@product.formatted_code</td>
                                <td data-sort-value="@product.product_name">
                                    <a asp-action="Details" asp-route-id="@product.product_ID" class="product-name category-product-link">@product.product_name</a>
                                    <div class="product-meta">@product.product_brand</div>
                                </td>
                                <td>@product.Category?.category_name</td>
                                <td><span class="status-badge status-@StatusClass(product.product_status)">@product.product_status</span></td>
                                <td class="text-end fw-semibold">@product.product_quantity.ToString("N0")</td>
                                <td class="text-end fw-semibold text-nowrap">₱@product.Product_price.ToString("N2", CultureInfo.GetCultureInfo("en-PH"))</td>
                            </tr>
                        }
                        <tr id="noProductsRow" class="@(products.Count > 0 ? "d-none" : "")">
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                                    <strong id="emptyProductsTitle">No products found.</strong>
                                    <p id="emptyProductsHelp">Products assigned to this category will appear here.</p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="list-footer category-products-footer">
                <span class="small text-muted" id="categoryRangeText" role="status">Showing @products.Count products</span>
                <div class="d-flex align-items-center gap-2">
                    <label for="categoryPageSize" class="small text-muted text-nowrap">Items per page</label>
                    <select id="categoryPageSize" class="form-select form-select-sm page-size-select">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                    </select>
                </div>
                <nav aria-label="Category product pages"><ul id="categoryPagination" class="pagination pagination-sm mb-0"></ul></nav>
            </div>
        </section>
    </div>
</div>

<div class="modal fade category-modal" id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="createCategoryForm" asp-action="CreateCategory" method="post">
                <div class="modal-header">
                    <div><h2 class="modal-title fs-5" id="createCategoryTitle">Add Category</h2><p class="small text-muted mb-0">Create a group for related products.</p></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger category-form-error d-none" role="alert"></div>
                    <label for="createCategoryName" class="form-label">Category Name</label>
                    <input type="text" id="createCategoryName" name="category_name" class="form-control" placeholder="e.g. Graphics Cards" maxlength="100" required />
                    <div class="form-text">Use a clear, unique name for this product group.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm me-1 d-none" aria-hidden="true"></span>Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade category-modal" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="editCategoryForm" asp-action="EditCategory" method="post">
                <input type="hidden" id="editCategoryID" name="category_ID" />
                <div class="modal-header">
                    <div><h2 class="modal-title fs-5" id="editCategoryTitle">Edit Category</h2><p class="small text-muted mb-0">Update the name of this product group.</p></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger category-form-error d-none" role="alert"></div>
                    <label for="editCategoryName" class="form-label">Category Name</label>
                    <input type="text" id="editCategoryName" name="category_name" class="form-control" maxlength="100" required />
                    <div class="form-text">The updated name appears on all products in this category.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm me-1 d-none" aria-hidden="true"></span>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/category-management.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/category-management.js" asp-append-version="true"></script>
}

