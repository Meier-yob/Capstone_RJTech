@model Capstone_RJTech.Models.Product
@using System.Linq

@{
    ViewData["Title"] = Model.product_name;
    ViewData["Description"] = "Product catalog and inventory details.";

    string statusClass = Model.product_status
        .ToLowerInvariant()
        .Replace(" ", "-");

    DateTime lastDelivery =
        ViewBag.LastDelivery is DateTime date
            ? date
            : DateTime.MinValue;
}

<div class="app-page product-details-page"
     id="productDetailsPage"
     data-product-id="@Model.product_ID"
     data-delete-url="@Url.Action("DeleteProduct")"
     data-products-url="@Url.Action("ProductManagement")">

    <!-- =====================================================
         BREADCRUMB
         ===================================================== -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">

            <li class="breadcrumb-item">
                <a asp-controller="Home"
                   asp-action="Dashboard">
                    Dashboard
                </a>
            </li>

            <li class="breadcrumb-item">
                <a asp-action="ProductManagement">
                    Products
                </a>
            </li>

            <li class="breadcrumb-item active">
                @Model.product_name
            </li>

        </ol>
    </nav>


    <!-- =====================================================
         PAGE HEADING
         ===================================================== -->
    <div class="page-heading product-details-heading">

        <div>
            <h1>@Model.product_name</h1>

            <p>
                @(Model.Category?.category_name ?? "Uncategorized")
                ·
                @Model.product_brand
            </p>
        </div>


        <div class="product-details-heading-actions">

            <button id="editToggle"
                    class="btn btn-outline-secondary"
                    type="button">

                <i class="bi bi-pencil me-1"></i>
                Edit

            </button>


            <button id="deleteProduct"
                    class="btn btn-outline-danger"
                    type="button">

                <i class="bi bi-trash me-1"></i>
                Delete

            </button>

        </div>

    </div>


    <!-- =====================================================
         MAIN LAYOUT
         ===================================================== -->
    <div class="product-details-layout">


        <!-- =================================================
             LEFT COLUMN
             ================================================= -->
        <div class="product-details-main">


            <!-- =============================================
                 PRODUCT INFORMATION
                 ============================================= -->
            <section class="app-card product-details-section"
                     aria-labelledby="productInformationTitle">

                <div class="product-details-section-heading">

                    <div class="product-details-section-title">

                        <span class="product-details-section-icon">
                            <i class="bi bi-box-seam"></i>
                        </span>

                        <h2 id="productInformationTitle">
                            Product Details
                        </h2>

                    </div>

                   

                </div>


                <!-- =========================================
                     READ ONLY MODE
                     ========================================= -->
                <div id="readOnlyDetails"
                     class="product-information-list">


                    <!-- Product Name -->
                    <div class="product-information-row">

                        <div class="product-information-label">
                            Product Name
                        </div>

                        <div class="product-information-value">
                            @Model.product_name
                        </div>

                    </div>


                    <!-- Description -->
                    <div class="product-information-row product-description-row">

                        <div class="product-information-label">
                            Description
                        </div>

                        <div class="product-information-value product-description-value">

                            @(string.IsNullOrWhiteSpace(Model.product_description)
                                ? "No description provided."
                                : Model.product_description)

                        </div>

                    </div>


                    <!-- Product Information Grid -->
                    <div class="product-information-grid">

                        <div class="product-information-field">

                            <div class="product-information-label">
                                Brand
                            </div>

                            <div class="product-information-value">
                                @Model.product_brand
                            </div>

                        </div>


                        <div class="product-information-field">

                            <div class="product-information-label">
                                Category
                            </div>

                            <div class="product-information-value">

                                @(Model.Category?.category_name
                                    ?? "Uncategorized")

                            </div>

                        </div>


                        <div class="product-information-field">

                            <div class="product-information-label">
                                Status
                            </div>

                            <div class="mt-1">

                                <span class="status-badge status-@statusClass">
                                    @Model.product_status
                                </span>

                            </div>

                        </div>


                        <div class="product-information-field">

                            <div class="product-information-label">
                                Latest Batch
                            </div>

                            <div class="product-information-value">

                                @(ViewBag.LatestBatchId as string
                                    ?? "No batch information available.")

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =========================================
                     EDIT MODE
                     ========================================= -->
                <form id="editForm"
                      class="d-none product-edit-form"
                      asp-action="UpdateProductDetails"
                      method="post">

                    <input type="hidden"
                           name="product_ID"
                           value="@Model.product_ID" />

                    <input type="hidden"
                           name="product_status"
                           value="@Model.product_status" />


                    <div class="row g-3">


                        <!-- Product Name -->
                        <div class="col-12">

                            <label class="form-label"
                                   for="editProductName">
                                Product Name
                            </label>

                            <input id="editProductName"
                                   name="product_name"
                                   class="form-control"
                                   value="@Model.product_name"
                                   required />

                        </div>


                        <!-- Brand -->
                        <div class="col-md-6">

                            <label class="form-label"
                                   for="editProductBrand">
                                Brand
                            </label>

                            <input id="editProductBrand"
                                   name="product_brand"
                                   class="form-control"
                                   value="@Model.product_brand"
                                   required />

                        </div>


                        <!-- Selling Price -->
                        <div class="col-md-6">

                            <label class="form-label"
                                   for="editProductPrice">
                                Selling Price
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    ₱
                                </span>

                                <input id="editProductPrice"
                                       name="product_price"
                                       class="form-control"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       value="@Model.Product_price"
                                       required />

                            </div>

                        </div>


                        <!-- Description -->
                        <div class="col-12">

                            <label class="form-label"
                                   for="editProductDescription">
                                Description
                            </label>

                            <textarea id="editProductDescription"
                                      name="product_description"
                                      class="form-control"
                                      rows="4">@Model.product_description</textarea>

                        </div>


                        <!-- Reorder Level -->
                        <div class="col-md-6">

                            <label class="form-label"
                                   for="editReorderLevel">
                                Reorder Level
                            </label>

                            <input id="editReorderLevel"
                                   name="reorder_level"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   step="1"
                                   value="@Model.reorder_level"
                                   required />

                            <div class="form-hint mt-1">
                                Low-stock warning appears at or below this quantity.
                            </div>

                        </div>

                    </div>


                    <!-- Edit Actions -->
                    <div class="product-edit-actions">

                        <button id="cancelEdit"
                                type="button"
                                class="btn btn-outline-secondary">

                            Cancel

                        </button>


                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check2-circle me-1"></i>
                            Save Changes

                        </button>

                    </div>

                </form>

            </section>

        </div>



        <!-- =================================================
             RIGHT COLUMN
             ================================================= -->
        <aside class="product-details-sidebar">


            <!-- =============================================
                 PRODUCT IMAGE
                 ============================================= -->
            <section class="app-card product-details-section product-image-section"
                     aria-labelledby="productImageTitle">

                <div class="product-details-section-heading">

                    <div class="product-details-section-title">

                        <span class="product-details-section-icon">
                            <i class="bi bi-image"></i>
                        </span>

                        <h2 id="productImageTitle">
                            Product Image
                        </h2>

                    </div>


                    <button class="btn btn-sm btn-outline-secondary product-image-upload-button"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#uploadImageModal">

                        <i class="bi bi-upload me-1"></i>
                        Upload

                    </button>

                </div>


                @if (TempData["ImageError"] is string imageError)
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        @imageError
                    </div>
                }


                @if (TempData["ImageSuccess"] is string imageSuccess)
                {
                    <div class="alert alert-success py-2 small mb-3">
                        @imageSuccess
                    </div>
                }


                <div class="product-image-container">

                    @if (Model.product_Image is { Length: > 0 })
                    {
                        <img class="product-detail-image"
                             src="@Url.Action("Image", "Product", new { id = Model.product_ID })"
                             alt="@Model.product_name" />
                    }
                    else
                    {
                        <div class="image-placeholder">

                            <i class="bi bi-box-seam"></i>

                            <strong>
                                No product image
                            </strong>

                            <span>
                                Upload an image to identify this product.
                            </span>

                        </div>
                    }

                </div>

            </section>



            <!-- =============================================
                 PRICING & INVENTORY
                 ============================================= -->
            <section class="app-card product-details-section inventory-summary-section"
                     aria-labelledby="inventorySummaryTitle">

                <div class="product-details-section-heading">

                    <div class="product-details-section-title">

                        <span class="product-details-section-icon">
                            <i class="bi bi-boxes"></i>
                        </span>

                        <h2 id="inventorySummaryTitle">
                            Pricing &amp; Inventory
                        </h2>

                    </div>

                    
                </div>


                <div class="inventory-summary-list">


                    <!-- Price -->
                    <div class="inventory-summary-row">

                        <span>
                            Selling Price
                        </span>

                        <strong class="inventory-price">
                            ₱@Model.Product_price.ToString("N2")
                        </strong>

                    </div>


                    <!-- Quantity -->
                    <div class="inventory-summary-row">

                        <span>
                            Current Quantity
                        </span>

                        <strong>
                            @Model.product_quantity
                        </strong>

                    </div>


                    <!-- Reorder -->
                    <div class="inventory-summary-row">

                        <span>
                            Reorder Level
                        </span>

                        <strong>
                            @Model.reorder_level
                        </strong>

                    </div>


                    <!-- Last Delivery -->
                    <div class="inventory-summary-row">

                        <span>
                            Last Delivery
                        </span>

                        <strong>
                            @(lastDelivery == DateTime.MinValue
                                ? "—"
                                : lastDelivery.ToString("MMM d, yyyy"))
                        </strong>

                    </div>

                </div>

            </section>

        </aside>

    </div>

</div>



<!-- =============================================================
     UPLOAD IMAGE MODAL
     ============================================================= -->
<div class="modal fade"
     id="uploadImageModal"
     tabindex="-1"
     aria-labelledby="uploadImageTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form asp-action="UploadImage"
                  method="post"
                  enctype="multipart/form-data">


                <input type="hidden"
                       name="id"
                       value="@Model.product_ID" />


                <!-- Modal Header -->
                <div class="modal-header">

                    <div>

                        <h2 class="modal-title fs-5"
                            id="uploadImageTitle">

                            Upload Product Image

                        </h2>

                        <p class="small text-muted mb-0">
                            Select an image for this catalog item.
                        </p>

                    </div>


                    <button class="btn-close"
                            type="button"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <!-- Modal Body -->
                <div class="modal-body">

                    <label class="form-label"
                           for="productImage">

                        Product Image

                    </label>


                    <input id="productImage"
                           name="image"
                           class="form-control"
                           type="file"
                           accept="image/jpeg,image/png,image/webp"
                           required />


                    <div class="form-hint mt-2">
                        JPG, PNG, or WebP up to 5 MB.
                    </div>


                    <img id="imagePreview"
                         class="product-detail-image product-image-preview mt-3 d-none"
                         alt="Image preview" />

                </div>


                <!-- Modal Footer -->
                <div class="modal-footer">

                    <button class="btn btn-outline-secondary"
                            type="button"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button class="btn btn-primary"
                            type="submit">

                        <i class="bi bi-upload me-1"></i>
                        Upload Image

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/selected-product.css"
          asp-append-version="true" />

}


@section Scripts {

    <script src="~/js/product-details.js"
            asp-append-version="true">
    </script>

}